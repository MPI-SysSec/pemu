diff --git a/harness/fuzzware_harness/peripherals/renesas/synergy.py b/harness/fuzzware_harness/peripherals/renesas/synergy.py
new file mode 100644
index 0000000..cb73ae1
--- /dev/null
+++ b/harness/fuzzware_harness/peripherals/renesas/synergy.py
@@ -0,0 +1,485 @@
+from __future__ import annotations
+
+from enum import Enum
+import logging
+from typing import Tuple
+from unicorn import UcError, UC_ERR_READ_UNMAPPED
+
+from fuzzware_harness.peripherals.emu_interface import EmuInterface
+
+from ..peripheral import Peripheral
+from .. import MMIO_HANDLE_RES_PASSTHROUGH
+
+DEFAULT_BASE_ADDR = 0x40005000
+NUM_CHANNELS = 8
+
+OFFSET_PER_CHANNEL = 0x40
+OFFSET_DMSAR = 0x00
+OFFSET_DMDAR = 0x04
+OFFSET_DMCRA = 0x08
+OFFSET_DMCRB = 0x0C
+OFFSET_DMTMD = 0x10
+OFFSET_DMINT = 0x13
+OFFSET_DMAMD = 0x14
+OFFSET_DMOFR = 0x18
+OFFSET_DMCNT = 0x1C
+OFFSET_DMREQ = 0x1D
+OFFSET_DMSTS = 0x1E
+
+OFFSET_DMAST = 0x200
+
+IELSR_ADDR = 0x40006300
+
+
+""" 
+  DMAC implementation for Renesas Synergy Series microcontrollers.
+  Tested with the BSP for S7G2, but atleast the S5* microcontrollers seem to handle DMA
+  identically.
+
+  Data sheet: https://www.renesas.com/us/en/document/man/s7g2-microcontroller-group-users-manual?language=en
+
+  IRQ configuration depends on the event allocation in the IELSR registers. IRQ 16 corresponds to the first event slot.
+  Ensure that you only copnfigure IRQs that belong to DMA Channel Events here. The Event -> Channel mapping is then determined
+  automatically at runtime.
+
+  Config entry in config.yml
+  my_sample_peripheral:
+    class: fuzzware_harness.peripherals.renesas.synergy.DMAC
+    base_addr: 0x40005000
+    size: 0x204
+    owned_irqs:
+        - 16
+"""
+class DMAC(Peripheral):
+
+    class TransferRequestSource(Enum):
+        SOFTWARE = 0
+        INTERRUPT = 1
+
+    class RepeatArea(Enum):
+        DESTINATION = 0
+        SOURCE = 1
+        NO_REPEAT = 2
+
+    class TransferMode(Enum):
+        NORMAL = 0
+        REPEAT = 1
+        BLOCK = 2
+
+    class AddressUpdateMode(Enum):
+        FIXED = 0
+        OFFSET = 1
+        INCREMENT = 2
+        DECREMENT = 3
+
+    class DMAChannel():
+        def __init__(self, emu: EmuInterface, base_addr, channel_num, logger):
+            self.emu = emu
+            self.base_addr = base_addr
+            self.channel_num = channel_num
+            self._logger = logger
+
+        def get_addr(self, offset):
+            """
+                Returns the address of the MMIO register at the given offset, taking into account the base address of this channel
+                :param offset: an integer that will be added to the base address of the current DMA channel
+            """
+            return self.base_addr + self.channel_num * 0x40 + offset
+
+        def is_darie_enabled(self):
+            """
+                Returns true if the Destination Address Extended Repeat Area Overflow Interrupt is enabled
+            """
+            return (self.emu.read_memory(self.get_addr(OFFSET_DMINT), 1) & 0x01) != 0
+
+        def is_sarie_enabled(self):
+            """
+                Returns true if the Source Address Extended Repeat Area Overflow Interrupt is enabled
+            """
+            return (self.emu.read_memory(self.get_addr(OFFSET_DMINT), 1) & 0x02) != 0
+
+        def is_rptie_enabled(self):
+            """
+                Returns true if the Repeat Size End Interrupt is enabled
+            """
+            return (self.emu.read_memory(self.get_addr(OFFSET_DMINT), 1) & 0x04) != 0
+
+        def is_esie_enabled(self):
+            """
+                Returns true if the Transfer Escape End Interrupt is enabled
+            """
+            return (self.emu.read_memory(self.get_addr(OFFSET_DMINT), 1) & 0x08) != 0
+
+        def is_dtie_enabled(self):
+            """
+                Returns true if the Transfer End Interrupt is enabled
+            """
+            return (self.emu.read_memory(self.get_addr(OFFSET_DMINT), 1) & 0x10) != 0
+
+        def is_any_interrupt_enabled(self):
+            """
+                Returns true if any interrupt of this channel is enabled
+            """
+            return (self.emu.read_memory(self.get_addr(OFFSET_DMINT), 1) & 0x1F) != 0
+
+        def is_software_transfer_requested(self):
+            """
+                Returns true if the SWREQ bit, indicating that the firmware wants the DMA controller to perform a transfer, is set
+                This is only relevant if the channel is in Software-triggered transfer mode
+            """
+            return (self.emu.read_memory(self.get_addr(OFFSET_DMREQ), 1) & 0x01) != 0
+
+        def is_transfer_enabled(self):
+            """
+                Returns true if transfers are enabled for this channel. This does not mean that a transfer should be performed, if the
+                controller is in software triggered transfer mode. In that case, also check is_software_transfer_requested().
+            """
+            return self.emu.read_memory(self.get_addr(OFFSET_DMCNT), 1) == 1
+
+        def clear_transfer_enable(self):
+            """
+                Clears the transfer enable bit
+            """
+            self.emu.write_memory(self.get_addr(OFFSET_DMCNT), 1, 0x00)
+
+        def set_transfer_end_flag(self):
+            """
+                Sets the transfer end bit from the status register, indicating that a DMA transfer has been completed
+            """
+            dmsts = self.emu.read_memory(self.get_addr(OFFSET_DMSTS), 1)
+            self.emu.write_memory(self.get_addr(
+                OFFSET_DMSTS), 1, value=(dmsts | 0x10))
+
+        def clear_transfer_end_flag(self):
+            """
+                Clears the transfer end bit from the status register
+            """
+            dmsts = self.emu.read_memory(self.get_addr(OFFSET_DMSTS), 1)
+            self.emu.write_memory(self.get_addr(
+                OFFSET_DMSTS), 1, value=(dmsts & 0xef))
+
+        def set_transfer_escape_flag(self):
+            """
+                Sets the transfer end bit from the status register, indicating that a DMA transfer has been completed
+            """
+            dmsts = self.emu.read_memory(self.get_addr(OFFSET_DMSTS), 1)
+            self.emu.write_memory(self.get_addr(
+                OFFSET_DMSTS), 1, value=(dmsts | 0x01))
+
+        def clear_transfer_escape_flag(self):
+            """
+                Clears the transfer end bit from the status register
+            """
+            dmsts = self.emu.read_memory(self.get_addr(OFFSET_DMSTS), 1)
+            self.emu.write_memory(self.get_addr(
+                OFFSET_DMSTS), 1, value=(dmsts & 0xfe))
+
+        def get_transfer_count(self):
+            """
+                Returns the two lower bytes of the DMCRA register (i.e. DMCRAL)
+            """
+            return self.emu.read_memory(self.get_addr(OFFSET_DMCRA), 2)
+
+        def set_transfer_count(self, count):
+            """
+                Returns the two lower bytes of the DMCRA register (i.e. DMCRAL)
+            """
+            return self.emu.write_memory(self.get_addr(OFFSET_DMCRA), 2, count)
+
+        def get_repeat_size(self):
+            """
+                Returns the repeat size (DMCRAH) in Repeat and Block Transfer mode
+            """
+            return (self.emu.read_memory(self.get_addr(OFFSET_DMCRA), 4) >> 16) & 0x03FF
+
+        def get_source_address(self):
+            """
+                Returns the source address for DMA transfer data
+            """
+            return self.emu.read_memory(self.get_addr(OFFSET_DMSAR), 4)
+
+        def set_source_address(self, addr):
+            """
+                Sets the source address for DMA transfer data. This address must be processable by the data callback
+                of the perform_transfer method.
+            """
+            return self.emu.write_memory(self.get_addr(OFFSET_DMSAR), 4, addr)
+
+        def get_destination_address(self):
+            """
+                Returns the destination address for DMA transfer data
+            """
+            return self.emu.read_memory(self.get_addr(OFFSET_DMDAR), 4)
+
+        def set_destination_address(self, addr):
+            """
+                Sets the destination address for DMA transfer data. This address must be a valid RAM memory address. 
+            """
+            return self.emu.write_memory(self.get_addr(OFFSET_DMDAR), 4, addr)
+
+        def get_offset_addition(self):
+            """
+                Returns the offset value by which source/destination addresses will be incremented,
+                if the channel is configured to use offset address update mode
+            """
+            dmofr = self.emu.read_memory(self.get_addr(OFFSET_DMOFR), 4)
+            dmofr = dmofr & 0x01FFFFFF
+            return 0xFE000000 | dmofr if dmofr & 0x01000000 != 0 else dmofr
+
+        def get_block_transfer_count(self):
+            """
+                Returns the block or repeat transfer count
+            """
+            return self.emu.read_memory(self.get_addr(OFFSET_DMCRB), 2)
+
+        def set_block_transfer_count(self, val):
+            """
+                Sets the block or repeat transfer count
+            """
+            return self.emu.write_memory(self.get_addr(OFFSET_DMCRB), 2, val)
+
+        def get_address_mode(self) -> Tuple[DMAC.AddressUpdateMode, DMAC.AddressUpdateMode]:
+            """
+                Returns the update mode for the source and destination addresses
+                :returns: Tuple of address update mode for the source and destination addresses
+            """
+            dmamd = self.emu.read_memory(self.get_addr(OFFSET_DMAMD), 2)
+            dest_addr_mode = DMAC.AddressUpdateMode((dmamd & 0x00C0) >> 6)
+            src_addr_mode = DMAC.AddressUpdateMode((dmamd & 0xC000) >> 14)
+            return src_addr_mode, dest_addr_mode
+
+        def get_transfer_mode(self) -> Tuple[DMAC.TransferRequestSource, int, DMAC.RepeatArea, DMAC.TransferMode]:
+            """
+                Returns the transfer configuration for this channel
+                :returns: Tuple of transfer request source, transfer size (1, 2, 4 byte), repeat area and transfer mode
+            """
+            dmtmd = self.emu.read_memory(self.get_addr(OFFSET_DMTMD), 2)
+            request_source = DMAC.TransferRequestSource(dmtmd & 0x03)
+            size = 2 ** ((dmtmd & 0x0300) >> 8)
+            assert(size <= 4)
+            repeat_area = DMAC.RepeatArea(dmtmd & 0x3000 >> 12)
+            transfer_mode = DMAC.TransferMode(dmtmd & 0xC000 >> 14)
+            return request_source, size, repeat_area, transfer_mode
+
+        def is_transfer_available(self) -> bool:
+            """
+                Checks if the DMA controller is in a state where a transfer can happen.
+                This is the case if transfers are enabled, and, in the case of software triggered
+                transfers, the software has requested a transfer by setting the SWREQ bit.
+            """
+            if not self.is_transfer_enabled():
+                return False
+
+            request_source, size, repeat_area, transfer_mode = self.get_transfer_mode()
+            self._logger.debug(
+                f"[Transfer availability check] Request source is {request_source}")
+            if request_source == DMAC.TransferRequestSource.SOFTWARE:
+                return self.is_software_transfer_requested()
+            return False
+
+        def get_debug_info(self) -> str:
+            """
+                Returns a string representation of the channel state
+            """
+            request_source, size, repeat_area, transfer_mode = self.get_transfer_mode()
+            src_addr_mode, dest_addr_mode = self.get_address_mode()
+            transfer_count = self.get_transfer_count()
+            debug_str = (
+                f"=== Renesas Synergy DMAC state (channel {self.channel_num})\n"
+                f"Request source: {request_source}\n"
+                f"Size per transfer: {size} bytes\n"
+                f"Repeat area: {repeat_area}\n"
+                f"Transfer mode: {transfer_mode}\n"
+                f"Source addr mode: {src_addr_mode}\n"
+                f"Dest addr mode: {dest_addr_mode}\n"
+                f"Transfer count: {transfer_count}\n"
+                f"=== End of state information")
+            return debug_str
+
+        def _transfer(self, data_callback):
+            transfer_count = self.get_transfer_count()
+            request_source, size, repeat_area, transfer_mode = self.get_transfer_mode()
+            src_addr_mode, dest_addr_mode = self.get_address_mode()
+            if request_source == DMAC.TransferRequestSource.SOFTWARE:
+                # Reset SWREQ if requested
+                dmreq = self.emu.read_memory(
+                    self.get_addr(OFFSET_DMREQ), 1)
+                if dmreq & 0x10 == 0:
+                    self._logger.debug("[Transfer] Resetting SWREQ")
+                    self.emu.write_memory(self.get_addr(OFFSET_DMREQ), 1, value=dmreq & 0x10)
+
+            while transfer_count > 0:
+                source = self.get_source_address()
+                dest = self.get_destination_address()
+                data = data_callback(source, size)
+                self.emu.write_memory(dest, size, value=data, raw=True)
+
+                if src_addr_mode == DMAC.AddressUpdateMode.OFFSET:
+                    self.set_source_address(
+                        source + self.get_offset_addition())
+                if src_addr_mode == DMAC.AddressUpdateMode.INCREMENT:
+                    self.set_source_address(source + size)
+                if src_addr_mode == DMAC.AddressUpdateMode.DECREMENT:
+                    self.set_source_address(source - size)
+
+                if dest_addr_mode == DMAC.AddressUpdateMode.OFFSET:
+                    self.set_destination_address(
+                        source + self.get_offset_addition())
+                if dest_addr_mode == DMAC.AddressUpdateMode.INCREMENT:
+                    self.set_destination_address(source + size)
+                if dest_addr_mode == DMAC.AddressUpdateMode.DECREMENT:
+                    self.set_destination_address(source - size)
+
+                transfer_count = transfer_count - 1
+                self.set_transfer_count(transfer_count)
+                self._logger.debug(
+                    f"[Transfer] Transferred {data.hex()} ({size} bytes) to addr {dest:#08x}")
+
+        def perform_transfer(self, data_callback):
+            """
+                Performs a DMA transfer until transfer end conditions are met (in NORMAL mode).
+                This also handles the modification of registers, such that after this method has been called,
+                the DMA MMIO registers are in a state that is equivalent to what their state in a real system
+                after a transfer would be.
+
+                This function does not check transfer preconditions, they must be checked by the caller before calling
+                this function.
+
+                The transfer data is requested from a caller provided callback, which will (potentially) be called multiple times
+                throughout execution of this function, one time per transfer. If you want to support M2M transfers, then the callback
+                has to check if the address is within mapped memory, and return this instead of extracting or generating artifical data.
+
+                :param data_callback: A callable that takes an address and size (in bytes) and returns the memory contents at the given address for the given amount of bytes 
+
+            """
+            request_source, size, repeat_area, transfer_mode = self.get_transfer_mode()
+            src_addr_mode, dest_addr_mode = self.get_address_mode()
+            if transfer_mode == DMAC.TransferMode.NORMAL:
+                self._transfer(data_callback)
+                self.set_transfer_end_flag()
+                self.clear_transfer_enable()
+
+            elif transfer_mode == DMAC.TransferMode.REPEAT:
+
+                while (block_transfer_count := self.get_block_transfer_count()) > 0:
+
+                    if repeat_area == DMAC.RepeatArea.SOURCE:
+                        restore = self.get_source_address()
+                    elif repeat_area == DMAC.RepeatArea.DESTINATION:
+                        restore = self.get_destination_address()
+
+                    self._transfer(data_callback)
+
+                    if repeat_area == DMAC.RepeatArea.SOURCE:
+                        self.set_source_address(restore)
+                    elif repeat_area == DMAC.RepeatArea.DESTINATION:
+                        self.get_destination_address(restore)
+                    self.set_transfer_count(self.get_repeat_size())
+
+                    self.set_block_transfer_count(block_transfer_count - 1)
+
+                    if block_transfer_count == 1:
+                        if self.is_dtie_enabled():
+                            self.set_transfer_end_flag()
+                        self.clear_transfer_enable()
+                    if self.is_rptie_enabled():
+                        self.set_transfer_escape_flag()
+                        self.clear_transfer_enable()
+                        if self.is_esie_enabled():
+                            break
+
+
+
+            self._logger.info(f"[Transfer] DMA transfer completed")
+
+    def __init__(self, name, addr, size, owned_irqs, emu: EmuInterface, comm, config=None, logger=None, **kwargs):
+        if addr is None:
+            addr = DEFAULT_BASE_ADDR
+        self._logger = logging.getLogger(self.__class__.__name__) if logger is None else logger
+        self._channels = [DMAC.DMAChannel(
+            emu, addr, i, self._logger.getChild(f"channel_{i}")) for i in range(8)]
+        super().__init__(name, addr, size, owned_irqs, emu, comm, config, kwargs=kwargs)
+
+    def take_snapshot(self):
+        super().take_snapshot()
+
+    def restore_snapshot(self):
+        super().restore_snapshot()
+
+    def can_pend_interrupt(self, irq_num):
+        if not self.is_module_active():
+            self._logger.debug(
+                "[Interrupt pend check] DMA is disabled, preventing interrupt")
+            return False
+
+        channel = self.get_channel_by_irq(irq_num - 16)
+        if channel == None:
+            self._logger.warning(
+                f"[Interrupt pend check] DMA channel for interrupt {irq_num} (corresponds to IRQ {irq_num - 16}) not found")
+            return False
+
+        if not channel.is_transfer_available():
+            self._logger.debug(
+                f"[Interrupt pend check] No transfer available for DMA channel {channel.channel_num}, preventing interrupt")
+            return False
+
+        if not channel.is_dtie_enabled():
+            self._logger.debug(
+                f"[Interrupt pend check] Interrupt disabled for DMA channel {channel.channel_num}, preventing interrupt")
+            return False
+
+        return True
+
+    def is_module_active(self):
+        return self.emu.read_memory(self.address + OFFSET_DMAST, 1) == 1
+
+    def get_channel_by_irq(self, irq_num):
+        assert(irq_num >= 0)
+        assert(irq_num <= 95)
+        event_num = self.emu.read_memory(IELSR_ADDR + irq_num * 4, 4)
+        if event_num >= 0x20 and event_num <= 0x27:
+            return self._channels[event_num - 0x20]
+        return None
+
+    def get_input_for_addr(self, addr, size):
+        """
+            The callback to retrieve fuzzing input, which is provided to the perform_transfer method in the interrupt entry hook.
+            Supports M2M transfers for mapped memory.
+        """
+        try:
+            return bytes(self.emu.read_memory(addr, size, raw=True))
+        except UcError as e:
+            if e.errno == UC_ERR_READ_UNMAPPED:
+                return self.comm.get_bytes(size)
+            else:
+                raise e
+
+    def on_interrupt_entry(self, irq_num):
+        channel = self.get_channel_by_irq(irq_num - 16)
+        if channel == None:
+            self._logger.warning(
+                f"[Interrupt entry] DMA channel for interrupt {irq_num} (corresponds to external IRQ {irq_num - 16}) not found. Please ensure that a DMA channel is mapped to this interrupt in the interrupt event select register.")
+            return
+
+        channel.perform_transfer(self.get_input_for_addr)
+
+    def on_interrupt_exit(self, num_irq):
+        pass
+
+    # MMIO read
+    def hw_read(self, offset, size):
+        # We handle the registers in place in memory, so pass reads through
+        status = MMIO_HANDLE_RES_PASSTHROUGH
+        val = None
+
+        return status, val
+
+    # MMIO write
+    def hw_write(self, offset, size, value):
+        channel_num = offset // OFFSET_PER_CHANNEL
+        if channel_num >= 0 and channel_num < len(self._channels):
+            channel = self._channels[channel_num]
+            if offset % OFFSET_PER_CHANNEL == OFFSET_DMCNT and value == 0x01:
+                self._logger.debug(
+                    f"[hw write] Transfer enable has been set - clearing transfer end flag")
+                channel.clear_transfer_end_flag()
