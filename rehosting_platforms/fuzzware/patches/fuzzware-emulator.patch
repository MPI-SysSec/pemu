+    def get_active_receive_interrupts(self):
+        # return the active interrupts as set in the ETH_DMAIR
+        return (self.emu.read_memory(self.address + ETH_DMAIER, 4) & IER_RCV_MASK)
+
+    def get_status_register(self):
+        # return the value of the ETH_DMASR
+        return self.emu.read_memory(self.address + ETH_DMASR, 4)
+
+    def get_nis_val(self):
+        """ val for normal interrupt summary """
+        nis_val = (((self.get_status_register() & TS_MASK)) | 
+                ((self.get_status_register() & TBUS_MASK) >> 2) | 
+                ((self.get_status_register() & RS_MASK) >> 6) |
+                ((self.get_status_register() & ERS_MASK) >> 14)) << 16
+        return nis_val
+
+    def set_tbus_status(self):
+        # set the TBUS bit in the ETH_DMASR
+        # set NIS (normal interrupt summary)--> sticky bit??? 
+        enabled_interrupts = self.get_active_receive_interrupts()
+        self.tx_suspended = True # enter suspended state
+        self.emu.write_memory(self.address + ETH_DMASR, 4, (0x2800004))
+        self.emu.write_memory(self.address + ETH_DMASR, 4, 
+                (self.get_status_register() | self.get_nis_val()))
+
+    def set_transmit_status(self):
+        # set the RS bit in the ETH_DMASR
+        # clear ERS - early receive status
+        # set NIS (normal interrupt summary)--> sticky bit??? 
+        enabled_interrupts = self.get_active_receive_interrupts()
+        self.emu.write_memory(self.address + ETH_DMASR, 4, (1))
+        self.emu.write_memory(self.address + ETH_DMASR, 4, 
+                (self.get_status_register() | self.get_nis_val()))
+
+    def set_receive_status(self):
+        # set the RS bit in the ETH_DMASR
+        # clear ERS - early receive status
+        # set NIS (normal interrupt summary)--> sticky bit??? 
+        enabled_interrupts = self.get_active_receive_interrupts()
+        #RS
+        self.emu.write_memory(self.address + ETH_DMASR, 4, (RS_MASK & enabled_interrupts))
+        if RS_MASK & enabled_interrupts:
+            #ERS is cleared if RS is set
+            self.emu.write_memory(self.address + ETH_DMASR, 4, (self.get_status_register() & ~ERS_MASK))
+        #NIS - we assume transmit interrupt and transmit buffer unavailable are never set
+        self.emu.write_memory(self.address + ETH_DMASR, 4, 
+                (self.get_status_register() | self.get_nis_val()))
+        
+        return
+
+    def poll_tx_descriptor(self):
+        """ Poll all tx descriptors and reset the values """
+        # reset RDES0 OWN, SET IC,
+        if self.get_current_tx_descriptor() == 0:
+            # no descriptor selected --> choose first one/list base
+            self.set_current_tx_descriptor(self.emu.read_memory(self.address + ETH_DMATDLAR, 4))
+            if self.get_tx_descriptor_owner():
+
+                return 1
+        else:
+            # select the next free descriptor --> depends on the structure
+            if self.get_tx_descriptor_owner():
+
+                return 1
+
+            is_ring_structure = self.get_tx_descriptor_structure()
+            #logger.debug(f"{self.get_tdes0_val():#x}")
+            #logger.debug(f"{is_ring_structure}")
+            if is_ring_structure == 0:
+                #next descriptor is located right behind the current one
+                next_desc = self.get_current_tx_descriptor() + 4*4
+                while next_desc != self.get_current_tx_descriptor():
+                    if ((self.emu.read_memory(next_desc + RDES0, 4) & OWN_MASK) >> 31):
+                        self.set_current_tx_descriptor(self.poll_tx_ring())
+                        return 1
+                    next_desc = next_desc + 4 * 4 
+            else:
+                #chain structure rdes3 contains pointer to next descriptor
+                next_desc = self.emu.read_memory(self.get_current_tx_descriptor() + RDES3, 4)
+                while next_desc != self.get_current_tx_descriptor():
+                    if ((self.emu.read_memory(next_desc + RDES0, 4) & OWN_MASK) >> 31):
+                        self.set_current_tx_descriptor(self.poll_tx_chain())
+                        return 1
+                    next_desc = self.emu.read_memory(next_desc + RDES3, 4)
+            
+            if self.get_current_tx_descriptor() == -1:
+                #error handling! TODO
+                pass
+        #TODO enter suspend state & let that reflect in return val of fct?
+        return -1
+
+
+
+    #one buffer can contain not more than one frame
+    def poll_descriptor(self):
+        # 42.6.8 Rx DMA configuration
+        # ... 2. [...] While in the Run state, the DMA polls the receive descriptor list, 
+        #              attempting to acquire free descriptors [...]
+
+        # We always before(?!) interupts/after the last one try to find a free descriptor
+        # i.e. the subsequent on to the last one and store this descriptor to fill with data
+        if self.get_current_descriptor() == 0:
+            # no descriptor selected --> choose first one/list base
+            self.set_current_descriptor(self.emu.read_memory(self.address + ETH_DMARDLAR, 4))
+
+        else:
+            # select the next free descriptor --> depends on the structure
+            is_ring_structure = self.get_descriptor_structure()
+            if is_ring_structure == 0:
+                #next descriptor is located right behind the current one
+                self.set_current_descriptor(self.poll_ring())
+            else:
+                #chain structure rdes3 contains pointer to next descriptor
+                self.set_current_descriptor(self.poll_chain())
+            
+            if self.get_current_descriptor() == -1:
+                #error handling! TODO
+                return -1
+
+        # 42.6.8 Rx DMA configuration
+        # 2. [...]  If the fetched descriptor is not free (is owned by the CPU), the DMA
+        #           enters the Suspend state [...]
+        if not self.get_descriptor_owner():
+            #TODO enter suspend state & let that reflect in return val of fct?
+            return -1
+        return 1
+
+    def poll_tx_ring(self):
+        """
+        Poll a ring structure for the next descriptor
+        """
+        cur_base = self.get_current_tx_descriptor()
+        #ownership of descriptor should not matter right here?
+        #return first item if it is the end of the ring?
+        if self.is_end_of_tx_ring():
+            return self.emu.read_memory(self.address + ETH_DMATDLAR, 4)
+
+        #go to next descriptor item
+        cur_base += DESCRIPTOR_SIZE
+
+        return cur_base
+
+    def poll_tx_chain(self):
+        """
+        Poll a chain structure (linked list) for the next descriptor
+        """
+        #logger.debug("POLLING CHIAN")
+        cur_base = self.get_current_tx_descriptor()
+        cur_tdes3 = self.emu.read_memory(cur_base + RDES3, 4) #buffer 2 addr/next item
+
+        if cur_tdes3 == 0:
+            return -1
+
+        #go to next descriptor item
+        return cur_tdes3
+
+    def poll_ring(self):
+        """
+        Poll a ring structure for the next descriptor
+        """
+        cur_base = self.get_current_descriptor()
+        
+        cur_rdes1 = self.emu.read_memory(cur_base + RDES1, 4) #sizes
+        #ownership of descriptor should not matter right here?
+        #return first item if it is the end of the ring?
+        if self.is_end_of_ring():
+            return self.emu.read_memory(self.address + ETH_DMARDLAR, 4)
+
+        #go to next descriptor item
+        cur_base += DESCRIPTOR_SIZE
+
+        return cur_base
+
+    def poll_chain(self):
+        """
+        Poll a chain structure (linked list) for the next descriptor
+        """
+        cur_base = self.get_current_descriptor()
+        
+        cur_rdes3 = self.emu.read_memory(cur_base + RDES3, 4) #buffer 2 addr/next item
+
+        if cur_rdes3 == 0:
+            return -1
+
+        #go to next descriptor item
+        return cur_rdes3
+
+    def activate_on_mmio_write(self):
+        return
+        logger.debug("[activate_on_mmio_write] entering")
+        if self.wait_for_next < 2:
+            self.wait_for_next += 1
+            return
+        if self.transfer_completed_and_waiting:
+            return
+        
+        if self.next_interrupt == TX_INTERRUPT:
+            self.transmit_interrupt(-1)
+            self.wait_for_next = 1
+            self.next_interrupt = RX_INTERRUPT
+
+        else:
+            self.receive_interrupt(-1)
+            self.wait_for_next = 1
+            self.next_interrupt = TX_INTERRUPT
+        pass
+
+    # TODO this should be configurable
+    def interrupt_pending_trigger(self, irq_num):
+        if irq_num in self.owned_irqs:
+            return
+        self.activate_on_pulse()
+
+    def activate_on_timer(self):
+        self.activate_on_pulse()
+
+    def activate_on_pulse(self):
+        if self.wait_for_next < 3:
+            self.wait_for_next += 1
+            return
+        if self.transfer_completed_and_waiting:
+            return
+        #logger.debug(f"[activate_on_pulse] entering, {self.transfer_completed_and_waiting}")
+        
+        if self.next_interrupt == TX_INTERRUPT:
+            self.transmit_interrupt(-1)
+            self.wait_for_next = 1
+            self.next_interrupt = RX_INTERRUPT
+
+        else:
+            self.receive_interrupt(-1)
+            self.wait_for_next = 1
+            self.next_interrupt = TX_INTERRUPT
+
+
+
+    def can_pend_interrupt(self, irq_num):
+        """ if neither interrupts are allowed dont fire any """
+        #tx True if suspended = False & transmit status = True
+        logger.debug("[can_pend_interrupt] entering ...")
+        return (self.get_transmit_status() | self.get_receive_status()) != 0 or self.transfer_completed_and_waiting
+
+    def on_interrupt_entry(self, num_irq):
+        """ General interrupt entry """
+        #logger.debug("[on_interrupt_entry] entered")
+        # decide which interrupt to fire
+        if self.transfer_completed_and_waiting:
+            self.transfer_completed_and_waiting = False
+            return 
+        
+        if self.next_interrupt == RX_INTERRUPT:
+            self.receive_interrupt(num_irq)
+            self.next_interrupt = TX_INTERRUPT
+        else:
+            self.transmit_interrupt(num_irq)
+            self.next_interrupt = RX_INTERRUPT
+        
+        self.transfer_completed_and_waiting = False
+
+    def transmit_interrupt(self, num_irq):
+        """ Make firmware belief a packet was successfully sent """
+        # 1.
+        #logger.debug("transmit_interrupt")
+        if not self.get_transmit_status():
+            #logger.debug("forbidden")
+            #not allowed (yet) to transmit
+            return #TODO ?
+
+
+        # 2. We dont care about the data, we just set the bits in the according registers
+        # go through all transmit descriptors and set own bitsuh
+        if self.poll_tx_descriptor() == -1:
+            #logger.debug("broken")
+            self.set_tbus_status()
+            return
+        #logger.debug("transmit_interrupt")
+        packet = b'' 
+        try:
+            print(f"readding test from self.get_tx_buffer1_addr()")
+            self.emu.read_memory(self.get_tx_buffer1_addr(), 4)
+        except:
+            logger.debug(f"can't read yet")
+            return 0
+        for i in range(0, self.get_tdes1_val() & 0xfff, 4):
+            ##logger.debug(f"[transmit interrupt] transmit data: {(self.get_tx_buffer1_addr()) + i:08x} = {self.emu.read_memory((self.get_tx_buffer1_addr()) + i, 4):08x}")
+            packet += self.emu.read_memory((self.get_tx_buffer1_addr()) + i, 4).to_bytes(4, "big")
+
+        self._on_transmission(packet)
+
+        self.log_dma_access(self.get_tx_buffer1_addr(), len(packet), packet, 'tx', False)
+        logger.debug(f"[transmit_interrupt] dma_buf_addr: {self.get_tx_buffer1_addr():#x}, dma_buf_len: {len(packet):#x}. Writing contents: {hexlify(packet)}")
+        # PARSE OUTPUT !!
+        # set IC bit, and reset OWN bit
+        self.emu.write_memory(self.get_current_tx_descriptor() + RDES0, 4, 
+                (self.get_tdes0_val() & 0x7fffffff))
+        while not self.get_tdes0_val() & TX_LS_MASK:
+            if self.poll_tx_descriptor():
+                self.set_tbus_status()
+                return
+            self.emu.write_memory(self.get_current_tx_descriptor() + RDES0, 4, 
+                    (self.get_tdes0_val() & 0x7fffffff))
+        if self.get_tdes0_val() & IC_MASK:
+            #set ETH_DMASR
+            self.set_transmit_status()
+        
+        self.transfer_completed_and_waiting = True
+        return
+
+    def receive_interrupt(self, num_irq):
+        """ Receive interrupt"""
+        # Figure 572
+        # 1.
+        #logger.debug("receive_interrupt")
+        if not self.get_receive_status():
+            return #TODO ?
+
+        if self.packets_placed > self._packet_limit:
+            return
+        #self.debug_tx()
+        # 2. 
+        #logger.debug("[on_interrupt_entry] placing packet")
+
+        # 3. always poll for next descriptor --> no problem on activation TODO what about suspend?
+        if self.poll_descriptor() == -1:
+            logger.debug("we do not own descriptor yet")
+            return
+
+        # 4. TODO for now fill one buffer and make frame size equal to buffer size
+        frame_size = self.get_buffer1_size()
+        
+        # 5.
+        #logger.debug(f"[on_interrupt_entry] current_descriptor: {self.get_current_descriptor():#x}")
+        buffer1_addr = self.get_buffer1_addr()
+        #logger.debug(f"[on_interrupt_entry] frame size: {frame_size:#x}")
+        packed = True
+        frame_size = frame_size // 10
+        # PACKER GET PACKET !!!
+        cursor_start = self.comm.get_cursor()
+        # if nothing returned by packer get fuzzbytes
+        fuzz_bytes = self._get_fuzz_bytes(frame_size)
+        #fuzz_bytes = b'A' * frame_size
+        # always get the bytes from the fuzzer otherwise, the execution changes uncontrollably
+
+        logger.debug(f"[on_interrupt_etry] dma_buf_addr: {buffer1_addr:#x}, dma_buf_len: {frame_size:#x}. Writing contents: {hexlify(fuzz_bytes)}")
+        self.emu.write_memory(buffer1_addr, len(fuzz_bytes), fuzz_bytes, raw=True)
+        
+        # For dma tracing!r
+        self.log_dma_access(buffer1_addr, len(fuzz_bytes), fuzz_bytes, 'rx', False, cursor_start)
+        
+        #7.(?) close RDES0 as last descriptor/ write the received frames status to rdes0?? 
+        self.set_first_descriptor_flag()
+        self.set_last_descriptor_flag()
+        self.clear_own_bit()
+
+        # set ETH_DMASR to reflect the reaspn of the interrpt --> NIS receive interrupt? --> RS should be set???
+        self.set_receive_status()
+        self.transfer_completed_and_waiting = True
+        self.packets_placed += 1
+        return
+
+    # MMIO read
+    def hw_read(self, offset, size):
+        # We handle the rest of the registers in place in memory, so pass reads through
+        #MMIO_HANDLE_RES_FORWARD_TO_DEFAULT
+        status = MMIO_HANDLE_RES_PASSTHROUGH
+        val = None
+        if offset == ETH_DMABMR:
+            #firmware wants to check if DMA controller reset is done --> maybe add some time???
+            if self.emu.read_memory(self.address + ETH_DMABMR, 4) & 1:
+                self.emu.write_memory(self.address + ETH_DMABMR, 4, (self.emu.read_memory(self.address + ETH_DMABMR, 4) ^ 0x1))
+        return status, val
+
+    # MMIO write
+    def hw_write(self, offset, size, value):
+
+        if self.transfer_completed_and_waiting:
+            self.transfer_completed_and_waiting = False
+
+        self.activate_on_mmio_write()
+        if offset == ETH_DMABMR:
+            #firmware wants a software reset
+            pass
+        elif offset == ETH_DMATPDR:
+            # When these bits are written with any value, the DMA reads 
+            # the current descriptor pointed to by the ETH_DMACHTDR register. 
+            # If that descriptor is not available (owned by Host),
+            # transmission returns to the Suspend state and ETH_DMASR register 
+            # bit 2 is asserted. If the descriptor is available, transmission resumes.
+            #logger.debug("[hw_write] ETH_DMAPTDR is being written")
+            if self.get_tx_descriptor_owner():
+                self.tx_suspended = False
+            else:
+                self.set_tbus_status()
+            pass
+        elif offset == ETH_DMARPDR:
+            pass
+        elif offset == ETH_DMARDLAR:
+            # when receving the receive descriptor list pointer; the descriptor list should  be initialized
+            # At this point we could already trigger a transfer
+            pass
+        elif offset == ETH_DMATDLAR:
+            pass
+        elif offset == ETH_DMASR:
+            #interrupts are cleared by writing 1 to the corresponding bit
+            #logger.debug("writing ETH_DMASR")
+            self.emu.write_memory(self.address + ETH_DMASR, 4, (self.get_status_register() & ~value))
+        elif offset == ETH_DMAOMR:
+            logger.debug(f"writing ETH_DMAOMR: val = {value:#x}")
+            self.emu.write_memory(self.address + ETH_DMAOMR, 4, value)
+
+            pass
+        elif offset == ETH_DMAIER:
+            pass
+        elif offset == ETH_DMAMFBOCR:
+            pass
+        elif offset == ETH_DMARSWTR:
+            pass
+        elif offset == ETH_DMACHTDR:
+            pass
+        elif offset == ETH_DMACHRDR:
+            pass
+        elif offset == ETH_DMACHTBAR:
+            pass
+        elif offset == ETH_DMACHRBAR:
+            pass
+
