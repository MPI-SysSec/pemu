@@ -0,0 +1,164 @@
+from ..dma_peripheral import DMAPeripheral
+from ..emu_interface.emu_interface import EmuInterface
+from .. import MMIO_HANDLE_RES_PASSTHROUGH, MMIO_HANDLE_RES_FORWARD_TO_DEFAULT
+
+from binascii import hexlify
+
+DMA_ISR = 0x0
+DMA_IFC = 0x4
+DMA_CCR = [0x8, 0x1c, 0x30, 0x44, 0x58, 0x6c, 0x80]
+DMA_CNDTR = [0x0C, 0x20, 0x34, 0x48, 0x5c, 0x70, 0x84]
+DMA_CPAR = [0x10, 0x24, 0x38, 0x4c, 0x60, 0x74, 0x88]
+DMA_CMAR = [0x14, 0x28, 0x3c, 0x50, 0x64, 0x78, 0x8c]
+
+MSIZE_MASK = 0xc00
+MSIZE_MASK_SHIFT = 10
+DIR_MASK = 0x10
+ENABLE_MASK = 0x01
+M2M_MASK = 0x4000
+CIRC_MASK = 0x20
+
+BITMASK_INTERRUPTS_TRIGGERED = 0b110
+
+# To config
+DEFAULT_BASE_ADDR = 0x40020000
+"""
+  stm32f103rb:
+    class: fuzzware_harness.dma.stm32.stm32peripheral.STM32F103RBDMAController
+    base_addr: 0x40020000
+    size: 0x100
+"""
+
+NUM_CHANNELS = 7
+class DMAC(Peripheral):
+    enabled_channels = NUM_CHANNELS * [False]
+
+    # Is it's the device's turn to insert input atm?
+    # This is steered by filling contents + raising interrupts (to transfer ownership from device to fw)
+    # and by the fw writing to the interrupt clear register
+    device_owns_buffer = NUM_CHANNELS * [True]
+
+    def __init__(self, name, addr, size, owned_irqs, emu: EmuInterface, config=None, **kwargs):
+        if addr is None:
+            addr = DEFAULT_BASE_ADDR
+
+        super().__init__(name, addr, size, owned_irqs, emu, config, kwargs=kwargs)
+
+    def get_dma_buf(self, channel_ind):
+        """
+        For a given index, get start address and size of a DMA buffer.
+
+        We use this to prepare DMA buffer writes
+
+        @return: (start, size)
+        """
+        start = self.emu.read_memory(self.address + DMA_CMAR[channel_ind], 4)
+        memsize = (self.emu.read_memory(self.address + DMA_CCR[channel_ind], 4) & MSIZE_MASK) >> MSIZE_MASK_SHIFT
+        item_count = self.emu.read_memory(self.address + DMA_CNDTR[channel_ind], 2)
+
+        if memsize == 1:
+            multiplier = 2
+            start &= ~0b01
+        if memsize == 2:
+            multiplier = 4
+            start &= ~0b11
+
+        return start, item_count * multiplier
+
+    def take_snapshot(self):
+        parent_snapshot = super().take_snapshot()
+
+        # Messing up value after the snapshot is taken
+        # We could put custom snapshot taking logic here
+
+    def restore_snapshot(self, snapshot=None):
+        super().restore_snapshot(snapshot)
+
+        # We could put custom restoration logic here
+
+    # 
+    def can_pend_interrupt(self, irq_num):
+        # TODO: when interrupts are not used for transfer of ownership, take this as a question to trigger a write anyways
+        # in this case we could perform the writes in the loop here for those channels that are enabled, but have the interrupt disabled
+        return any(enabled_channels and device_owns_buffer for (enabled_channels, device_owns_buffer) in zip(self.enabled_channels, self.device_owns_buffer))
+
+    def on_interrupt_entry(self, num_irq):
+        print(f"[STM32 DMA on_interrupt_activation] irq num: {num_irq}")
+        # TODO: could have fuzzer decide about half / full events
+        # is_now_half_full = True
+        # is_now_full = True
+
+        curr_isr_val = self.emu.read_memory(self.address + DMA_ISR, 4)
+        # TODO: for a full implementation, just parse the DMA_ISR register bits and copy the payload accordingly?
+        for i, (is_enabled, is_owned) in enumerate(zip(self.enabled_channels, self.device_owns_buffer)):
+            if is_enabled and is_owned:
+                # query the DMA buf and fill it with contents
+                dma_buf_addr, dma_buf_len = self.get_dma_buf(i)
+                
+                fuzz_bytes = self.get_bytes(dma_buf_len)
+                print(f"[STM32 DMA on_interrupt_activation] dma_buf_addr: {dma_buf_addr:#x}, dma_buf_len: {dma_buf_len:#x}. Writing contents: {hexlify(fuzz_bytes)}", flush=True)
+                self.emu.write_memory(dma_buf_addr, len(fuzz_bytes), fuzz_bytes, raw=True)
+
+                # we filled the buffer now, wait for firmware to clear the interrupt flag to take back ownership
+                self.device_owns_buffer[i] = False
+
+                # increment DMA pointer register according to increment and circular flags
+                # TODO: PINC and MINC
+
+                # feed new DMA status into ISR
+                curr_isr_val |= (0b110 << (i*4))
+
+        self.emu.write_memory(self.address + DMA_ISR, 4, curr_isr_val)
+
+    def update_ownership_from_isr(self, new_isr_val):
+        print(f"[STM32 DMA on_interrupt_activation] update_ownership_from_isr called with new_isr_val: {new_isr_val:#x}", flush=True)
+        for i in range(NUM_CHANNELS):
+            # TODO: global
+            channel_bitfield = new_isr_val & BITMASK_INTERRUPTS_TRIGGERED
+
+            # if the interrupt bitfield is reset, we are indicated that we are allowed to raise interrupts again
+            now_allowed = channel_bitfield == 0
+            if not self.device_owns_buffer[i] and now_allowed:
+                print(f"[STM32 DMA on_interrupt_activation] update_ownership_from_isr: device now owns DMA buf {i:d} again!", flush=True)
+            self.device_owns_buffer[i] = now_allowed
+
+            # shift to next field
+            new_isr_val >>= 4
+
+    # MMIO read
+    def hw_read(self, offset, size):
+        # We handle the registers in place in memory, so pass reads through
+        status = MMIO_HANDLE_RES_PASSTHROUGH
+        val = None
+
+        return status, val
+
+    # MMIO write
+    def hw_write(self, offset, size, value):
+        print(f"hw_write called. offset: {offset:#x}, value: {value:#x}")
+        #  MMIO handler different offsets
+
+        if offset == DMA_IFC:
+            # 13.4.2 DMA interrupt flag clear register (DMA_IFCR)
+
+            curr_isr_val = self.emu.read_memory(self.address + DMA_ISR, 4)
+            # mask the bits in the status registers which are to be cleared
+            new_isr_val = curr_isr_val & ~value
+            print(f"[STM32 DMA hw_write] DMA_IFC interrupt clear register write. Value: {value:#x}. This changes IFCR from {curr_isr_val:#x} to {new_isr_val:#x}", flush=True)
+            self.emu.write_memory(self.address + DMA_ISR, 4, new_isr_val)
+
+            # Update DMA ownership state according to new ISR value
+            self.update_ownership_from_isr(new_isr_val)
+
+        elif offset in DMA_CCR:
+            # 13.4.3 DMA channel x configuration register (DMA_CCRx)
+            i = DMA_CCR.index(offset)
+
+            if value & ENABLE_MASK:
+                if not self.enabled_channels[i]:
+                    from_peripheral = self.emu.read_memory(self.address + DMA_CCR[i], 4) & DIR_MASK == 0
+                    not_m2m = self.emu.read_memory(self.address + DMA_CCR[i], 4) & M2M_MASK == 0
+                    if from_peripheral and not_m2m:
+                        self.enabled_channels[i] = True
+            else:
+                self.enabled_channels[i] = False
