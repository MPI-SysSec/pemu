index 0000000..982152f
--- /dev/null
+++ b/harness/fuzzware_harness/peripherals/nuvoton/nuc123.py
@@ -0,0 +1,277 @@
+from ..peripheral import Peripheral
+from .. import MMIO_HANDLE_RES_PASSTHROUGH, MMIO_HANDLE_RES_FORWARD_TO_DEFAULT
+
+# Reference Manual
+# https://www.nuvoton.com/resource-files/TRM_NUC123_Series_EN_Rev2.05.pdf
+# Sample Code
+# https://github.com/OpenNuvoton/NUC123BSP/blob/master/SampleCode/StdDriver/UART_PDMA/main.c
+
+# Implementation Status (Not implemented features)
+# CRC implementation
+# PDMA Global Control Register (PDMA_GCRCTL)
+# PDMA Service Selection Control Register (DMA_PDSSR0)
+# PDMA Shared Buffer FIFO (PDMA_SBUF)
+
+DEFAULT_BASE_ADDR = 0x50008000
+PDMA_GCR_BA = 0x5000_8F00
+DEFAULT_BASE_END = PDMA_GCR_BA + 0x14
+
+DEFAULT_IRQ_NUM = 42
+""" Config entry in config.yml
+  my_sample_peripheral:
+    class: fuzzware_harness.peripherals.nuvoton.nuc123.PDMA
+    owned_irqs:
+        - 42
+"""
+
+# Global MMIO registers
+OFFSET_PDMA_GCRCTL = PDMA_GCR_BA - DEFAULT_BASE_ADDR + 0x00
+OFFSET_PDMA_GCRISR = PDMA_GCR_BA - DEFAULT_BASE_ADDR + 0x0C
+PDMA_GCRCTL_CLK0_EN_SHIFT = 8
+
+# Per-Channel MMIO registers
+OFFSET_PDMA_CSR   = 0x00
+OFFSET_PDMA_SAR   = 0x04
+OFFSET_PDMA_DAR   = 0x08
+OFFSET_PDMA_BCR   = 0x0c
+OFFSET_PDMA_POINT = 0x10
+OFFSET_PDMA_CSAR  = 0x14
+OFFSET_PDMA_CDAR  = 0x18
+OFFSET_PDMA_CBCR  = 0x1c
+OFFSET_PDMA_IER   = 0x20
+OFFSET_PDMA_ISR   = 0x24
+OFFSET_PDMA_SBUF  = 0x80
+
+PASSTHROUGH_REG_OFFSETS = frozenset((
+    OFFSET_PDMA_CSR, OFFSET_PDMA_SAR, OFFSET_PDMA_DAR, OFFSET_PDMA_BCR,
+    OFFSET_PDMA_IER, OFFSET_PDMA_SBUF
+))
+
+# Control Register (PDMA_CSR) bit fields
+PDMACEN           = 1 << 0
+SW_RST            = 1 << 1
+MODE_SEL_SHIFT    = 2
+SAD_SEL_SHIFT     = 4
+DAD_SEL_SHIFT     = 6
+MODE_SEL          = 0b11 << MODE_SEL_SHIFT
+SAD_SEL           = 0b11 << SAD_SEL_SHIFT
+DAD_SEL           = 0b11 << DAD_SEL_SHIFT
+TRIG_EN           = 1 << 23
+
+MODE_MEM_TO_MEM = 0
+MODE_PERIPH_TO_MEM = 1
+MODE_MEM_TO_PERIPH = 2
+
+PDMA_IER_BLKD_IE = 1 << 1
+PDMA_ISR_BLKD_IF = 1 << 1
+
+NUM_CHANNELS = 6
+CHAN_MMIO_REGION_SIZE = 0x100
+FAKE_PDMA_POINT = 0xffff0000
+class PDMA(Peripheral):
+    # Internal state
+    # We don't keep track of most internal state here as we keep most things in the MMIO region as passthrough
+
+    # We need to keep track of the interrupt status as they can be reset via a write of '1'
+    interrupt_status = NUM_CHANNELS * [0]
+
+    def __init__(self, name, addr, size, owned_irqs, emu, comm, config=None, **kwargs):
+        if addr is None:
+            addr = DEFAULT_BASE_ADDR
+
+        if size is None:
+            size = DEFAULT_BASE_END - DEFAULT_BASE_ADDR
+        else:
+            assert(size == DEFAULT_BASE_END - DEFAULT_BASE_ADDR)
+
+        if not owned_irqs:
+            owned_irqs = (DEFAULT_IRQ_NUM, )
+
+        super().__init__(name, addr, size, owned_irqs, emu, comm, config, kwargs=kwargs)
+
+    def take_snapshot(self):
+        parent_snapshot = super().take_snapshot()
+
+    def restore_snapshot(self):
+        super().restore_snapshot()
+
+    def debug(self, debug_msg):
+        #print(debug_msg, flush = True)
+        return
+
+    def get_chan_mmio_reg(self, chan_no, reg_offset):
+        return self.read_mmio_reg(chan_no * CHAN_MMIO_REGION_SIZE + reg_offset)
+
+    def set_chan_mmio_reg(self, chan_no, reg_offset, value):
+        return self.write_mmio_reg(chan_no * CHAN_MMIO_REGION_SIZE + reg_offset, value)
+
+    def do_dma_transfer(self, chan_no):
+        csr = self.get_chan_mmio_reg(chan_no, OFFSET_PDMA_CSR)
+
+        mode = (csr & MODE_SEL) >> MODE_SEL_SHIFT
+
+        dst_addr = self.get_chan_mmio_reg(chan_no, OFFSET_PDMA_DAR)
+        src_addr = self.get_chan_mmio_reg(chan_no, OFFSET_PDMA_SAR)
+        transfer_size = self.get_chan_mmio_reg(chan_no, OFFSET_PDMA_BCR)
+
+        # Disable software trigger bit to indicate that transfer has completed
+        self.set_chan_mmio_reg(chan_no, OFFSET_PDMA_CSR, csr & ~TRIG_EN)
+
+        # Perform the memory transfer itself
+        if mode == MODE_PERIPH_TO_MEM:
+            fuzzing_input = self.comm.get_bytes(transfer_size)
+            self.debug(f"[nuc123 PDMA] DMA write to buf: {dst_addr:#x}, size: {transfer_size}, data: {fuzzing_input}")
+            self.emu.write_memory(dst_addr, transfer_size, value=fuzzing_input, raw=True)
+        elif mode == MODE_MEM_TO_MEM:
+            self.debug(f"[nuc123 PDMA] [-] Memory-to-memory copy: {src_addr:#x} -> {dst_addr:#x}, size: {transfer_size} (not implemented)")
+        elif mode == MODE_MEM_TO_PERIPH:
+            # Nothing to be done here, value only written out
+            pass
+
+        # Reset transfer byte count to zero
+        self.set_chan_mmio_reg(chan_no, OFFSET_PDMA_BCR, 0)
+
+        # Update transfer source address
+        if (csr & SAD_SEL) >> SAD_SEL_SHIFT == 0b10:
+            self.set_chan_mmio_reg(chan_no, OFFSET_PDMA_SAR, src_addr + transfer_size)
+
+        # Update transfer destination address
+        if (csr & DAD_SEL) >> DAD_SEL_SHIFT == 0b10:
+            self.set_chan_mmio_reg(chan_no, OFFSET_PDMA_DAR, dst_addr + transfer_size)
+
+    def can_pend_interrupt(self, irq_num):
+        """
+        We are taking the fuzzer asking us to do something as a hint
+        to process pending DMA transfers.
+
+        TODO: We are checking the interrupt_enable bit, but what if the
+        interrupt has never been enabled with the NVIC? Currently, we are
+        never performing a transfer for a polling-based firmware.
+        """
+        res = False
+
+        for chan_no in range(NUM_CHANNELS):
+            csr = self.get_chan_mmio_reg(chan_no, OFFSET_PDMA_CSR)
+            gcrctl = self.read_mmio_reg(OFFSET_PDMA_GCRCTL)
+
+            is_enabled_on_channel = csr & TRIG_EN and csr & PDMACEN
+            # CLKx_EN
+            is_enabled_globally = gcrctl & (1 << (PDMA_GCRCTL_CLK0_EN_SHIFT + chan_no))
+
+            if is_enabled_on_channel and is_enabled_globally:
+                # Perform the transfer itself
+                self.do_dma_transfer(chan_no)
+
+                # Check if we need to pend an interrupt as well
+                interrupt_enabled = self.get_chan_mmio_reg(chan_no, OFFSET_PDMA_IER) & PDMA_IER_BLKD_IE
+                if interrupt_enabled:
+                    self.debug(f"[nuc123 PDMA] setting interrupt status reg [{chan_no}] = {PDMA_ISR_BLKD_IF}")
+                    self.interrupt_status[chan_no] = PDMA_ISR_BLKD_IF
+                    res = True
+
+        return res
+
+    #def on_interrupt_entry(self, irq_num):
+    #    self.debug(f"[nuc123 DMAC] irq num: {irq_num}")
+
+    #def on_interrupt_exit(self, irq_num):
+    #    self.debug(f"[nuc123 DMAC] irq num: {irq_num}")
+
+    def reset(self, chan_no):
+        self.debug(f"[nuc123 PDMA] reset called")
+
+        # Reset interrupt-has-triggered flag
+        self.interrupt_status[chan_no] = 0
+
+        # TODO: reset all MMIO registers to reset values (see 6.6.6 Register Map)
+
+    def build_global_interrupt_status_reg():
+        res = 0
+
+        # Collect individual status bits
+        for i in range(NUM_CHANNELS):
+            if self.interrupt_status[i]:
+                res |= 1 << i
+
+        # Set global bit
+        if res:
+            res |= 1 << 31
+
+        return res
+
+    # MMIO read
+    def hw_read(self, offset, size):
+        # self.debug(f"[nuc123 DMAC] hw_read called. offset: {offset:#x}, size: {size:#x}")
+        periph_offset = offset
+
+        # Global MMIO registers
+        if offset == OFFSET_PDMA_GCRISR:
+            return self.build_global_interrupt_status_reg()
+        elif offset == OFFSET_PDMA_GCRCTL:
+            return MMIO_HANDLE_RES_PASSTHROUGH, None
+
+        # DMA Channel MMIO registers
+        chan_base = offset & ~0xff
+        reg_offset = offset & 0xff
+        chan_no = offset // CHAN_MMIO_REGION_SIZE
+
+        if chan_no >= NUM_CHANNELS:
+            # If we are out-of-bounds of the DMA channel regions, let fuzzer handle it
+            status = MMIO_HANDLE_RES_FORWARD_TO_DEFAULT
+            val = None
+        elif reg_offset in PASSTHROUGH_REG_OFFSETS:
+            # We handle the rest of the known registers in place in (MMIO) memory, so pass reads through
+            status = MMIO_HANDLE_RES_PASSTHROUGH
+            val = None
+
+        elif reg_offset == OFFSET_PDMA_POINT:
+            # TODO: Internal buffer? This seems to be an undocumented implementation detail
+            return FAKE_PDMA_POINT
+
+        # For MMIO registers querying the internal cursor, just return the configured value
+        elif reg_offset == OFFSET_PDMA_CSAR:
+            return self.read_mmio_reg(chan_base + OFFSET_PDMA_SAR)
+        elif reg_offset == OFFSET_PDMA_CDAR:
+            return self.read_mmio_reg(chan_base + OFFSET_PDMA_DAR)
+        elif reg_offset == OFFSET_PDMA_CBCR:
+            return self.read_mmio_reg(chan_base + OFFSET_PDMA_BCR)
+        elif reg_offset == OFFSET_PDMA_ISR:
+            return self.interrupt_status[chan_no]
+
+        # TODO: OFFSET_PDMA_SBUF ?
+
+        else:
+            # For other non DMA-related MMIO registers in the range, just forward to MMIO handling
+            status = MMIO_HANDLE_RES_FORWARD_TO_DEFAULT
+            val = None
+
+        # Fallback for not modifying what is already in RAM
+        return status, val
+
+    # MMIO write
+    def hw_write(self, offset, size, value):
+        self.debug(f"[nuc123 DMAC] hw_write called. offset: {offset:#x}, value: {value:#x}")
+
+        if size != 4:
+            # TODO: Are unaligned accesses supported?
+            return
+
+        periph_offset = offset
+        # chan_base = offset & ~0xff
+        reg_offset = offset & 0xff
+        chan_no = offset // CHAN_MMIO_REGION_SIZE
+
+        if reg_offset == OFFSET_PDMA_CSR:
+            # PDMA Control Register (PDMA_CSRx)
+            is_enabled = value & PDMACEN
+            if not is_enabled:
+                return
+
+            is_reset = value & SW_RST
+            if is_reset:
+                self.reset(chan_no)
+        elif reg_offset == OFFSET_PDMA_ISR:
+            # PDMA Interrupt Status Register
+            # Clear via '1' write
+            if value & PDMA_ISR_BLKD_IF:
+                self.interrupt_status[chan_no] = 0
diff --git a/harness/fuzzware_harness/peripherals/nxp/k64_dmac.py b/harness/fuzzware_harness/peripherals/nxp/k64_dmac.py
