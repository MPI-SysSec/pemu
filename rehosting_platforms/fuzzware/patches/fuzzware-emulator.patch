@@ -0,0 +1,65 @@
+from ... import native
+from ... import globs
+from fuzzware_harness.tracing.trace_ids import next_event_id
+
+# For now fixed:
+STRUCT_START = 0x20000030
+LENGTH_MMIO = 0x40088828
+STATUS_OFFSET = 0x8
+CONTROL_OFFSET = 0x8
+LEN = 0x80
+
+proxy_uc = None
+ani = None
+next_packet = None
+last_fuzz_index = -1
+##################
+##### RECEIVE ####
+##################
+def ti_hook_1(uc):
+    global next_packet
+    global last_fuzz_index
+    last_fuzz_index = native.fuzz_consumed()
+    control_word = int.from_bytes(uc.mem_read(STRUCT_START + CONTROL_OFFSET, 4), "little")
+    max_len = LEN
+    next_packet = native.get_fuzz(uc, max_len-1) 
+
+    #print(f"fuzzing goes brrrrr {next_packet}")
+
+
+    # set length accordingly in mmio register
+    uc.mem_write(LENGTH_MMIO, (len(next_packet)).to_bytes(4, "little"))
+
+def ti_hook_2(uc):
+    # fill buffer with dma
+    from unicorn.arm_const import UC_ARM_REG_R2
+    buffer_address = uc.reg_read(UC_ARM_REG_R2)
+    #fuzzing_input = fuzz_proxy(LEN)
+    log_dma_access(buffer_address, len(next_packet), next_packet, "rx", False, last_fuzz_index)
+
+    uc.mem_write(buffer_address, next_packet)
+
+
+def ti_hook_3(uc):
+    status = int.from_bytes(uc.mem_read(STRUCT_START + STATUS_OFFSET, 4), "little")
+    uc.mem_write(STRUCT_START + STATUS_OFFSET, (status & 0xfffffff8).to_bytes(4, "little"))
+
+
+###################
+##### TRANSMIT ####
+###################
+TX_STRUCT_START = 0x20000020
+
+def ti_hook_tx(uc):
+    control_word = int.from_bytes(uc.mem_read(TX_STRUCT_START + CONTROL_OFFSET, 4), "little")
+    packet_len = (control_word >> 4) & 0x1ff
+    tx_ptr = int.from_bytes(uc.mem_read(TX_STRUCT_START, 4), "little") - packet_len
+    packet = packet_len.to_bytes(1, "big") + uc.mem_read(tx_ptr, packet_len)
+    #print(f"packet is {packet}")
+    log_dma_access(tx_ptr, len(packet), packet, "tx", True, native.fuzz_consumed())
+    
+
+def log_dma_access( addr: int, size: int, data: bytes, mode: str, packed: bool,last_fuzz_access_index):
+    next_fuzz_access_index = native.fuzz_consumed()
+    from binascii import hexlify
+    globs.dma_state.append({'buffer': addr, 'packet_size': size, 'data': str(hexlify(data)), 'mode': mode, 'packed': packed, 'start_cursor': last_fuzz_access_index, 'next_cursor': next_fuzz_access_index, 'event_id': next_event_id(globs.uc)})
