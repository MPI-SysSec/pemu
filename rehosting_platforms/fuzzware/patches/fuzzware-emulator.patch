+OFFSET_OVERRIDE_1 = 0x728 #Trim value override register 1
+OFFSET_OVERRIDE_2 = 0x72c #Trim value override register 2
+OFFSET_OVERRIDE_3 = 0x730 #Trim value override register 3
+OFFSET_OVERRIDE_4 = 0x734 #Trim value override register 4
