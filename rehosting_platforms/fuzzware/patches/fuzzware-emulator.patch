+from binascii import hexlify
+import logging
+
+from ..peripheral import Peripheral
+from .. import MMIO_HANDLE_RES_PASSTHROUGH, MMIO_HANDLE_RES_FORWARD_TO_DEFAULT
+
+import fuzzware_harness.globs as globs
+
+CONFIG_NAME_NUM_DMA_CHANNELS = "num_channels"
+""" STM32 F767 Ethernet DMA Controller Implementation
+Data sheet: https://www.st.com/resource/en/reference_manual/dm00224583-stm32f76xxx-and-stm32f77xxx-advanced-arm-based-32-bit-mcus-stmicroelectronics.pdf
+
+This implementation keeps its state in MMIO memory and evaluates the current DMA configuration
+and interrupt state based on RAM contents within the MMIO range.
+
+This is why in this implementation, MMIO hw_read and hw_write handlers are mostly pass-throughs.
+
+An alternative way of implementing this functionality is pre-calculating DMA buffer configuration
+states and ownerships whenever MMIO writes are performed.
+"""
+
+""" Config entry in config.yml
+peripherals:
+  stm32f767rb:
+    class: fuzzware_harness.peripherals.stm32.f767_ethernet.DMAC
+    base_addr: 0x40029000
+    size: 0x400
+    irqs:
+        # DMA1_Channel1_IRQHandler
+        - 72
+"""
+
+#TODO: skip timestamping for now --> only normal rx dma descriptors for now
+RX_INTERRUPT = 0
+TX_INTERRUPT = 1
+
+ETH_DMABMR = 0x000 #dma bus mode register
+ETH_DMATPDR = 0x004 #ddma transmit poll demand register
+ETH_DMARPDR = 0x008 #dma receive poll demand register
+ETH_DMARDLAR = 0x00c #dma receive descriptor list addr register
+ETH_DMATDLAR = 0x010 #dma transmit descriptor list addr register
+ETH_DMASR = 0x014 #dma status register
+ETH_DMAOMR = 0x018 #dma operation mode register
+ETH_DMAIER = 0x01c #dma interrupt enable register
+ETH_DMAMFBOCR = 0x020 #dma missed frame and buffer overflow counter register
+ETH_DMARSWTR = 0x024 #dma receive status watchdog timer register
+ETH_DMACHTDR = 0x048 #dma current host transmit descriptor register
+ETH_DMACHRDR = 0x04c #dma current host receive descriptor register
+ETH_DMACHTBAR = 0x050 #dma current host transmit buffer address register
+ETH_DMACHRBAR = 0x054 #dma current host receive buffer address register
+
+RDES0 = 0x0 #offset to value given in eth_dmardlar, status
+RDES1 = 0x4 # sizes of of buffer1 and 2
+RDES2 = 0x8 # buffer1 addr
+RDES3 = 0xc # buffer2 addr or next descriptor addr
+
+SR_MASK = 0x2 #start/stop receive bit
+ST_MASK = 1 << 13 #start/stop transmit bit
+DFRF_MASK = 1 << 24 #disable flushin of received frames
+RCH_MASK = 1 << 14
+TCH_MASK = 1 << 20
+OWN_MASK = 1 << 31
+RBS1_MASK = 0x1fff
+RBS2_MASK = 0x1fff0000
+RER_MASK = 1 << 15
+TER_MASK = 1 << 20
+DIC_MASK = 1 << 31 
+FS_MASK = 1 << 9 #first descriptor of frame
+LS_MASK = 1 << 8 #last descriptor of frane 
+TX_LS_MASK = 1 << 29
+RS_MASK = 1 << 6 #receive stauts bit in ETH_DMASR
+ERS_MASK = 1 << 14 #early receive status in ETH_DMASR
+NISE_MASK = 1 << 16
+IC_MASK = 1 << 30
+TS_MASK = 1
+TBUS_MASK = 1 << 2
+IER_RCV_MASK = NISE_MASK | RS_MASK | ERS_MASK  # interrupt mask for receive interrupts in DMA_IR
+
+DESCRIPTOR_SIZE = 0x10 * 4 #4 dwords
+
+DEFAULT_BASE_ADDR = 0x40029000 #TODO ethernet base addr
+
+logger = logging.getLogger("DMA")
+
+def debug(msg):
+    print("[DMA PERIPH]: " + msg, flush=True)
+    return
+
+class ETH(Peripheral):
+    packets_placed: int
+    next_interrupt: int
+    tx_suspended: bool
+
+    def __init__(self, name, addr, size, owned_irqs, emu, comm, ani, config=None, **kwargs):
+        if addr is None:
+            addr = DEFAULT_BASE_ADDR
+        #logger.setLevel(logging.DEBUG)
+        logger.debug("INIT")
+        
+        
+
+        self.packets_placed = 0
+        #self.next_interrupt = None
+        self.next_interrupt = TX_INTERRUPT
+        self.tx_suspended = False
+        self.wait_for_first = 0
+        self.parse_config(config)
+        # initialize packer
+        super().__init__(name, addr, size, owned_irqs, emu, comm, ani, config, kwargs=kwargs)
+
+        
+    def parse_config(self, config):
+        self._packet_limit = config.get("packet_limit", 0xffffffff)
+        self._wait_for_val = config.get("wait_for", 3)
+
+    def get_receive_status(self):
+        #ETH_DMAOMR SR bit is set --> receive process is placed in running state
+        logger.debug(f"[get_receive_status] ETH_DMAOMR: {self.emu.read_memory(self.address + ETH_DMAOMR, 4):#x}")
+        return ((self.emu.read_memory(self.address + ETH_DMAOMR, 4) & SR_MASK) >> 1)
+
+    def get_transmit_status(self):
+        #ETH_DMAOMR ST bit is set --> transmit process is placed in running state
+        logger.debug(f"[get_tranmit_status] ETH_DMAOMR: {self.emu.read_memory(self.address + ETH_DMAOMR, 4):#x}")
+        return ((self.emu.read_memory(self.address + ETH_DMAOMR, 4) & ST_MASK) >> 13)
+
+    def get_flush_status(self):
+        #ETH_DMAOMR DRRF bit is set --> no flushing of frame
+        return ((self.emu.read_memory(self.address + ETH_DMAOMR, 4) & DFRF_MASK) >> 24)
+
+    def get_current_descriptor(self):
+        # read the ETH_DMACHRBAR, which contains the current descirptor
+        return self.emu.read_memory(self.address + ETH_DMACHRBAR, 4)
+
+    def get_current_tx_descriptor(self):
+        # read the ETH_DMACHRBAR, which contains the current descirptor
+        return self.emu.read_memory(self.address + ETH_DMACHTBAR, 4)
+
+    def set_current_descriptor(self, cur_descriptor):
+        # set the ETH_DMACHRBAR, which contains the current descirptor
+        return self.emu.write_memory(self.address + ETH_DMACHRBAR, 4, cur_descriptor)
+
+    def set_current_tx_descriptor(self, cur_tx_descriptor):
+        # set the ETH_DMACHRBAR, which contains the current descirptor
+        return self.emu.write_memory(self.address + ETH_DMACHTBAR, 4, cur_tx_descriptor)
+
+    def get_descriptor_structure(self):
+        #return 1 if it is a ring structure
+        return ((self.emu.read_memory(self.get_current_descriptor() + RDES1, 4) & RCH_MASK) >> 14)
+
+    def get_tx_descriptor_structure(self):
+        #return 1 if it is a ring structure
+        return ((self.get_tdes0_val() & TCH_MASK) >> 20)
+
+    def get_descriptor_owner(self):
+        #return 1 if owned by DMA, 0 if owned by the Host (aka CPU)
+        #read RDES0
+        return ((self.emu.read_memory(self.get_current_descriptor() + RDES0, 4) & OWN_MASK) >> 31)
+    
+    def get_tx_descriptor_owner(self):
+        #return 1 if owned by DMA, 0 if owned by the Host (aka CPU)
+        if not self.get_current_tx_descriptor() + RDES0:
+            return 0
+        return ((self.emu.read_memory(self.get_current_tx_descriptor() + RDES0, 4) & OWN_MASK) >> 31)
+
+    def get_buffer1_size(self):
+        #return size of the first buffer
+        return (self.emu.read_memory(self.get_current_descriptor() + RDES1, 4) & RBS1_MASK)
+
+    def get_buffer1_addr(self):
+        #return address of the first buffer
+        return self.emu.read_memory(self.get_current_descriptor() + RDES2, 4)
+
+    def get_buffer2_size(self):
+        #return size of the second buffer
+        return ((self.emu.read_memory(self.get_current_descriptor() + RDES1, 4) & RBS2_MASK) >> 16)
+
+    def get_tx_buffer1_addr(self):
+        #return address of the first buffer
+        return self.emu.read_memory(self.get_current_tx_descriptor() + RDES2, 4)
+
+    def get_tx_buffer2_addr(self):
+        #return address of the second buffer
+        return self.emu.read_memory(self.get_current_tx_descriptor() + RDES3, 4)
+
+    def get_buffer2_addr(self):
+        #return address of the second buffer
+        return self.emu.read_memory(self.get_current_descriptor() + RDES3, 4)
+
+    def is_end_of_tx_ring(self):
+        #return if this ITEM is the last one in the ring. DMA needs to return to base addr to form a ring
+        return ((self.emu.read_memory(self.get_current_tx_descriptor() + RDES1, 4) & TER_MASK) >> 21)
+
+    def is_end_of_ring(self):
+        #return if this ITEM is the last one in the ring. DMA needs to return to base addr to form a ring
+        return ((self.emu.read_memory(self.get_current_descriptor() + RDES1, 4) & RER_MASK) >> 15)
+
+    def get_rdes0_val(self): 
+        # return value of RDES0 of the current descriptor
+        return self.emu.read_memory(self.get_current_descriptor() + RDES0, 4)
+
+    def get_rdes1_val(self): 
+        # return value of RDES1 of the current descriptor
+        return self.emu.read_memory(self.get_current_descriptor() + RDES1, 4)
+
+    def get_tdes0_val(self): 
+        # return value of RDES0 of the current descriptor
+        return self.emu.read_memory(self.get_current_tx_descriptor() + RDES0, 4)
+
+    def get_tdes1_val(self): 
+        # return value of RDES0 of the current descriptor
+        return self.emu.read_memory(self.get_current_tx_descriptor() + RDES1, 4)
+
+    def set_first_descriptor(self):
+        #set the FS bit in the current descriptor
+        self.emu.write_memory(self.get_current_descriptor() + RDES0, 4, (self.get_rdes0_val() | FS_MASK))
+
+    def set_last_descriptor_flag(self):
+        #set the LF bit in the current descriptor
+        self.emu.write_memory(self.get_current_descriptor() + RDES0, 4, (self.get_rdes0_val() | LS_MASK))
+
+    def set_first_descriptor_flag(self):
+        #set the LF bit in the current descriptor
+        self.emu.write_memory(self.get_current_descriptor() + RDES0, 4, (self.get_rdes0_val() | FS_MASK))
+
+    def clear_last_descriptor_flag(self):
+        #set the LF bit in the current descriptor
+        self.emu.write_memory(self.get_current_descriptor() + RDES0, 4, (self.get_rdes0_val() & ~LS_MASK))
+
+    def clear_own_bit(self):
+        #set the OWN bit of the current descriptor to 0 --> owned by host
+        self.emu.write_memory(self.get_current_descriptor() + RDES0, 4, (self.get_rdes0_val() & ~OWN_MASK))
+        return
+    
+    def get_active_receive_interrupts(self):
+        # return the active interrupts as set in the ETH_DMAIR
+        return (self.emu.read_memory(self.address + ETH_DMAIER, 4) & IER_RCV_MASK)
+
+    def get_status_register(self):
+        # return the value of the ETH_DMASR
+        return self.emu.read_memory(self.address + ETH_DMASR, 4)
+
+    def get_nis_val(self):
+        """ val for normal interrupt summary """
+        nis_val = (((self.get_status_register() & TS_MASK)) | 
+                ((self.get_status_register() & TBUS_MASK) >> 2) | 
+                ((self.get_status_register() & RS_MASK) >> 6) |
+                ((self.get_status_register() & ERS_MASK) >> 14)) << 16
+        return nis_val
+
+    def set_tbus_status(self):
+        # set the TBUS bit in the ETH_DMASR
+        # set NIS (normal interrupt summary)--> sticky bit??? 
+        enabled_interrupts = self.get_active_receive_interrupts()
+        self.tx_suspended = True # enter suspended state
+        self.emu.write_memory(self.address + ETH_DMASR, 4, (0x2800004))
+        self.emu.write_memory(self.address + ETH_DMASR, 4, 
+                (self.get_status_register() | self.get_nis_val()))
+
+    def set_transmit_status(self):
+        # set the RS bit in the ETH_DMASR
+        # clear ERS - early receive status
+        # set NIS (normal interrupt summary)--> sticky bit??? 
+        enabled_interrupts = self.get_active_receive_interrupts()
+        self.emu.write_memory(self.address + ETH_DMASR, 4, (1))
+        self.emu.write_memory(self.address + ETH_DMASR, 4, 
+                (self.get_status_register() | self.get_nis_val()))
+
+    def set_receive_status(self):
+        # set the RS bit in the ETH_DMASR
+        # clear ERS - early receive status
+        # set NIS (normal interrupt summary)--> sticky bit??? 
+        enabled_interrupts = self.get_active_receive_interrupts()
+        #RS
+        self.emu.write_memory(self.address + ETH_DMASR, 4, (RS_MASK & enabled_interrupts))
+        if RS_MASK & enabled_interrupts:
+            #ERS is cleared if RS is set
+            self.emu.write_memory(self.address + ETH_DMASR, 4, (self.get_status_register() & ~ERS_MASK))
+        #NIS - we assume transmit interrupt and transmit buffer unavailable are never set
+        self.emu.write_memory(self.address + ETH_DMASR, 4, 
+                (self.get_status_register() | self.get_nis_val()))
+        
+        return
+
+    def set_frame_length(self, frame_length):
+        # Set FL field of control descirptor field
+        rdes0 = self.emu.read_memory(self.get_current_descriptor() + RDES0, 4)
+        rdes0 = (rdes0 & 0xc000ffff) | ((frame_length & 0x3fff) << 16)
+        self.emu.write_memory(self.get_current_descriptor() + RDES0, 4, rdes0)
+
+
+    def poll_tx_descriptor(self):
+        """ Poll all tx descriptors and reset the values """
+        # reset RDES0 OWN, SET IC,
+
+        if self.get_current_tx_descriptor() == 0:
+            logger.debug("no tx descriptor set")
+            # no descriptor selected --> choose first one/list base
+            self.set_current_tx_descriptor(self.emu.read_memory(self.address + ETH_DMATDLAR, 4))
+            logger.debug(f"taking {self.get_current_tx_descriptor():#x}")
+            if self.get_tx_descriptor_owner():
+                logger.debug(f"owning it")
+
+                return 1
+        else:
+            # select the next free descriptor --> depends on the structure
+            if self.get_tx_descriptor_owner():
+                return 1
+
+            is_ring_structure = self.get_tx_descriptor_structure()
+            logger.debug(f"{self.get_tdes0_val():#x}")
+            logger.debug(f"{is_ring_structure}")
+            if is_ring_structure == 0:
+                #next descriptor is located right behind the current one
+                next_desc = self.get_current_tx_descriptor() + 4*4
+                while next_desc != self.get_current_tx_descriptor():
+                    if ((self.emu.read_memory(next_desc + RDES0, 4) & OWN_MASK) >> 31):
+                        self.set_current_tx_descriptor(self.poll_tx_ring())
+                        return 1
+                    next_desc = next_desc + 4 * 4 
+            else:
+                #chain structure rdes3 contains pointer to next descriptor
+                next_desc = self.emu.read_memory(self.get_current_tx_descriptor() + RDES3, 4)
+                while next_desc != self.get_current_tx_descriptor():
+                    if ((self.emu.read_memory(next_desc + RDES0, 4) & OWN_MASK) >> 31):
+                        self.set_current_tx_descriptor(self.poll_tx_chain())
+                        return 1
+                    next_desc = self.emu.read_memory(next_desc + RDES3, 4)
+            
+            if self.get_current_tx_descriptor() == -1:
+                #error handling! TODO
+                logging.debug("weird case")
+                pass
+        #TODO enter suspend state & let that reflect in return val of fct?
+        return -1
+
+
+
+    #one buffer can contain not more than one frame
+    def poll_descriptor(self):
+        # 42.6.8 Rx DMA configuration
+        # ... 2. [...] While in the Run state, the DMA polls the receive descriptor list, 
+        #              attempting to acquire free descriptors [...]
+
+        # We always before(?!) interupts/after the last one try to find a free descriptor
+        # i.e. the subsequent on to the last one and store this descriptor to fill with data
+        if self.get_current_descriptor() == 0:
+            # no descriptor selected --> choose first one/list base
+            self.set_current_descriptor(self.emu.read_memory(self.address + ETH_DMARDLAR, 4))
+
+        else:
+            # select the next free descriptor --> depends on the structure
+            is_ring_structure = self.get_descriptor_structure()
+            if is_ring_structure == 0:
+                #next descriptor is located right behind the current one
+                self.set_current_descriptor(self.poll_ring())
+            else:
+                #chain structure rdes3 contains pointer to next descriptor
+                self.set_current_descriptor(self.poll_chain())
+            
+            if self.get_current_descriptor() == -1:
+                #error handling! TODO
+                pass
+
+        # 42.6.8 Rx DMA configuration
+        # 2. [...]  If the fetched descriptor is not free (is owned by the CPU), the DMA
+        #           enters the Suspend state [...]
+        if not self.get_descriptor_owner():
+            #TODO enter suspend state & let that reflect in return val of fct?
+            pass
+
+    def poll_tx_ring(self):
+        """
+        Poll a ring structure for the next descriptor
+        """
+        cur_base = self.get_current_tx_descriptor()
+        #ownership of descriptor should not matter right here?
+        #return first item if it is the end of the ring?
+        if self.is_end_of_tx_ring():
+            return self.emu.read_memory(self.address + ETH_DMATDLAR, 4)
+
+        #go to next descriptor item
+        cur_base += DESCRIPTOR_SIZE
+
+        return cur_base
+
+    def poll_tx_chain(self):
+        """
+        Poll a chain structure (linked list) for the next descriptor
+        """
+        logger.debug("POLLING CHIAN")
+        cur_base = self.get_current_tx_descriptor()
+        cur_tdes3 = self.emu.read_memory(cur_base + RDES3, 4) #buffer 2 addr/next item
+
+        if cur_tdes3 == 0:
+            return -1
+
+        #go to next descriptor item
+        return cur_tdes3
+
+    def poll_ring(self):
+        """
+        Poll a ring structure for the next descriptor
+        """
+        cur_base = self.get_current_descriptor()
+        
+        cur_rdes1 = self.emu.read_memory(cur_base + RDES1, 4) #sizes
+        #ownership of descriptor should not matter right here?
+        #return first item if it is the end of the ring?
+        if self.is_end_of_ring():
+            return self.emu.read_memory(self.address + ETH_DMARDLAR, 4)
+
+        #go to next descriptor item
+        cur_base += DESCRIPTOR_SIZE
+
+        return cur_base
+
+    def poll_chain(self):
+        """
+        Poll a chain structure (linked list) for the next descriptor
+        """
+        cur_base = self.get_current_descriptor()
+        
+        cur_rdes3 = self.emu.read_memory(cur_base + RDES3, 4) #buffer 2 addr/next item
+
+        if cur_rdes3 == 0:
+            return -1
+
+        #go to next descriptor item
+        return cur_rdes3
+
+    def can_pend_interrupt(self, irq_num):
+        """ if neither interrupts are allowed dont fire any """
+        #tx True if suspended = False & transmit status = True
+        if self.wait_for_first < self._wait_for_val:
+            logger.debug("skip interrupting")
+            self.wait_for_first += 1
+            return False
+        return (self.get_transmit_status() | self.get_receive_status()) != 0 
+
+    def on_interrupt_entry(self, num_irq):
+        """ General interrupt entry """
+        transmit_result = 0
+        if self.get_receive_status() and ((not self.next_interrupt) or self.next_interrupt == RX_INTERRUPT):
+            #if self.next_interrupt == RX_INTERRUPT:
+            self.receive_interrupt(num_irq)
+            self.next_interrupt = TX_INTERRUPT
+            self.wait_for_first = self._wait_for_val + 1
+        elif self.get_transmit_status() and ((not self.next_interrupt) or self.next_interrupt == TX_INTERRUPT):
+            transmit_result = self.transmit_interrupt(num_irq)
+            self.next_interrupt = RX_INTERRUPT
+            self.wait_for_first = self._wait_for_val + 1
+        else:
+            if self.next_interrupt == TX_INTERRUPT:
+                self.next_interrupt = RX_INTERRUPT
+            else:
+                self.next_interrupt = TX_INTERRUPT
+
+
+
+
+    def transmit_interrupt(self, num_irq):
+        """ Make firmware belief a packet was successfully sent """
+        # 1.
+        logger.debug("TRANSMIT INTERRUPT")
+        if not self.get_transmit_status():
+            #not allowed (yet) to transmit
+            logger.debug("Weird transmit return")
+            return 0 #TODO ?
+
+        self.debug_tx()
+        # 2. We dont care about the data, we just set the bits in the according registers
+        # go through all transmit descriptors and set own bitsuh
+        if self.poll_tx_descriptor() == -1:
+            self.set_tbus_status()
+            logger.debug("Returning from trnasmit interrupt")
+            return 0
+        packet = b'' 
+
+        try:
+            self.emu.read_memory(self.get_tx_buffer1_addr(), 4)
+        except:
+            logger.debug(f"can't read yet")
+            return 0
+
+        for i in range(0, self.get_tdes1_val() & 0xfff, 4):
+            logger.debug(f"{self.get_tx_buffer1_addr():#x}")
+            logger.debug(f"[transmit interrupt] transmit data: {(self.get_tx_buffer1_addr()) + i:08x} = {self.emu.read_memory((self.get_tx_buffer1_addr()) + i, 4):08x}")
+            packet += self.emu.read_memory((self.get_tx_buffer1_addr()) + i, 4).to_bytes(4, "big")
+
+        logger.debug(f"outgping packtet: {hexlify(packet)}")
+        self._on_transmission(packet)
+        #self.debug_tx()
+
+        self.log_dma_access(self.get_tx_buffer1_addr(), len(packet), packet, 'tx', False)
+        # PARSE OUTPUT !!
+        # set IC bit, and reset OWN bit
+        self.emu.write_memory(self.get_current_tx_descriptor() + RDES0, 4, 
+                (self.get_tdes0_val() & 0x7fffffff))
+        while not self.get_tdes0_val() & TX_LS_MASK:
+            if self.poll_tx_descriptor():
+                self.set_tbus_status()
+                return 1
+            self.emu.write_memory(self.get_current_tx_descriptor() + RDES0, 4, 
+                    (self.get_tdes0_val() & 0x7fffffff))
+        if self.get_tdes0_val() & IC_MASK:
+            #set ETH_DMASR
+            self.set_transmit_status()
+        return 1
+
+    def receive_interrupt(self, num_irq):
+        """ Receive interrupt"""
+        # Figure 572
+        # 1.
+        logger.debug("RECEIVE INTERRUPT")
+        if not self.get_receive_status():
+            return #TODO ?
+
+        if self.packets_placed > self._packet_limit:
+            return
+        # 2. 
+        logger.debug("[on_interrupt_entry] placing packet")
+
+        # 3. always poll for next descriptor --> no problem on activation TODO what about suspend?
+        self.poll_descriptor()
+
+        # 4. TODO for now fill one buffer and make frame size equal to buffer size
+        frame_size = self.get_buffer1_size()
+        
+        # 5.
+        logger.debug(f"[on_interrupt_entry] current_descriptor: {self.get_current_descriptor():#x}")
+        buffer1_addr = self.get_buffer1_addr()
+        if buffer1_addr == 0 :
+            return
+        logger.debug(f"[on_interrupt_entry] frame size: {frame_size:#x}")
+        packed = True
+        frame_size = frame_size
+        # PACKER GET PACKET !!!
+
+        cursor_start = self.comm.get_cursor()
+
+        # if nothing returned by packer get fuzzbytes
+        fuzz_bytes = self._get_fuzz_bytes(frame_size)
+
+        # always get the bytes from the fuzzer otherwise, the execution changes uncontrollably
+
+        logger.debug(f"[on_interrupt_etry] dma_buf_addr: {buffer1_addr:#x}, dma_buf_len: {frame_size:#x}. Writing contents: {hexlify(fuzz_bytes)}")
+        self.emu.write_memory(buffer1_addr, len(fuzz_bytes), fuzz_bytes, raw=True)
+        
+        # For dma tracing!r
+        self.log_dma_access(buffer1_addr, len(fuzz_bytes), fuzz_bytes, 'rx', False, cursor_start)
+        
+        #7.(?) close RDES0 as last descriptor/ write the received frames status to rdes0?? 
+        self.set_first_descriptor_flag()
+        self.set_last_descriptor_flag()
+        self.clear_own_bit()
+
+        # set ETH_DMASR to reflect the reaspn of the interrpt --> NIS receive interrupt? --> RS should be set???
+        self.set_receive_status()
+        self.set_frame_length(len(fuzz_bytes))
+
+        self.packets_placed += 1
+
+    # MMIO read
+    def hw_read(self, offset, size):
+        # We handle the rest of the registers in place in memory, so pass reads through
+        #MMIO_HANDLE_RES_FORWARD_TO_DEFAULT
+        status = MMIO_HANDLE_RES_PASSTHROUGH
+        val = None
+        if offset == ETH_DMABMR:
+            #firmware wants to check if DMA controller reset is done --> maybe add some time???
+            if self.emu.read_memory(self.address + ETH_DMABMR, 4) & 1:
+                self.emu.write_memory(self.address + ETH_DMABMR, 4, (self.emu.read_memory(self.address + ETH_DMABMR, 4) ^ 0x1))
+        if offset == ETH_DMAOMR:
+            # if firmware requestet a fifo reset -> signal that it is done.
+            if self.emu.read_memory(self.address + ETH_DMAOMR, 4) & 0x100000:
+                self.emu.write_memory(self.address + ETH_DMAOMR, 4, (self.emu.read_memory(self.address + ETH_DMAOMR, 4) ^ 0x100000))
+        return status, val
+
+    # MMIO write
+    def hw_write(self, offset, size, value):
+        if offset == ETH_DMABMR:
+            #firmware wants a software reset
+            pass
+        elif offset == ETH_DMATPDR:
+            # When these bits are written with any value, the DMA reads 
+            # the current descriptor pointed to by the ETH_DMACHTDR register. 
+            # If that descriptor is not available (owned by Host),
+            # transmission returns to the Suspend state and ETH_DMASR register 
+            # bit 2 is asserted. If the descriptor is available, transmission resumes.
+            logger.debug("[hw_write] ETH_DMAPTDR is being written")
+            if self.get_tx_descriptor_owner():
+                self.tx_suspended = False
+            else:
+                self.set_tbus_status()
+            pass
+        elif offset == ETH_DMARPDR:
+            pass
+        elif offset == ETH_DMARDLAR:
+            pass
+        elif offset == ETH_DMATDLAR:
+            pass
+        elif offset == ETH_DMASR:
+            #interrupts are cleared by writing 1 to the corresponding bit
+            logger.debug("writing ETH_DMASR")
+            self.emu.write_memory(self.address + ETH_DMASR, 4, (self.get_status_register() & ~value))
+        elif offset == ETH_DMAOMR:
+            logger.debug(f"writing ETH_DMAOMR: val = {value:#x}")
+            pass
+        elif offset == ETH_DMAIER:
+            pass
+        elif offset == ETH_DMAMFBOCR:
+            pass
+        elif offset == ETH_DMARSWTR:
+            pass
+        elif offset == ETH_DMACHTDR:
+            pass
+        elif offset == ETH_DMACHRDR:
+            pass
+        elif offset == ETH_DMACHTBAR:
+            pass
+        elif offset == ETH_DMACHRBAR:
+            pass
+
+    def debug_tx(self):
+        """ print all the tx descriptors """
+        tdesc_base = self.emu.read_memory(self.address + ETH_DMATDLAR, 4)
+        is_chained_structure = self.emu.read_memory(tdesc_base, 4) & (1 << 20)
+        logger.debug(f"[debug_tx] is chained structure: {True if is_chained_structure else False}")
+        logger.debug(f"[debug_tx] descriptor @ {tdesc_base:#x}")
+        logger.debug(f"-------------------------------")
+        logger.debug(f"[debug_tx] TDESC0 = {self.emu.read_memory(tdesc_base, 4):#x}")
+        logger.debug(f"-------------------------------")
+        logger.debug(f"[debug_tx] TDESC1 = {self.emu.read_memory(tdesc_base + RDES1, 4):#x}")
+        logger.debug(f"-------------------------------")
+        logger.debug(f"[debug_tx] TDESC2 = {self.emu.read_memory(tdesc_base + RDES2, 4):#x}")
+        logger.debug(f"-------------------------------")
+        logger.debug(f"[debug_tx] TDESC3 = {self.emu.read_memory(tdesc_base + RDES3, 4):#x}")
+        logger.debug(f"--------------------------------------")
+        logger.debug(f"")
+        
+        
+        if is_chained_structure == 0:
+            #next descriptor is located right behind the current one
+            while (self.emu.read_memory(tdesc_base, 4) & (1 << 21)) == 0: 
+                tdesc_base = tdesc_base * 16
+                logger.debug(f"[debug_tx] descriptor @ {tdesc_base:#x}")
+                logger.debug(f"-------------------------------")
+                logger.debug(f"[debug_tx] TDESC0 = {self.emu.read_memory(tdesc_base, 4):#x}")
+                logger.debug(f"-------------------------------")
+                logger.debug(f"[debug_tx] TDESC1 = {self.emu.read_memory(tdesc_base + RDES1, 4):#x}")
