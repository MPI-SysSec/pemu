+                #self._startrx() # TODO for testing increase speed
+                
+                #self._set_state(STATE_RXIDLE)
+
+        elif task == OFFSET_TASKS_STOP:
+            if self.state == STATE_TX:
+                self._set_state(STATE_TXIDLE)
+
+            elif self.state == STATE_RX:
+                self._set_state(STATE_RXIDLE)
+
+        elif task == OFFSET_TASKS_DISABLE:
+            if self.state in [STATE_TXRU, STATE_TXIDLE, STATE_TX]:
+                self._set_state(STATE_TXDISABLE)
+
+            elif self.state in [STATE_RXRU, STATE_RXIDLE, STATE_RX]:
+                self._set_state(STATE_RXDISABLE)
+
+            elif self.state == STATE_DISABLED:
+                logger.debug("entry 2")
+                self._generate_event(OFFSET_EVENTS_DISABLED) # this can happen during a reset
+
+        # update the state register to reflect the current state
+        
+
+        if self.state == STATE_RXDISABLE or self.state == STATE_TXDISABLE:
+            #immediately send out data!
+            self._set_state(STATE_DISABLED)
+            logger.debug("entry 3")
+            self._generate_event(OFFSET_EVENTS_DISABLED)
+        """
+        if self.state == STATE_TX:
+            #immediately send out data!
+            self._update_state_machine(NO_TASK, True)
+        self._update_state_reg()
+        """
+        # if shortcut was added execute it, but only one to avoid infinite loops
+        #self._update_state_reg()
+        """
+        if not in_shortcut and len(self.shortcut_queue) > short_queue_len:
+            # TODO which short the first one or the last added one
+            logger.debug(f"[update_state_machine] directly executing shortcut {self.shortcut_queue[-1]:#x}")
+            self._update_state_machine(self.shortcut_queue.pop(-1), in_shortcut = True)
+        """
+
+        logger.debug(f"[update_state_machine] leaving task {tasks[task]}")
+        return
+
+    def _set_state(self, state):
+        """ update the state, and block updates if a state transition, which leads to an interrupt is hit"""
+        #if not self.freeze_state:
+        self.state = state
+        return
+
+    def _update_state_reg(self):
+        """ update the state register to reflect the current state """
+        logger.debug(f"current_state = {states[self.state]}")
+        self.emu.write_memory(self.address + OFFSET_STATE, 4, self.state)
+
+    def _generate_event(self, event_reg_off):
+        """ create an event for an offset """
+        self._set_event_reg(event_reg_off)
+        logger.debug(f"[generate_event] event = {event_reg_off:#x}, cuurent intenset: {self.inten:#x}")
+        if self._is_event_interrupt_enabled(event_reg_off):
+            logger.debug(f"[generate_event] Setting interrupt waiting while generating event {event_reg_off:#x}")
+            self.interrupt_waiting = True
+            self.freeze_state = True
+
+         
+        if event_reg_off in SHORTS_EVENTS:
+            self._shortcut_event(event_reg_off)
+        # this should be handled right away
+        
+
+        # check if we need to handle a task generated by this event
+        if self.event_shortcutted:
+            self._handle_shortcut(event_reg_off)
+
+
+    def _set_event_reg(self, reg_off, value=1):
+        """ Turn on (or off) an event """
+        self.emu.write_memory(self.address + reg_off, 4, value)
+        return
+
+    def _get_event_reg(self, reg_off):
+        """ Get value of an event register """
+        return self.emu.read_memory(self.address + reg_off, 4)
+        return
+
+    def _is_event_interrupt_enabled(self, event_reg_off):
+        """ Check if interrupt for a certain event is enabled """
+        bitpos = INTEN_SHIFT[event_reg_off]
+        return (self.inten & bitpos) != 0
+    
+    def _get_logical_addresses(self):
+        """ return a list of all logical address indexes in use """
+        indices = []
+        existing_logical_addresses = self.emu.read_memory(self.address + OFFSET_RXADDRESSES, 4)
+        for i in range(8):
+            if (existing_logical_addresses > i) & 0x1:
+                indices.append(i)
+
+        return indices
+    
+    def _do_rssi(self):
+        if self.do_rssi:
+            self.emu.write_memory(self.address + OFFSET_RSSISAMPLE, 4, int.from_bytes(self.comm.get_bytes(1), "big") & 0x7f)
+            self._generate_event(OFFSET_EVENTS_RSSIEND)
+        self.do_rssi = False
+
+
+    def _get_frequency(self) -> int:
+        """
+        Get the freuency used for transmission
+        """
+        freq_val = self.emu.read_memory(self.address + OFFSET_FREQUENCY, 4)
+        base_frequency = 2360 if freq_val & 0x100 else 2400
+        return base_frequency + (freq_val & 0xff)
+
+    def _get_channel(self, frequency: int) -> int:
+        """
+        Map a frquency value to a channel (Core v5.3 p. 2671; Table 1.3)
+        """
+        return freq_to_chan[frequency] if frequency in freq_to_chan else -1
+
+
+    def hw_read(self, offset, size):
+        """
+        if self.emu.read_memory(0x4001F0fc, 4):
+            cur_chen = self.emu.read_memory(PPI_BASE_ADDR + OFFSET_PPI_CHEN, 4)
+            logger.debug(f"[check_ppi] chur_chen = {cur_chen:#x}")
+            short_len = len(self.shortcut_queue)
+            self.check_ppi(change = self.emu.read_memory(0x4001f0fc, 4))
+            if len(self.shortcut_queue) > short_len:
+                
+                self.update_state_machine(self.pop_shortcut())
+            self.emu.write_memory(0x4001F0fc, 4, 0)
+        """
+        #logger.debug(f"[hw_read] reading {size} bytes at {offset:#x}; value = {self.emu.read_memory(self.address + offset, size)}")
+        #TODO
+        if offset in MMIOREG_READ_CONSTS:
+            #logger.debug(f"[hw_read] returning {MMIOREG_READ_CONSTS[offset]}")
+            return MMIOREG_READ_CONSTS[offset]
+        elif offset in REG_OFFSETS: 
+            status = MMIO_HANDLE_RES_PASSTHROUGH
+            val = None
+        else:
+            # For other non DMA-related MMIO registers in the range, just forward to MMIO handling
+            status = MMIO_HANDLE_RES_FORWARD_TO_DEFAULT
+            # quickfix to make evetns passthrough TODO evaluate again
+            val = None
+
+        # Fallback for not modifying what is already in RAM
+        return status, val
+
+    # MMIO write
+    def hw_write(self, offset, size, value):
+        if size != 4:
+            # TODO: do we need to handle this?
+            return
+        self.freeze_state = False
+
+        logger.debug(f"[hw_write] writing {size} bytes at {offset:#x} (data = {value:#x})")
+        if offset in STATE_OFFSETS:
+            if value != 0:
+                logger.debug(f"[hw_write] received a new task")
+                self._update_state_machine(offset)
+                # TODO empty state?
+                if not self.freeze_state:
+                    self._update_state_machine(NO_TASK, True)   
+                self._update_state_reg()
+            # TODO what about rssi and bc tasks?
+
+        elif offset == OFFSET_MODE:
+            mode =  {0: 'nrf1mbit', 1: 'nrf2mbit', 3: 'ble1mbit', 4: 'ble2mbit',
+                    5: 'blelr125kbit', 6: 'blelr500kbit', 15: 'ieee802154'}
+            if value == 15:
+                self.mode = MODE_IEEE802154
+            logger.debug(f"[hw_write] set mode {mode[value]}")
+        elif offset == OFFSET_POWER:
+            # ret
+            if value == 0 and self.state != STATE_TURNED_OFF:
+                self._stop_state_machine()
+                self._reset_peripheral()
+
+            elif value == 1 and self.state == STATE_TURNED_OFF:
+                self._start_state_machine()
+
+        elif offset == OFFSET_INTENSET:
+            self.inten = self.inten | value
+            logger.debug(f"[hw_write] set interrupts = {self.inten:#x}")
+
+        elif offset == OFFSET_INTENCLR:
+            self.inten = self.inten & ~value
+
+        elif offset == OFFSET_PACKETPTR:
+            self.buffered_packetptr = value
+            pass
+        elif offset == OFFSET_TASKS_RSSISTART:
+            self.do_rssi = True
+            self._do_rssi()
+        elif offset == OFFSET_TASKS_RSSISTOP:
+            self.do_rssi = False
+        elif offset == OFFSET_TASKS_BCSTART:
+            self.do_bcc = True
+        elif offset == OFFSET_TASKS_BCSTOP:
+            self.do_bcc = False
+        elif offset == OFFSET_TASKS_CCASTART:
+            self._generate_event(OFFSET_EVENTS_CCAIDLE)
+            logger.debug(f"[hw_write] CCAIDLE")
+            
+            #if we are in ramp up mode speed everything up a little bit
+            #self._update_state_machine(NO_TASK, True)   
+            #self._update_state_reg() 
+
+
+
+
+
+    def take_snapshot(self):
+        return super().take_snapshot()
+
+    def restore_snapshot(self):
+        super().restore_snapshot()
+        self.shortcut_queue = list()
+
+
+
+    ##########################
+    ### Shortcutting stuff ###
+    ##########################
+    def _execute_shortcut(self, event_reg_off, task_reg_off, prio=0):
+        logger.debug(f"[execute_shortcut] entering for event {event_reg_off:#x} and {task_reg_off:#x}")
+        if self._is_event_interrupt_enabled(event_reg_off) and not prio:
+            #logger.debug(f"Adding E")
+            #self._add_shortcut(event_reg_off)
+            logger.debug("not executing shortcut bevause interrupt was enabled for event")
+            self.shortcut_queue.append(task_reg_off)
+        else:
+            logger.debug("directly executing shortcut")
+            self._update_state_machine(task_reg_off)
+            self._update_state_reg()
+        return
+
+
+    def _shortcut_event(self, event_reg_off):
+        """ execute shortcuts for given event if the exist """
+        logger.debug(f"[shortcut_event] entering event {event_reg_off:#x}, short: {self.emu.read_memory(self.address + OFFSET_SHORTS, 4):#x}")
+        if event_reg_off == OFFSET_EVENTS_DISABLED:
+            if self._is_shortcutted(SHORT_DISABLED_TXEN):
+                self._execute_shortcut(OFFSET_EVENTS_DISABLED, OFFSET_TASKS_TXEN)
+
+            if self._is_shortcutted(SHORT_DISABLED_RXEN):
+                self._execute_shortcut(OFFSET_EVENTS_DISABLED, OFFSET_TASKS_RXEN)
+            if self._is_shortcutted(SHORT_DISABLED_RSSISTOP):
+                self.do_rssi = False
+
+        elif event_reg_off == OFFSET_EVENTS_READY:
+            if self._is_shortcutted(SHORT_READY_START):
+                self._execute_shortcut(OFFSET_EVENTS_READY, OFFSET_TASKS_START)
+            if self._is_shortcutted(SHORT_READY_EDSTART):
+                pass
+
+        elif event_reg_off == OFFSET_EVENTS_END:
+            if self._is_shortcutted(SHORT_END_DISABLE):
+                self._execute_shortcut(OFFSET_EVENTS_END, OFFSET_TASKS_DISABLE, prio=1)
+
+            if self._is_shortcutted(SHORT_END_START):
+                self._execute_shortcut(OFFSET_EVENTS_END, OFFSET_TASKS_START)
+
+        elif event_reg_off == OFFSET_EVENTS_ADDRESS:
+            if self._is_shortcutted(SHORT_ADDRESS_RSSISTART):
+                self.do_rssi = True
+            if self._is_shortcutted(SHORT_ADDRESS_BCSTART):
+                self.do_bcc = True
+        
+        elif event_reg_off == OFFSET_EVENTS_RXREADY:
+            if self._is_shortcutted(SHORT_RXREADY_CCASTART):
+                pass
+            if self._is_shortcutted(SHORT_RXREADY_START):
+                self._execute_shortcut(OFFSET_EVENTS_RXREADY, OFFSET_TASKS_START)
+
+        elif event_reg_off == OFFSET_EVENTS_TXREADY:
+            if self._is_shortcutted(SHORT_TXREADY_START):
+                self._execute_shortcut(OFFSET_EVENTS_TXREADY, OFFSET_TASKS_START)
+
+        elif event_reg_off == OFFSET_EVENTS_CCAIDLE:
+            if self._is_shortcutted(SHORT_CCAIDLE_TXEN):
+                self._execute_shortcut(OFFSET_EVENTS_CCAIDLE, OFFSET_TASKS_TXEN)
+                
+            if self._is_shortcutted(SHORT_CCAIDLE_STOP):
+                self._execute_shortcut(OFFSET_EVENTS_CCAIDLE, OFFSET_TASKS_STOP)
+
+        elif event_reg_off == OFFSET_EVENTS_CCABUSY:
+            if self._is_shortcutted(SHORT_CCABUSY_DISABLE):
+                self._execute_shortcut(OFFSET_EVENTS_CCABUSY, OFFSET_TASKS_DISABLE)
+
+        elif event_reg_off == OFFSET_EVENTS_FRAMESTART:
+            if self._is_shortcutted(SHORT_FRAMESTART_BCSTART):
+                self.do_bcc = True
+
+        elif event_reg_off == OFFSET_EVENTS_EDEND:
+            if self._is_shortcutted(SHORT_EDEND_DISABLE):
+                self._execute_shortcut(OFFSET_EVENTS_EDEND, OFFSET_TASKS_DISABLE)
+
+        elif event_reg_off == OFFSET_EVENTS_PHYEND:
+            if self._is_shortcutted(SHORT_PHYEND_DISABLE):
+                self._execute_shortcut(OFFSET_EVENTS_PHYEND, OFFSET_TASKS_DISABLE)
+            
+            if self._is_shortcutted(SHORT_PHYEND_START):
+                self._execute_shortcut(OFFSET_EVENTS_PHYEND, OFFSET_TASKS_START)
+
+        # TODO do we update the state machine here or later (probably here?
+        return
+
+    def _is_shortcutted(self, shortcut):
+        """ check if a shortcut is enabled """
+        #logger.debug(f"[is_shortcutted] shortcut: {shortcut:#x}, short: {self.emu.read_memory(self.address + OFFSET_SHORTS, 4):#x}")
+        return (self.emu.read_memory(self.address + OFFSET_SHORTS, 4) & (1 << shortcut)) != 0
+
+    def _add_shortcut(self, shortcut):
+        """ add a task to the shortcut queue, to be executed on next tick """
+        logger.debug(f"[add_shortcut] adding {shortcut}")
+        self.shortcut_queue.append(shortcut)
+        return
+
+    def _pop_shortcut(self):
+        """ return the first shortcut in the shortcut queue or None """
+        if len(self.shortcut_queue) == 0:
+            return -2
+        
+        logger.debug(f"[pop_shortcut] pooping {self.shortcut_queue[0]}")
+        return self.shortcut_queue.pop(0)
+
+
+    ##########################################
+    ############ PPI FUNCTIONS ###############
+    ##########################################
+    def _handle_shortcut(self, event_reg):
+        """
+            if a radio event leads to a new ppi task (for now only group en/disable)
+            we need to handle it.
+            TODO write to PPI here should trigger hw_write
+        """
+        # check which task we need to do
+        cur_chen = self.emu.read_memory(PPI_BASE_ADDR + OFFSET_PPI_CHEN, 4)
+        logger.debug(f"[handle_shortcut] cur_chen before handling {cur_chen:#x}")
+        for index in range(0, 20): # we only need to check lower 20 channels
+            if (cur_chen >> index) & 1 == 0:
+                continue
+
+            cur_eep = self.emu.read_memory(PPI_BASE_ADDR + OFFSET_EEP_BASE + OFFSET * index, 4)
+            if not (cur_eep == self.address + event_reg):
+                #not the current event so we dont care
+                continue
+
+            # we only care if TEP or FORKTEP is a RADIO tasks 
+            cur_tep = self.emu.read_memory(PPI_BASE_ADDR + OFFSET_TEP_BASE + OFFSET * index, 4)
+            if cur_tep in range(PPI_BASE_ADDR, PPI_BASE_ADDR + 0x100):
+                self._handle_ppi_task(cur_tep)
+
+            cur_fep = self.emu.read_memory(PPI_BASE_ADDR+OFFSET_FORK_TEP_BASE + FORK_OFFSET * index, 4)
+            if cur_fep in range(PPI_BASE_ADDR, PPI_BASE_ADDR + 0x100): 
+                self._handle_ppi_task(cur_fep)
+
+        cur_chen = self.emu.read_memory(PPI_BASE_ADDR + OFFSET_PPI_CHEN, 4)
+        logger.debug(f"[handle_shortcut] cur_chen after handling {cur_chen:#x}")
+
+    def _handle_ppi_task(self, task):
+        """ Handle the actual ppi task """
+        if task & 0b0100 == 1:
+            # disable
+            chan = ((task & 0xff) - 4) // 4
+            cur_chen = self.emu.read_memory(PPI_BASE_ADDR + OFFSET_PPI_CHEN, 4)
+            group_chans = self.emu.read_memory(PPI_BASE_ADDR + OFFSET_CHG + chan * 4, 4)
+            self.emu.write_memory(PPI_BASE_ADDR + OFFSET_PPI_CHEN, 4, cur_chen & ~group_chans)
+
+        else:
+            # enable
+            chan = (task & 0xff) // 4
+            cur_chen = self.emu.read_memory(PPI_BASE_ADDR + OFFSET_PPI_CHEN, 4)
+            group_chans = self.emu.read_memory(PPI_BASE_ADDR + OFFSET_CHG + chan * 4, 4)
+            self.emu.write_memory(PPI_BASE_ADDR + OFFSET_PPI_CHEN, 4, cur_chen | group_chans)
+
+
+    def _check_ppi(self, change = None):
+        """ 
+            check if there are any activated ppi shortcuts with other peripherals
+            and  add the task to the shortcut list. also set the according event (?)
+        """
+        cur_chen = self.emu.read_memory(PPI_BASE_ADDR + OFFSET_PPI_CHEN, 4)
+        self.event_shortcutted = False
+
+        if cur_chen == 0:
+            return
+        
+        logger.debug(f"[check_ppi] chur_chen = {cur_chen:#x}")
+        cur_shortcuts = len(self.shortcut_queue)
+        if change:
+            #print("YEHAAAW, got a change")
+            cur_chen = change
+
+        # check if the shortcut affects us
+        if cur_chen & 0xfffff:
+            # configurable channels
+            for index in range(0, 20):
+                if (cur_chen >> index) & 1 == 0:
+                    continue
+                
+
+                cur_eep = self.emu.read_memory(PPI_BASE_ADDR + OFFSET_EEP_BASE + OFFSET * index, 4)
+
+                # we only care if TEP or FORKTEP is a RADIO tasks 
+                cur_tep = self.emu.read_memory(PPI_BASE_ADDR + OFFSET_TEP_BASE + OFFSET * index, 4)
+                cur_fep = self.emu.read_memory(PPI_BASE_ADDR + OFFSET_FORK_TEP_BASE + FORK_OFFSET * index, 4)
+  
+                if cur_tep >= self.address and cur_tep < self.address + self.size:
+                    self._add_shortcut(cur_tep - self.address)
+                    
+                if cur_fep >= self.address and cur_fep < self.address + self.size:
+                    self._add_shortcut(cur_fep - self.address)
+                    
+                if (cur_eep in range(self.address + 0x100, self.address + 0x200)
+                    and(cur_tep in range(PPI_BASE_ADDR, PPI_BASE_ADDR + 0x100) 
+                    or cur_fep in range(PPI_BASE_ADDR, PPI_BASE_ADDR + 0x100))):
+                    self.event_shortcutted = True
+
+
+        """ 
+        if len(self.shortcut_queue) > cur_shortcuts:
+            # already added tasks
+            # assume only one timer has gone off?
+            return
+        """
+
+        if cur_chen & 0xfff00000:
+            # predefined channels
+            if (cur_chen & 0x100000) >> 20:
+                self._add_shortcut(OFFSET_TASKS_TXEN)
+
+            if (cur_chen & 0x200000) >> 21:
+                self._add_shortcut(OFFSET_TASKS_RXEN)
+                self.emu.write_memory(0x40008140, 4, 1)
+
+            if (cur_chen & 0x400000) >> 22:
+                pass
+                # We skip disabling the radio and just assume this timer does not run out for now
+                #self._add_shortcut(OFFSET_TASKS_DISABLE)
+
+            if (cur_chen & 0x10000000) >> 28:
+                self._add_shortcut(OFFSET_TASKS_TXEN)
+
+            if (cur_chen & 0x20000000) >> 29:
+                self._add_shortcut(OFFSET_TASKS_TXEN)
+
+        return
+    
