+                self._set_state(STATE_TXRU)
+
+        elif task == OFFSET_TASKS_RXEN:
+            if self.state in [STATE_DISABLED, STATE_TXIDLE, STATE_RXIDLE, STATE_TX]:
+                self._set_state(STATE_RXRU)
+
+        elif task == OFFSET_TASKS_START:
