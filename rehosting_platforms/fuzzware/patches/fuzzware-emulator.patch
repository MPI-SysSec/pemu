+        return (self.emu.read_memory(self.get_current_descriptor() + RDES1, 4) & RBS1_MASK)
+
+    def get_buffer1_addr(self):
+        #return address of the first buffer
+        return self.emu.read_memory(self.get_current_descriptor() + RDES2, 4)
+
+    def get_buffer2_size(self):
+        #return size of the second buffer
+        return ((self.emu.read_memory(self.get_current_descriptor() + RDES1, 4) & RBS2_MASK) >> 16)
+
+    def get_tx_buffer1_addr(self):
+        #return address of the first buffer
+        return self.emu.read_memory(self.get_current_tx_descriptor() + RDES2, 4)
+
+    def get_tx_buffer2_addr(self):
+        #return address of the second buffer
+        return self.emu.read_memory(self.get_current_tx_descriptor() + RDES3, 4)
+
+    def get_buffer2_addr(self):
+        #return address of the second buffer
+        return self.emu.read_memory(self.get_current_descriptor() + RDES3, 4)
+
+    def is_end_of_tx_ring(self):
+        #return if this ITEM is the last one in the ring. DMA needs to return to base addr to form a ring
+        return ((self.emu.read_memory(self.get_current_tx_descriptor() + RDES1, 4) & TER_MASK) >> 21)
+
+    def is_end_of_ring(self):
+        #return if this ITEM is the last one in the ring. DMA needs to return to base addr to form a ring
+        return ((self.emu.read_memory(self.get_current_descriptor() + RDES1, 4) & RER_MASK) >> 15)
+
+    def get_rdes0_val(self): 
+        # return value of RDES0 of the current descriptor
+        return self.emu.read_memory(self.get_current_descriptor() + RDES0, 4)
+
+    def get_rdes1_val(self): 
+        # return value of RDES1 of the current descriptor
+        return self.emu.read_memory(self.get_current_descriptor() + RDES1, 4)
+
+    def get_tdes0_val(self): 
+        # return value of RDES0 of the current descriptor
+        return self.emu.read_memory(self.get_current_tx_descriptor() + RDES0, 4)
+
+    def get_tdes1_val(self): 
+        # return value of RDES0 of the current descriptor
+        return self.emu.read_memory(self.get_current_tx_descriptor() + RDES1, 4)
+
+    def set_first_descriptor(self):
+        #set the FS bit in the current descriptor
+        self.emu.write_memory(self.get_current_descriptor() + RDES0, 4, (self.get_rdes0_val() | FS_MASK))
+
+    def set_last_descriptor_flag(self):
+        #set the LF bit in the current descriptor
+        self.emu.write_memory(self.get_current_descriptor() + RDES0, 4, (self.get_rdes0_val() | LS_MASK))
+
+    def set_first_descriptor_flag(self):
+        #set the LF bit in the current descriptor
+        self.emu.write_memory(self.get_current_descriptor() + RDES0, 4, (self.get_rdes0_val() | FS_MASK))
+
+    def clear_last_descriptor_flag(self):
+        #set the LF bit in the current descriptor
+        self.emu.write_memory(self.get_current_descriptor() + RDES0, 4, (self.get_rdes0_val() & ~LS_MASK))
+
+    def clear_own_bit(self):
+        #set the OWN bit of the current descriptor to 0 --> owned by host
+        logger.debug(f"[clear_own_bit] writing to {self.get_current_descriptor():#x}; cur_val = {self.get_rdes0_val():#x}")
+        self.emu.write_memory(self.get_current_descriptor() + RDES0, 4, (self.get_rdes0_val() & ~OWN_MASK))
+        logger.debug(f"[clear_own_bit] written to {self.get_current_descriptor():#x}; cur_val = {self.get_rdes0_val():#x}")
+        return
