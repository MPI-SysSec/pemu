@@ -0,0 +1,363 @@
+from binascii import hexlify
+import logging
+
+from ..peripheral import Peripheral
+from .. import MMIO_HANDLE_RES_PASSTHROUGH, MMIO_HANDLE_RES_FORWARD_TO_DEFAULT
+from typing import List
+
+CONFIG_NAME_NUM_DMA_CHANNELS = "num_channels"
+
+""" STM32 F103RB DMA Controller Implementation
+Data sheet: https://www.st.com/resource/en/reference_manual/cd00171190-stm32f101xx-stm32f102xx-stm32f103xx-stm32f105xx-and-stm32f107xx-advanced-arm-based-32-bit-mcus-stmicroelectronics.pdf
+
+This implementation keeps its state in MMIO memory and evaluates the current DMA configuration
+and interrupt state based on RAM contents within the MMIO range.
+
+This is why in this implementation, MMIO hw_read and hw_write handlers are mostly pass-throughs.
+
+An alternative way of implementing this functionality is pre-calculating DMA buffer configuration
+states and ownerships whenever MMIO writes are performed.
+"""
+
+""" Config entry in config.yml
+peripheral:
+  stm32f103rb:
+    class: fuzzware_harness.peripherals.stm32.f103.DMAC
+    base_addr: 0x40020000
+    size: 0x100
+    irqs:
+        # DMA1_Channel1_IRQHandler
+        - 0x1b
+        - 0x1c
+        - 0x1d
+        - 0x1e
+        - 0x1f
+        - 0x20 
+        - 0x21
+"""
+
+
+
+
+logger = logging.getLogger("DMA")
+# Could make this a data class, but let's stay compatible
+class ChannelBaseConfig:
+    par: int
+    mar: int
+    ndtr: int
+
+    def __init__(self, par, mar, ndtr):
+        self.par = par
+        self.mar = mar
+        self.ndtr = ndtr
+
+# TODO: signal DMA send operation successes (to allow fw to not block on output)? PINC / PSIZE / MEM2MEM / DIR
+RECEIVE = 1
+TRANSMIT = 2
+
+irq_to_chan = {0x1b: 1, 0x1c: 2, 0x1d: 3, 0x1e: 4, 0x1f: 5, 0x20: 6, 0x21: 7,
+                0x48: 1, 0x49: 2, 0x4a: 3, 0x4b: 4, 0x4c: 5}
+
+DMA_ISR = 0x0
+DMA_IFC = 0x4
+DMA_CCR = [0x8, 0x1c, 0x30, 0x44, 0x58, 0x6c, 0x80]
+DMA_CNDTR = [0x0C, 0x20, 0x34, 0x48, 0x5c, 0x70, 0x84]
+DMA_CPAR = [0x10, 0x24, 0x38, 0x4c, 0x60, 0x74, 0x88]
+DMA_CMAR = [0x14, 0x28, 0x3c, 0x50, 0x64, 0x78, 0x8c]
+
+MINC_MASK = 1 << 7
+MSIZE_MASK = 0xc00
+MSIZE_MASK_SHIFT = 10
+DIR_MASK = 0x10
+ENABLE_MASK = 0x01
+M2M_MASK = 0x4000
+CIRC_MASK = 0x20
+HTIE = 1 << 2
+TCIE = 1 << 1
+GIF = 1 # Any interrupt has been raised
+INTERRUPTS_ENABLED_MASK = HTIE | TCIE
+
+BITMASK_INTERRUPTS_TRIGGERED = 0b110
+
+ITEM_SIZES = {
+    0: 1,
+    1: 2,
+    2: 4
+}
+
+DEFAULT_BASE_ADDR = 0x40020000
+
+DEFAULT_NUM_CHANNELS = 7
+class DMAC(Peripheral):
+    # A copy of original transfer values used for reloading configs
+    chan_base_configs: List[ChannelBaseConfig]
+    chan_ids_in_half_complete_state: set
+
+    _num_channels: int
+
+    def __init__(self, name, addr, size, owned_irqs, emu, comm, config=None, **kwargs):
+        if addr is None:
+            addr = DEFAULT_BASE_ADDR
+        self.chan_ids_in_half_complete_state = set()
+
+        super().__init__(name, addr, size, owned_irqs, emu, comm, config, kwargs=kwargs)
+
+        self._num_channels = config.get(CONFIG_NAME_NUM_DMA_CHANNELS, DEFAULT_NUM_CHANNELS)
+        self.chan_base_configs =  [ChannelBaseConfig(0, 0, 0) for _ in range(self._num_channels)]
+
+    def get_dma_buf(self, channel_ind):
+        """
+        For a given index, get start address and size of a DMA buffer.
+
+        We use this to prepare DMA buffer writes
+
+        @return: (start, size)
+        """
+        start = self.emu.read_memory(self.address + DMA_CMAR[channel_ind], 4)
+        memsize = (self.emu.read_memory(self.address + DMA_CCR[channel_ind], 4) & MSIZE_MASK) >> MSIZE_MASK_SHIFT
+        item_count = self.emu.read_memory(self.address + DMA_CNDTR[channel_ind], 2)
+
+        if memsize == 1:
+            multiplier = 2
+            start &= ~0b01
+        if memsize == 2:
+            multiplier = 4
+            start &= ~0b11
+
+        return start, item_count * multiplier
+
+    def can_pend_interrupt(self, irq_num):
+        # We only own one interrupt, so don't even check irq_num
+
+        # TODO: when interrupts are not used for transfer of ownership, take this as a question to trigger a write anyways in this
+        #       case we could perform the writes in the loop here for those channels that are enabled, but have the interrupt disabled
+
+        return (len(self.get_live_dma_channels()) != 0 and 
+                (irq_to_chan[irq_num] in [x[0] + 1 for x in self.get_live_dma_channels()]))
+
+    def reset_base_config(self, chan_ind):
+        self.write_mmio_reg(DMA_CNDTR[chan_ind], self.chan_base_configs[chan_ind].ndtr, 2)
+        self.write_mmio_reg(DMA_CPAR[chan_ind], self.chan_base_configs[chan_ind].par)
+        self.write_mmio_reg(DMA_CMAR[chan_ind], self.chan_base_configs[chan_ind].mar)
+
+    def on_interrupt_entry(self, irq_num):
+        logger.debug(f"[STM32 DMA on_interrupt_activation] irq num: {irq_num}")
+
+        curr_isr_val = self.read_mmio_reg(DMA_ISR)
+        for i, dma_buf_addr, dma_buf_len, mode in self.get_live_dma_channels():
+            if irq_to_chan[irq_num] != i + 1:
+                continue
+            if mode == TRANSMIT:
+                #nothing to be done; only change ISR to reflect a successful transmit
+                curr_isr_val |= (0b111 << i * 4)
+                continue
+
+            if i not in self.chan_ids_in_half_complete_state:
+                # Normal situation: Fill DMA buffer
+                fuzz_bytes = self.comm.get_bytes(dma_buf_len)
+                print(f"[STM32 DMA on_interrupt_activation] dma_buf_addr: {dma_buf_addr:#x}, dma_buf_len: {dma_buf_len:#x}. Writing contents: {hexlify(fuzz_bytes)}", flush=True)
+                self.emu.write_memory(dma_buf_addr, len(fuzz_bytes), fuzz_bytes, raw=True)
+
+                if not self.inc_packet_count():
+                    # Raise value error to indicate ending
+                    self.emu.stop()
+                    return
+
+                # increment DMA pointer register according to the MINC flag in the channel's config
+                ccr_val = self.get_ccr_val(i)
+                if self.get_minc(ccr_val):
+                    self.emu.write_memory(self.address + DMA_CMAR[i], 4, dma_buf_addr + dma_buf_len)
+
+                if self.get_circular_mode(ccr_val):
+                    # If we are in circular mode, reset count+address regs to original config
+                    self.reset_base_config(i)
+                else:
+                    # If we are not in circular mode (one-shot), set item count to 0 and disable channel
+                    self.emu.write_memory(self.address + DMA_CNDTR[i], 2, 0)
+                    self.emu.write_memory(self.address + DMA_CCR[i], 4, ccr_val & (~ENABLE_MASK))
+
+                # Feed the transfer complete DMA status into ISR (to not accidentally trigger another interrupt too early)
+                chan_isr_val = 0
+                if ccr_val & HTIE:
+                    chan_isr_val |= HTIE
+                    if ccr_val & TCIE:
+                        # Note that we need to raise the full
+                        self.chan_ids_in_half_complete_state.add(i)
+                elif ccr_val & TCIE:
+                    chan_isr_val |= TCIE
+
+                # Set global interrupt flag for channel
+                if chan_isr_val:
+                    chan_isr_val |= GIF
+            else:
+                # If we are in the second interrupt (DMA transfer completed),
+                # then just set the transfer complete enabled bit
+                self.chan_ids_in_half_complete_state.remove(i)
+                chan_isr_val = TCIE | GIF
+
+            # Add channel isr state to aggregating register
+            curr_isr_val |= (chan_isr_val << (i*4))
+
+        self.emu.write_memory(self.address + DMA_ISR, 4, curr_isr_val)
+
+    def on_interrupt_exit(self, num_irq):
+        # TODO: add HALF / FULL interrupt raising
+        pass
+
+    def get_ccr_val(self, channel_ind):
+        return self.emu.read_memory(self.address + DMA_CCR[channel_ind], 4)
+
+    def channel_interrupt_already_triggered(self, isr_val, channel_ind):
+        int_bits = isr_val >> (4*channel_ind)
+        return (int_bits & BITMASK_INTERRUPTS_TRIGGERED) != 0
+
+    def interrupts_enabled(self, ccr_val):
+        # This is an approximation: If we are allowed to raise any 
+        # interrupts indicating progress, we will.
+        return ccr_val & INTERRUPTS_ENABLED_MASK != 0
+
+    def channel_enabled(self, ccr_val):
+        return ccr_val & ENABLE_MASK == ENABLE_MASK
+
+    def get_number_of_data(self, channel_ind):
+        return self.emu.read_memory(self.address + DMA_CNDTR[channel_ind], 2)
+
+    def is_to_mem_direction(self, ccr_val):
+        return ccr_val & DIR_MASK == 0
+
+    def get_is_mem_to_mem(self, ccr_val):
+        return ccr_val & M2M_MASK != 0
+
+    def get_item_size(self, ccr_val):
+        msize_field = (ccr_val & MSIZE_MASK) >> MSIZE_MASK_SHIFT
+
+        # Value 3 is reserved
+        if msize_field not in ITEM_SIZES:
+            self.emu.crash()
+            return 1
+
+        return ITEM_SIZES[msize_field]
+
+    def get_dma_buf_addr(self, channel_ind):
+        return self.emu.read_memory(self.address + DMA_CMAR[channel_ind], 4)
+
+    def get_minc(self, ccr_val):
+        return ccr_val & MINC_MASK
+
+    def get_circular_mode(self, ccr_val):
+        return ccr_val & CIRC_MASK
+
+    def get_isr(self):
+        return self.emu.read_memory(self.address + DMA_ISR, 4)
+
+    def get_live_dma_channels(self):
+        # TODO perf: make this a generator? cache highest-used enabled channel index?
+
+        # Evaluate all the different flags and configs to figure out which buffers can be written to
+        # 1. Ownership
+        # 2. Enable Flag
+        # 3. Data Item Count
+        # 4. Data Direction
+
+        result = []
+        t_result = [] #if  we can't detect any receive channels, we alternatively return transmit channels
+
+        isr_val = self.emu.read_memory(self.address + DMA_ISR, 4)
+        for i in range(self._num_channels):
+            ccr_val = self.get_ccr_val(i)
+            is_owned = self.interrupts_enabled(ccr_val) and not self.channel_interrupt_already_triggered(isr_val, i)
+            is_enabled = self.channel_enabled(ccr_val)
+            item_count = self.get_number_of_data(i)
+            is_to_mem_data_direction = self.is_to_mem_direction(ccr_val)
+            is_mem_to_mem = self.get_is_mem_to_mem(ccr_val)
+
+            if i in self.chan_ids_in_half_complete_state or (is_owned and is_enabled and item_count != 0 and is_to_mem_data_direction and not is_mem_to_mem):
+                item_size = self.get_item_size(ccr_val)
+                base_addr = self.get_dma_buf_addr(i)
+                result.append((i, base_addr, item_count * item_size, RECEIVE))
+
+            if i in self.chan_ids_in_half_complete_state or (is_owned and is_enabled and item_count != 0 and not is_to_mem_data_direction):
+                # we detected a transmit channel; merely update the isr to reflect a succesful transfer on the fly
+                item_size = self.get_item_size(ccr_val)
+                base_addr = self.get_dma_buf_addr(i)
+                t_result.append((i, base_addr, item_count * item_size, TRANSMIT))
+
+        result.extend(t_result)
+        return result
+
+    # MMIO read
+    def hw_read(self, offset, size):
+        if offset == DMA_ISR:
+            # 13.4.1 DMA interrupt status register (DMA_ISR)
+
+            # For the interrupt status register, we compute the global interrupt flag
+            # from the other completion flags
+
+            curr_isr_val = self.get_isr()
+            tmp_isr = curr_isr_val
+
+            for i in range(self._num_channels):
+
+                if tmp_isr & BITMASK_INTERRUPTS_TRIGGERED != 0:
+                    curr_isr_val |= (1 << (4 * i))
+
+                tmp_isr >>= 4
+
+            # Have value propagated to memory by returning value
+            return curr_isr_val
+
+        # We handle the rest of the registers in place in memory, so pass reads through
+        status = MMIO_HANDLE_RES_PASSTHROUGH
+        val = None
+
+        return status, val
+
+    # MMIO write
+    def hw_write(self, offset, size, value):
+        if offset == DMA_ISR:
+            # 13.4.1 DMA interrupt status register (DMA_ISR)
+
+            # readonly register, do nothing
+            pass
+
+        elif offset == DMA_IFC:
+            # 13.4.2 DMA interrupt flag clear register (DMA_IFCR)
+            # we need to update the status register (DMA_ISR) based on 1-bits
+
+            curr_isr_val = self.get_isr()
+            # mask the bits in the status registers which are to be cleared
+            new_isr_val = curr_isr_val & ~value
+            # print(f"[STM32 DMA hw_write] DMA_IFC interrupt clear register write. Value: {value:#x}. This changes IFCR from {curr_isr_val:#x} to {new_isr_val:#x}", flush=True)
+            self.emu.write_memory(self.address + DMA_ISR, 4, new_isr_val)
+
+        elif offset in DMA_CCR:
+            # 13.4.3 DMA channel x configuration register (DMA_CCRx)
+            # We evaluate this when being asked about pending interrupts and
+            # placing input
+            chan_ind = DMA_CCR.index(offset)
+            if self.channel_enabled(value):
+                self.reset_base_config(chan_ind)
+
+        elif offset in DMA_CNDTR:
+            # 13.4.4 DMA channel x number of data register (DMA_CNDTRx)
+            # we evaluate this when wanting to write to the DMA buffer
+            chan_ind = DMA_CNDTR.index(offset)
+
+            # However, also store a copy in the base config for circular mode
+            self.chan_base_configs[chan_ind].ndtr = value
+
+        elif offset in DMA_CPAR:
+            # 13.4.5 DMA channel x peripheral address register (DMA_CPARx)
+            # we ignore this register as it is the DMA peripheral register
+            chan_ind = DMA_CPAR.index(offset)
+
+            # However, also store a copy in the base config for circular mode
+            self.chan_base_configs[chan_ind].par = value
+
+        elif offset in DMA_CMAR:
+            # 13.4.6 DMA channel x memory address register (DMA_CMARx)
+            # we evaluate this when wanting to write to the DMA buffer
+            chan_ind = DMA_CMAR.index(offset)
+
+            # However, also store a copy in the base config for circular mode
+            self.chan_base_configs[chan_ind].mar = value
