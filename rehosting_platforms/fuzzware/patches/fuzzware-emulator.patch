@@ -0,0 +1,95 @@
+from enum import Enum
+import logging
+from typing import Tuple
+from unicorn import UcError, UC_ERR_READ_UNMAPPED
+
+from fuzzware_harness.peripherals.emu_interface import EmuInterface
+
+from ..peripheral import Peripheral
+from .. import MMIO_HANDLE_RES_PASSTHROUGH
+
+DEFAULT_BASE_ADDR = 0x40021000
+NUM_CHANNELS = 16
+
+
+""" 
+  DMAMUX implementation for NXP K64 family microcontrollers.
+  
+  Data sheet: https://www.mouser.com/datasheet/2/813/K64P144M120SF5RM-1074828.pdf (pp. 467)
+
+
+  Config entry in config.yml
+  peripherals:
+    nxp_dmamux:
+      class: fuzzware_harness.peripherals.nxp.k64_dmamux.DMAMUX
+      base_addr: 0x40021000
+      size: 0x204
+      irqs: []
+"""
+
+
+class DMAMUX(Peripheral):
+
+    _instance = None
+
+    def __init__(self, name, addr, size, owned_irqs, emu: EmuInterface, comm, config=None, logger=None, **kwargs):
+        if DMAMUX._instance is not None:
+            raise RuntimeError(
+                "DMAMUX is a singleton, but tried to initialize multiple instances")
+
+        if addr is None:
+            addr = DEFAULT_BASE_ADDR
+        self._logger = logging.getLogger(
+            self.__class__.__name__) if logger is None else logger
+        super().__init__(name, addr, size, owned_irqs, emu, comm, config, kwargs=kwargs)
+        DMAMUX._instance = self
+
+    @staticmethod
+    def get_instance():
+        return DMAMUX._instance
+
+    def get_channel_number_by_irq(self, irq_num):
+        """
+            Returns the channel number of the DMA channel that is triggered by a given IRQ number
+        """
+        config = self.get_channel_configuration(irq_num - 16)
+        if config['source_slot'] > 1 and config['enabled']:
+            return irq_num - 16
+        return None
+
+    def get_channel_configuration(self, channel_num):
+        if channel_num >= NUM_CHANNELS or channel_num < 0:
+            raise ValueError(
+                f"Channel {channel_num} is out of bounds 0 - {NUM_CHANNELS}")
+        config_bits = self.emu.read_memory(DEFAULT_BASE_ADDR + channel_num, 1)
+        return {
+            'enabled': (config_bits & 0b10000000) == 0b10000000,
+            'periodic': (config_bits & 0b01000000) == 0b01000000,
+            'source_slot': config_bits & 0b00011111
+        }
+
+    def take_snapshot(self):
+        super().take_snapshot()
+
+    def restore_snapshot(self):
+        super().restore_snapshot()
+
+    def can_pend_interrupt(self, irq_num):
+        return True
+
+    def on_interrupt_entry(self, irq_num):
+        pass
+
+    def on_interrupt_exit(self, num_irq):
+        pass
+
+    # MMIO read
+    def hw_read(self, offset, size):
+        # We handle the registers in place in memory, so pass reads through
+        status = MMIO_HANDLE_RES_PASSTHROUGH
+        val = None
+        return status, val
+
+    # MMIO write
+    def hw_write(self, offset, size, value):
+        pass
diff --git a/harness/fuzzware_harness/peripherals/nxp/lpc18xx.py b/harness/fuzzware_harness/peripherals/nxp/lpc18xx.py
