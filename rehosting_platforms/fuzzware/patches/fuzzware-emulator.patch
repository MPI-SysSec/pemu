+# Channel - frquency mapping
+freq_to_chan = {2402: 37, 2404:0, 2406:1, 2408:2, 2410:3, 2412:4, 2414:5, 2416:6, 2418:7, 2420:8, 2422:9, 2424:10, 2426: 38, 2428:11, 2430:12, 2432:13, 2434:14, 2436:15, 2438:16, 2440:17, 2442:18, 2444:19, 2446:20, 2448:21, 2450:22, 2452:23, 2454:24, 2456:25, 2458:26, 2460:27, 2462:28, 2464:29, 2466:30, 2468:31, 2470:32, 2472:33, 2474:34, 2476:35, 2478:36, 2480:39}
