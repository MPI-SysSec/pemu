index 0000000..06ede29
--- /dev/null
+++ b/harness/fuzzware_harness/peripherals/mikrochip_atmel/sam3x_pdc.py
@@ -0,0 +1,215 @@
+from binascii import hexlify
+
+from ..peripheral import Peripheral
+from .. import MMIO_HANDLE_RES_PASSTHROUGH, MMIO_HANDLE_RES_FORWARD_TO_DEFAULT
+
+CONFIG_NAME_NUM_DMA_CHANNELS = "num_channels"
+
+""" Mikrochip/Atmel SAM3x DMA Controller Implementation
+Data sheet: https://ww1.microchip.com/downloads/en/DeviceDoc/Atmel-11057-32-bit-Cortex-M3-Microcontroller-SAM3X-SAM3A_Datasheet.pdf
+
+This implementation keeps its state in MMIO memory and evaluates the current DMA configuration
+and interrupt state based on RAM contents within the MMIO range.
+
+This is why in this implementation, MMIO hw_read and hw_write handlers are mostly pass-throughs.
+
+An alternative way of implementing this functionality is pre-calculating DMA buffer configuration
+states and ownerships whenever MMIO writes are performed.
+"""
+
+""" Config entry in config.yml
+peripherals:
+  sam3x_pdc:
+    class: fuzzware_harness.peripherals.mikrochip_atmel.sam3x_pdc.PDC
+    base_addr: -1
+    size: 0x128
+    irqs: no irqs?
+"""
+
+# TODO: signal DMA send operation successes (to allow fw to not block on output)? PINC / PSIZE / MEM2MEM / DIR
+PERIPH_RPR = 0x100 #receive pointer register
+PERIPH_RCR = 0x104 #receive counter register
+PERIPH_TPR = 0x108 #transmit pointer register
+PERIPH_TCR = 0x10c #transmit counter register
+PERIPH_RNPR = 0x110 #receive next pointer register
+PERIPH_RNCR = 0x114 #receive next counter register
+PERIPH_TNPR = 0x118 #transmit next pointer register
+PERIPH_TNCR = 0x11c #transmit next counter register
+PERIPH_PTCR = 0x120 #transfer control register
+PERIPH_PTSR = 0x124 #transfer status register
+
+#PERIPH_RPR = 0x00 #receive pointer register
+#PERIPH_RCR = 0x04 #receive counter register
+#PERIPH_TPR = 0x08 #transmit pointer register
+#PERIPH_TCR = 0x0c #transmit counter register
+#PERIPH_RNPR = 0x10 #receive next pointer register
+#PERIPH_RNCR = 0x14 #receive next counter register
+#PERIPH_TNPR = 0x18 #transmit next pointer register
+#PERIPH_TNCR = 0x1c #transmit next counter register
+#PERIPH_PTCR = 0x20 #transfer control register
+#PERIPH_PTSR = 0x24 #transfer status register
+
+RX_ENABLE_MASK = 0x11
+
+DEFAULT_BASE_ADDR = -1 #0x400C4000
+#[DAC, PWM, TWI1, TWI0, USART3, USART2, USART1, USART0, UART, ADC]
+#DEFAULT_BASE_ADDRS = [0x400C8000, 0x40094000, 0x40090000, 0x4008C000, 0x400A4000, 0x400A0000, 0x4009C000, 0x40098000, 0x400E0800, 0x400C0000]
+DEFAULT_NUM_CHANNELS = 1
+class PDC(Peripheral):
+    _num_channels: int
+
+    def __init__(self, name, addr, size, owned_irqs, emu, comm, config=None, **kwargs):
+
+        if addr is None:
+            addr = DEFAULT_BASE_ADDR
+
+        self._num_channels = config.get(CONFIG_NAME_NUM_DMA_CHANNELS, DEFAULT_NUM_CHANNELS)
+
+        super().__init__(name, addr, size, owned_irqs, emu, comm, config, kwargs=kwargs)
+
+    def get_dma_buf(self):
+        """
+        For a given index, get start address and size of a DMA buffer.
+
+        We use this to prepare DMA buffer writes
+
+        @return: (start, size)
+        """
+        start = self.emu.read_memory(self.address + PERIPH_RPR, 4)
+        receive_count = self.emu.read_memory(self.address + PERIPH_RCR, 2)
+
+        item_count = 2 # TODO check if this varies for different examples
+
+        return start, receive_count * item_count
+
+    def on_interrupt_entry(self, irq_num):
+        pass
+
+
+    def can_pend_interrupt(self, irq_num):
+        # we dont have any interrupts, so this is used as a tick, to execute our transfer, and this  function will always return false
+        # therefore the interrupt in the configuration does not matter
+        return True
+
+    #TODO
+    def on_receive_tick(self, irq_num):
+        #check if receiver transfer is enabled
+        if not self.is_receive_enabled():
+            return #try another time
+
+        if not self.inc_packet_count():
+            # Raise value error to indicate ending
+            print("[SAM3x DMA on_receive_tick] packet limit exceeded") 
+            self.emu.stop()
+            return
+
+        dma_buf_addr, dma_buf_len = self.get_dma_buf()
+        if dma_buf_addr == 0 or dma_buf_len == 0:
+            print("[SAM3x DMA on_receive_tick] no bufffer or lengthh") 
+            return
+        # TODO too many bytes cause out of fuzz
+        dma_buf_len = 0x8
+        fuzz_bytes = self.comm.get_bytes(dma_buf_len)
+
+
+        print(f"[SAM3x DMA on_receive_tick] dma_buf_addr: {dma_buf_addr:#x}, dma_buf_len: {dma_buf_len:#x}. Writing contents: {hexlify(fuzz_bytes)}", flush=True)
+        self.emu.write_memory(dma_buf_addr, len(fuzz_bytes), fuzz_bytes, raw=True)
+
+        #if next counter is greater zero move transfer decriptor and counter
+        if self.get_next_ptr_size() != 0:
+            # if next transfer exists set ENDRX flag
+            self.update_receive_ptr()
+            self.set_endrx()
+        else:
+            # else set RXBUFF and ENDRX flag
+            self.update_receive_ptr()
+            self.set_endrx()
+            self.set_rxbuff()
+
+        return True
+
+    def interrupt_pending_trigger(self, irq_num):
+        self.on_receive_tick(irq_num)
+
+    
+    def is_receive_enabled(self):
+        """ Check if reiceive channel si enabled """
+        ptcr_val = self.emu.read_memory(self.address + PERIPH_PTCR, 4)
+        return 1 if ptcr_val & RX_ENABLE_MASK == 0x1 else 0 #if enable and disable set --> disabled
+
+    def get_next_ptr_size(self):
+        """ return value of the next counter register """
+        return self.emu.read_memory(self.address + PERIPH_RNCR, 2)
+
+    def update_receive_ptr(self):
+        """ Move next receive pointer to the receive pointer register; also update the counter """
+        self.emu.write_memory(self.address + PERIPH_RPR, 4, self.emu.read_memory(self.address + PERIPH_RNPR, 4)) #copy
+        self.emu.write_memory(self.address + PERIPH_RNPR, 4, 0) #zero it
+        self.emu.write_memory(self.address + PERIPH_RCR, 4, self.emu.read_memory(self.address + PERIPH_RNCR, 4)) #copy
+        self.emu.write_memory(self.address + PERIPH_RNCR, 4, 0) #zero it
+
+    def set_endrx(self):
+        """ This bit is set in the peripherals interrupt enable register --> problem the offsets of and within the registers are different """
+        # just let the fuzzer do its thing
+        pass
+
+    def set_rxbuff(self):
+        """ This bit is set in the peripherals interrupt enable register --> problem the offsets of and within the registers are different """
+        # just let the fuzzer do its thing
+        pass
+
+    def hw_read(self, offset, size):
+        status = MMIO_HANDLE_RES_PASSTHROUGH
+        if offset == PERIPH_RPR:
+            pass
+        if offset == PERIPH_RCR:
+            pass
+        if offset == PERIPH_TPR:
+            pass
+        if offset == PERIPH_TCR:
+            pass
+        if offset == PERIPH_RNPR:
+            pass
+        if offset == PERIPH_RNCR:
+            pass
+        if offset == PERIPH_TNPR:
+            pass
+        if offset == PERIPH_TNCR:
+            pass
+        if offset == PERIPH_PTCR:
+            pass
+        if offset == PERIPH_PTSR:
+            pass
+        else:
+            # We handle the rest of the registers in place in memory, so pass reads through
+            status = MMIO_HANDLE_RES_FORWARD_TO_DEFAULT
+        val = None
+
+        return status, val
+
+    def hw_write(self, offset, size, value):
+        if offset == PERIPH_RPR:
+            pass
+        if offset == PERIPH_RCR:
+            pass
+        if offset == PERIPH_TPR:
+            pass
+        if offset == PERIPH_TCR:
+            pass
+        if offset == PERIPH_RNPR:
+            pass
+        if offset == PERIPH_RNCR:
+            pass
+        if offset == PERIPH_TNPR:
+            pass
+        if offset == PERIPH_TNCR:
+            pass
+        if offset == PERIPH_PTCR:
+            # directly write value and send of a tick
+            self.emu.write_memory(self.address + offset, size, value)
+            self.on_receive_tick(-1)
+            pass
+        if offset == PERIPH_PTSR:
+            pass
+
+
