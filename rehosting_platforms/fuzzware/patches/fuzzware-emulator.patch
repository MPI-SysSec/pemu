diff --git a/harness/fuzzware_harness/peripherals/mikrochip_atmel/sam3x.py b/harness/fuzzware_harness/peripherals/mikrochip_atmel/sam3x.py
new file mode 100644
index 0000000..de90957
--- /dev/null
+++ b/harness/fuzzware_harness/peripherals/mikrochip_atmel/sam3x.py
@@ -0,0 +1,357 @@
+from binascii import hexlify
+
+from ..peripheral import Peripheral
+from .. import MMIO_HANDLE_RES_PASSTHROUGH, MMIO_HANDLE_RES_FORWARD_TO_DEFAULT
+
+CONFIG_NAME_NUM_DMA_CHANNELS = "num_channels"
+
+""" Mikrochip/Atmel SAM3x DMA Controller Implementation
+Data sheet: https://ww1.microchip.com/downloads/en/DeviceDoc/Atmel-11057-32-bit-Cortex-M3-Microcontroller-SAM3X-SAM3A_Datasheet.pdf
+
+This implementation keeps its state in MMIO memory and evaluates the current DMA configuration
+and interrupt state based on RAM contents within the MMIO range.
+
+This is why in this implementation, MMIO hw_read and hw_write handlers are mostly pass-throughs.
+
+An alternative way of implementing this functionality is pre-calculating DMA buffer configuration
+states and ownerships whenever MMIO writes are performed.
+"""
+
+""" Config entry in config.yml
+peripherals:
+  sam3x:
+    class: fuzzware_harness.peripherals.mikrochip_atmel.sam3x.DMAC
+    base_addr: 0x400C4000
+    size: 0x200
+    irqs:
+      - 0x37
+"""
+
+# TODO: signal DMA send operation successes (to allow fw to not block on output)? PINC / PSIZE / MEM2MEM / DIR
+
+
+DMAC_GCFG = 0x0 #Global configuration register
+DMAC_EN = 0x4 #Enable register
+DMAC_SREQ = 0x8 #Software single request register
+DMAC_CREQ = 0xc #Software chunk transfer request register
+DMAC_LAST = 0x10 #Software Last Transfer Flag Register
+DMAC_EBCIER = 0x18 #Error, buffer transfer and chained buffer transfer interrupt enable register
+DMAC_EBCIDR = 0x1c #Error, buffer transfer and chained buffer transfer interrupt disable register
+DMAC_EBCIMR = 0x20 #Error, buffer transfer and chained buffer transfer interrupt mask register
+DMAC_EBCISR = 0x24 #Error, buffer transfer and chained buffer transfer interrupt status register
+DMAC_CHER = 0x28 #Channel handler enable register
+DMAC_CHDR = 0x2c #Channel handler disable register
+DMAC_CHSR = 0x30 #Channel handler status register
+DMAC_SADDRx = [0x3c, 0x64, 0x8c, 0xb4, 0xdc, 0x104] #Channel x source address register
+DMAC_DADDRx = [0x40, 0x68, 0x90, 0xb8, 0xe0, 0x108] #Channel x destination address register
+DMAC_DSCRx = [0x44, 0x6c, 0x94, 0xbc, 0xe4, 0x10c] #Channel x descriptor address register
+DMAC_CTRLAx = [0x48, 0x70, 0x98, 0xc0, 0xe8, 0x110] #Channel x control a register
+DMAC_CTRLBx = [0x4c, 0x74, 0x9c, 0xc4, 0xec, 0x114] #Channel x control b register
+DMAC_CFGx = [0x50, 0x78, 0xa0, 0xc8, 0xf0, 0x118] #Channel x configuration register
+DMAC_WPMR = 0x1e4 #Write protext mode register
+DMAC_WPSR = 0x1e8 #Write protect status register
+
+DST_WIDTH_MASK = 0x30000000
+DST_WIDTH_SHIFT = 28
+DCSIZE_MASK = 0x00700000
+DCSIZE_SHIFT = 20
+DIR_MASK = 0x00e00000
+DST_INCR_MASK = 0x30000000
+BTSIZE_MASK = 0xffff
+BITMASK_INTERRUPTS_TRIGGERED = 0x10101
+
+ITEM_SIZES = {
+    0: 1,
+    1: 2,
+    2: 4,
+    3: 4
+}
+
+DEFAULT_BASE_ADDR = 0x400C4000
+
+DEFAULT_NUM_CHANNELS = 6
+class DMAC(Peripheral):
+    _num_channels: int
+
+    def __init__(self, name, addr, size, owned_irqs, emu, comm, config=None, **kwargs):
+        if addr is None:
+            addr = DEFAULT_BASE_ADDR
+
+        self._num_channels = config.get(CONFIG_NAME_NUM_DMA_CHANNELS, DEFAULT_NUM_CHANNELS)
+        super().__init__(name, addr, size, owned_irqs, emu, comm, config, kwargs=kwargs)
+
+    def get_dma_buf(self, channel_ind):
+        """
+        For a given index, get start address and size of a DMA buffer.
+
+        We use this to prepare DMA buffer writes
+
+        @return: (start, size)
+        """
+        start = self.emu.read_memory(self.address + DMAC_DADDRx[channel_ind], 4)
+        ctrlax = self.get_ctrlax_val(channel_ind) 
+        #btsize
+        btsize = (ctrlax & BTSIZE_MASK)
+        #dst_width should equal memsize on f103
+        dst_width (ctrlax & DST_WIDTH_MASK) >> DST_WIDTH_SHIFT
+        #dcsize = destination chunk transfer size 
+        dcsize = (ctrlax & DCSIZE_MASK) >> DCSIZE_SHIFT
+        item_count = 2 << dcsize if dcsize != 0 else 1 #see table DCSIZE page 375
+
+        if dst_width == 1:
+            multiplier = 2
+            start &= ~0b01
+        if dst_width >= 2:
+            multiplier = 4
+            start &= ~0b11
+
+        #TODO actually correct?
+        return start, btsize * item_count * multiplier
+
+    def can_pend_interrupt(self, irq_num):
+        # We only own one interrupt, so don't even check irq_num
+
+        # TODO: when interrupts are not used for transfer of ownership, take this as a question to trigger a write anyways in this
+        #       case we could perform the writes in the loop here for those channels that are enabled, but have the interrupt disabled
+
+        return len(self.get_live_dma_channels()) != 0
+
+    #TODO
+    def on_interrupt_entry(self, num_irq):
+
+        if not self.inc_packet_count():
+            # Raise value error to indicate ending
+            print("[SAM3x DMA on_interrupt_entry] packet limit exceeded") 
+            self.emu.stop()
+            return
+
+        curr_ebcisr_val = self.emu.read_memory(self.address + DMAC_EBCISR, 4)
+        for i, dma_buf_addr, dma_buf_len in self.get_live_dma_channels():
+            fuzz_bytes = self.comm.get_bytes(dma_buf_len)
+            # crashing input
+            fuzz_bytes= self.comm.get_bytes(dma_buf_len)
+
+            print(f"[SAM3x DMA on_interrupt_activation] dma_buf_addr: {dma_buf_addr:#x}, dma_buf_len: {dma_buf_len:#x}. Writing contents: {hexlify(fuzz_bytes)}", flush=True)
+            self.emu.write_memory(dma_buf_addr, len(fuzz_bytes), fuzz_bytes, raw=True)
+
+            # increment DMA pointer register according to the MINC flag in the channel's config
+            if self.get_dst_incr(self.get_ctrlbx_val(i)):
+                self.emu.write_memory(self.address + DMAC_DADDRx[i], 4, dma_buf_addr + dma_buf_len)
+            elif self.get_dst_decr(self.get_ctrlbx_val(i)):
+                self.emu.write_memory(self.address + DMAC_DADDRx[i], 4, dma_buf_addr - dma_buf_len)
+
+            # feed new DMA status into EBCISR (to not accidentally trigger another interrupt too early)
+            curr_ebcisr_val |= (0b100000001 << i) #cbtc#i and btc#i
+            self.disable_channel(i)
+
+        self.emu.write_memory(self.address + DMAC_EBCISR, 4, curr_ebcisr_val)
+        # TODO disable channel once transfer completes
+
+
+    def controller_enabled(self):
+        """ Return 1 if controller is enabled """
+        return (self.emu.read_memory(self.address + DMAC_EN, 4) & 0x1)
+
+    def get_ctrlax_val(self, channel_ind):
+        return self.emu.read_memory(self.address + DMAC_CTRLAx[channel_ind], 4)
+
+    def get_ctrlbx_val(self, channel_ind):
+        return self.emu.read_memory(self.address + DMAC_CTRLBx[channel_ind], 4)
+
+    def get_cfgx_val(self, channel_ind):
+        return self.emu.read_memory(self.address + DMAC_CFGx[channel_ind], 4)
+    
+    def channel_interrupt_already_triggered(self, ebcimr_val, channel_ind):
+        int_bits = ebcimr_val >> channel_ind
+        return (int_bits & BITMASK_INTERRUPTS_TRIGGERED) != 0
+
+    def interrupts_enabled(self, ebcier_val, ebcidr_val, channel_ind):
+        """ Return 1 if interrupts are enabled for a given channel """ 
+        # Not clear what happens when registers have contradicting values
+        # For now only look for enabled bits, and disregard the disable vals 
+        return 1 if ((ebcier_val >> channel_ind) & BITMASK_INTERRUPTS_TRIGGERED) != 0 else 0
+
+    def get_number_of_data(self, channel_ind):
+        """ Return BTSIZE? """
+        #TODO??
+        return self.emu.read_memory(self.address + DMAC_CTRLAx[channel_ind], 2)
+
+    def is_to_mem_direction(self, ctrlbx_val):
+        return (ctrlbx_val & DIR_MASK) % 2 == 0 #vals 0 and 2 indicate to mem direction
+
+    def get_is_mem_to_mem(self, ctrlbx_val):
+        return ctrlbx_val & DIR_MASK == 0 #if 0 then it is mem2mem
+
+    def get_item_size(self, ctrlax):
+        dst_width = (ctrlax & DST_WIDTH_MASK) >> DST_WIDTH_SHIFT
+
+        return ITEM_SIZES[dst_width]
+
+    def get_dma_buf_addr(self, channel_ind):
+        return self.emu.read_memory(self.address + DMAC_DADDRx[channel_ind], 4)
+
+    def get_dst_incr(self, ctrlbx_val):
+        return (ctrlbx_val & DST_INCR_MASK) == 0
+
+    def get_dst_decr(self, ctrlbx_val):
+        return (ctrlbx_val & DST_INCR_MASK) == 1
+    
+    def get_channel_status_register(self):
+        """ Return the entire channel status register (DMAC_CHSR) """
+        return self.emu.read_memory(self.address + DMAC_CHSR, 4)
+
+    def enable_channel(self, channel_ind):
+        """ Enable channel in the DMAC_CHSR """
+        self.emu.write_memory(self.address + DMAC_CHSR, 4, (self.get_channel_status_register | (0x1 << channel_ind)))
+
+    def disable_channel(self, channel_ind):
+        """ Disable channel in the DMAC_CHSR """
+        self.emu.write_memory(self.address + DMAC_CHSR, 4, (self.get_channel_status_register() & (0xffffffff ^ (0x1 << channel_ind))))
+    
+    def is_channel_enabled(self, channel_ind):
+        """ Return 1 if channel is enabled """
+        return ((self.emu.read_memory(self.address + DMAC_CHER, 4) & (0x1 << channel_ind)) >> channel_ind)
+
+    def is_channel_suspended(self, channel_ind):
+        """ Return 1 if channel is to be frozen """
+        return (((self.emu.read_memory(self.address + DMAC_CHER, 4) >> 0x8) & (0x1 << channel_ind)) >> channel_ind)
+
+    def is_channel_resume(self, channel_ind):
+        """ Return 1 if channel can be continued """
+        return (((self.emu.read_memory(self.address + DMAC_CHER, 4) >> 0x18) & (0x1 << channel_ind)) >> channel_ind)
+
+    def get_enabled_ints(self, channel_ind): 
+        return (self.emu.read_memory(self.address + DMAC_EBCIER, 4) & (0x010101 << channel_ind))
+
+    def get_disabled_ints(self):
+        return (self.emu.read_memory(self.address + DMAC_EBCIDR, 4) & (0x010101 << channel_ind))
+
+    #TODO DMAC_EBCIMR
+    def get_set_interrupt(self):
+        pass
+
+    def get_live_dma_channels(self):
+        # TODO perf: make this a generator? cache highest-used enabled channel index?
+        if not self.controller_enabled():
+            return []
+        
+        # 22.3.5.1
+        # 4. After the DMAC selected channel has been programmed, enable the channel by writing a ‘1’ to the
+        # DMAC_CHER.ENAx bit, where x is the channel number. Make sure that bit 0 of DMAC_EN.ENABLE
+        # register is enabled.
+        result = []
+
+        ebcimr_val = self.emu.read_memory(self.address + DMAC_EBCIMR, 4)
+        ebcier_val = self.emu.read_memory(self.address + DMAC_EBCIER, 4)
+        ebcidr_val = self.emu.read_memory(self.address + DMAC_EBCIDR, 4)
+
+
+        for i in range(self._num_channels):
+            is_enabled = self.is_channel_enabled(i)
+            is_owned = self.interrupts_enabled(ebcier_val, ebcidr_val, i) and not self.channel_interrupt_already_triggered(ebcimr_val, i)
+            is_to_mem_data_direction = self.is_to_mem_direction(self.get_ctrlbx_val(i))
+            is_mem_to_mem = self.get_is_mem_to_mem(self.get_ctrlbx_val(i))
+            item_count = self.get_number_of_data(i)
+
+
+            if is_owned and is_enabled and item_count != 0 and is_to_mem_data_direction:# and not is_mem_to_mem:
+                item_size = self.get_item_size(self.get_ctrlax_val(i))
+                base_addr = self.get_dma_buf_addr(i)
+                result.append((i, base_addr, item_count * item_size))
+        return result
+
+    def hw_read(self, offset, size):
+        if offset == DMAC_GCFG:
+            pass
+        if offset == DMAC_EN:
+            pass
+        if offset == DMAC_SREQ:
+            pass
+        if offset == DMAC_CREQ:
+            pass
+        if offset == DMAC_LAST:
+            pass
+        if offset == DMAC_EBCIER:
+            pass
+        if offset == DMAC_EBCIDR:
+            pass
+        if offset == DMAC_EBCIMR:
+            pass
+        if offset == DMAC_EBCISR:
+            # 22.4.5.1
+            # 2. Clear any pending interrupts on the channel from the previous DMAC transfer by reading the interrupt status
+            # register, DMAC_EBCISR
+            ebcisr_val = self.emu.read_memory(self.address + DMAC_EBCISR, 4)
+            self.emu.write_memory(self.address + DMAC_EBCISR, 4, 0)
+            return 0, ebcisr_val #0 = is handled
+        if offset == DMAC_CHER:
+            pass
+        if offset == DMAC_CHDR:
+            pass
+        if offset == DMAC_CHSR:
+            pass
+        if offset == DMAC_SADDRx:
+            pass
+        if offset == DMAC_DADDRx:
+            pass
+        if offset == DMAC_DSCRx:
+            pass
+        if offset == DMAC_CTRLAx:
+            pass
+        if offset == DMAC_CTRLBx:
+            pass
+        if offset == DMAC_CFGx:
+            pass
+        if offset == DMAC_WPMR:
+            pass
+        if offset == DMAC_WPSR:
+            pass
+
+        # We handle the rest of the registers in place in memory, so pass reads through
+        status = MMIO_HANDLE_RES_PASSTHROUGH
+        val = None
+
+        return status, val
+
+    def hw_write(self, offset, size, value):
+        # TODO some read only register. for now just passthrough, maybe adjust later
+        if offset == DMAC_GCFG:
+            pass
+        if offset == DMAC_EN:
+            pass
+        if offset == DMAC_SREQ:
+            pass
+        if offset == DMAC_CREQ:
+            pass
+        if offset == DMAC_LAST:
+            pass
+        if offset == DMAC_EBCIER:
+            pass
+        if offset == DMAC_EBCIDR:
