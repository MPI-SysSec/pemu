+from fuzzware_harness.network.artificial_network_interface import ANI
+from fuzzware_harness.tracing.trace_ids import next_event_id
+import importlib
+from ... import native
+from ... import globs
+
+
+NUM_PENDS = 127
+RX_MMIO_BUF=0x400e0818
+IRQ_GO_MMIO_BUF= 0x400e0814
+cur_packet_index = 0
+next_packet = b''
+#LEN = 127
+LEN = NUM_PENDS
+ani = None
+block_reads = False
+
+
+
+##################
+##### RECEIVE ####
+##################
+def irq_rx_hook(uc):
+    global block_reads
+    if block_reads:
+        uc.mem_write(IRQ_GO_MMIO_BUF, b'\x00')
+    else:
+        uc.mem_write(IRQ_GO_MMIO_BUF, b'\x01')
+
+def data_processed(uc):
+    global block_reads
+    block_reads = False
+def rx_hook(uc):
+    if not ani:
+        setup_ani(uc)
+    global next_packet
+    global cur_packet_index
+    global block_reads
+    if cur_packet_index == 0:
+        block_reads = False
+        max_len = LEN
+        next_packet = None
+        if ani:
+            next_packet = ani.get_packet(max_n = max_len) 
+        if not next_packet:
+            next_packet = max_len * b'\x41'
+
+        #if len(next_packet) < NUM_PENDS:
+        #    next_packet += b'\x00' * (NUM_PENDS - len(next_packet))
+        #    print(next_packet)
+        
+
+
+    
+    if next_packet:
+        uc.mem_write(RX_MMIO_BUF, next_packet[cur_packet_index].to_bytes(1, "little"))
+        cur_packet_index += 1
+
+        if cur_packet_index >= len(next_packet):
+            log_dma_access(RX_MMIO_BUF, len(next_packet), next_packet, "rx", True, 0)
+            
+            block_reads = True
+            cur_packet_index = 0
+            next_packet = b''
+
+
+
+def fuzz_proxy(n: int):
+    return native.get_fuzz(globs.uc, n)
+
+def setup_ani(uc):
+    global ani
+    if globs.global_ani:
+        ani = globs.global_ani
+        return
+
+def log_dma_access( addr: int, size: int, data: bytes, mode: str, packed: bool,last_fuzz_access_index):
+    next_fuzz_access_index = native.fuzz_consumed()
+    from binascii import hexlify
+    globs.dma_state.append({'buffer': addr, 'packet_size': size, 'data': str(hexlify(data)), 'mode': mode, 'packed': packed, 'start_cursor': last_fuzz_access_index, 'next_cursor': next_fuzz_access_index, 'event_id': next_event_id(globs.uc)})
