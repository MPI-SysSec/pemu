+++ b/harness/fuzzware_harness/peripherals/stm32/f429.py
@@ -0,0 +1,725 @@
+from binascii import hexlify
+
+from ..peripheral import Peripheral
+from .. import MMIO_HANDLE_RES_PASSTHROUGH, MMIO_HANDLE_RES_FORWARD_TO_DEFAULT
+
+import fuzzware_harness.globs as globs
+import logging
+
+CONFIG_NAME_NUM_DMA_CHANNELS = "num_channels"
+""" STM32 F767 Ethernet DMA Controller Implementation
+Data sheet: https://www.st.com/resource/en/reference_manual/dm00224583-stm32f76xxx-and-stm32f77xxx-advanced-arm-based-32-bit-mcus-stmicroelectronics.pdf
+
+This implementation keeps its state in MMIO memory and evaluates the current DMA configuration
+and interrupt state based on RAM contents within the MMIO range.
+
+This is why in this implementation, MMIO hw_read and hw_write handlers are mostly pass-throughs.
+
+An alternative way of implementing this functionality is pre-calculating DMA buffer configuration
+states and ownerships whenever MMIO writes are performed.
+"""
+
+""" Config entry in config.yml
+peripherals:
+  stm32f767rb:
+    class: fuzzware_harness.peripherals.stm32.f767_ethernet.DMAC
+    base_addr: 0x40029000
+    size: 0x400
+    irqs:
+        # DMA1_Channel1_IRQHandler
+        - 72
+"""
+
+# TODO regarding the f429 SEmu sample (and potentially more)
+# We trigger a transfer on interrupt entry.
+# However, the samples do not use the interrupts (at least as far as we know).
+# Instead an idle loop checks if new data was received.
+# We can regularly (trigger pulse) check, whether we can perform a transfer, by
+# alternating between receive and transmit interrupt.
+# If we were able to send/receive something, we can set a flag (transfer_completed_and waiting).
+# If the interrupt_entry were to be used, it needs to check this flag and don't transfer anything
+# if it is true. And then reset the transfer completed and waiting flag.
+# So far so easy. We run into problems, when resetting the flag.
+# The obvious would be, when the descriptor is modified/updated again. BUT we dont have hooks on the descriptors.
+
+# Alternative:
+# Make use of the SR/ST bit in the ETH_DMAOMR on pulses and for recorded write
+
+
+
+
+logger = logging.getLogger("DMA")
+
+#TODO: skip timestamping for now --> only normal rx dma descriptors for now
+RX_INTERRUPT = 0
+TX_INTERRUPT = 1
+
+ETH_DMABMR = 0x000 #dma bus mode register
+ETH_DMATPDR = 0x004 #ddma transmit poll demand register
+ETH_DMARPDR = 0x008 #dma receive poll demand register
+ETH_DMARDLAR = 0x00c #dma receive descriptor list addr register
+ETH_DMATDLAR = 0x010 #dma transmit descriptor list addr register
+ETH_DMASR = 0x014 #dma status register
+ETH_DMAOMR = 0x018 #dma operation mode register
+ETH_DMAIER = 0x01c #dma interrupt enable register
+ETH_DMAMFBOCR = 0x020 #dma missed frame and buffer overflow counter register
+ETH_DMARSWTR = 0x024 #dma receive status watchdog timer register
+ETH_DMACHTDR = 0x048 #dma current host transmit descriptor register
+ETH_DMACHRDR = 0x04c #dma current host receive descriptor register
+ETH_DMACHTBAR = 0x050 #dma current host transmit buffer address register
+ETH_DMACHRBAR = 0x054 #dma current host receive buffer address register
+
+RDES0 = 0x0 #offset to value given in eth_dmardlar, status
+RDES1 = 0x4 # sizes of of buffer1 and 2
+RDES2 = 0x8 # buffer1 addr
+RDES3 = 0xc # buffer2 addr or next descriptor addr
+
+SR_MASK = 0x2 #start/stop receive bit
+ST_MASK = 1 << 13 #start/stop transmit bit
+DFRF_MASK = 1 << 24 #disable flushin of received frames
+RCH_MASK = 1 << 14
+TCH_MASK = 1 << 20
+OWN_MASK = 1 << 31
+RBS1_MASK = 0x1fff
+RBS2_MASK = 0x1fff0000
+RER_MASK = 1 << 15
+TER_MASK = 1 << 20
+DIC_MASK = 1 << 31 
+FS_MASK = 1 << 9 #first descriptor of frame
+LS_MASK = 1 << 8 #last descriptor of frane 
+TX_LS_MASK = 1 << 29
+RS_MASK = 1 << 6 #receive stauts bit in ETH_DMASR
+ERS_MASK = 1 << 14 #early receive status in ETH_DMASR
+NISE_MASK = 1 << 16
+IC_MASK = 1 << 30
+TS_MASK = 1
+TBUS_MASK = 1 << 2
+IER_RCV_MASK = NISE_MASK | RS_MASK | ERS_MASK  # interrupt mask for receive interrupts in DMA_IR
+
+DESCRIPTOR_SIZE = 0x10 * 4 #4 dwords
+
+DEFAULT_BASE_ADDR = 0x40029000 #TODO ethernet base addr
+
+
+class ETH(Peripheral):
+    packets_placed: int
+    next_interrupt: int
+    tx_suspended: bool
+    transfer_completed_and_waiting: bool
+
+    def __init__(self, name, addr, size, owned_irqs, emu, comm, ani, config=None, **kwargs):
+        if addr is None:
+            addr = DEFAULT_BASE_ADDR
+        logger.debug("INIT")
+        
+        self.wait_for_next = 0
+        self.packets_placed = 0
+        self.next_interrupt = RX_INTERRUPT
+        self.tx_suspended = False
+        self.transfer_completed_and_waiting = False
+        self.parse_config(config)
+        # initialize packer
+        super().__init__(name, addr, size, owned_irqs, emu, comm, ani, config, kwargs=kwargs)
+
+        
+    def parse_config(self, config):
+        self._packet_limit = config.get("packet_limit", 0xffffffff)
+
+    def get_receive_status(self):
+        #ETH_DMAOMR SR bit is set --> receive process is placed in running state
+        #logger.debug(f"[get_receive_status] ETH_DMAOMR: {self.emu.read_memory(self.address + ETH_DMAOMR, 4):#x}")
+        return ((self.emu.read_memory(self.address + ETH_DMAOMR, 4) & SR_MASK) >> 1)
+
+    def get_transmit_status(self):
+        #ETH_DMAOMR ST bit is set --> transmit process is placed in running state
+        #logger.debug(f"[get_tranmit_status] ETH_DMAOMR: {self.emu.read_memory(self.address + ETH_DMAOMR, 4):#x}")
+        return ((self.emu.read_memory(self.address + ETH_DMAOMR, 4) & ST_MASK) >> 13)
+
+    def get_flush_status(self):
+        #ETH_DMAOMR DRRF bit is set --> no flushing of frame
+        return ((self.emu.read_memory(self.address + ETH_DMAOMR, 4) & DFRF_MASK) >> 24)
+
+    def get_current_descriptor(self):
+        # read the ETH_DMACHRBAR, which contains the current descirptor
+        return self.emu.read_memory(self.address + ETH_DMACHRBAR, 4)
+
+    def get_current_tx_descriptor(self):
+        # read the ETH_DMACHRBAR, which contains the current descirptor
+        return self.emu.read_memory(self.address + ETH_DMACHTBAR, 4)
+
+    def set_current_descriptor(self, cur_descriptor):
+        # set the ETH_DMACHRBAR, which contains the current descirptor
+        return self.emu.write_memory(self.address + ETH_DMACHRBAR, 4, cur_descriptor)
+
+    def set_current_tx_descriptor(self, cur_tx_descriptor):
+        # set the ETH_DMACHRBAR, which contains the current descirptor
+        return self.emu.write_memory(self.address + ETH_DMACHTBAR, 4, cur_tx_descriptor)
+
+    def get_descriptor_structure(self):
+        #return 1 if it is a ring structure
+        return ((self.emu.read_memory(self.get_current_descriptor() + RDES1, 4) & RCH_MASK) >> 14)
+
+    def get_tx_descriptor_structure(self):
+        #return 1 if it is a ring structure
+        return ((self.get_tdes0_val() & TCH_MASK) >> 20)
+
+    def get_descriptor_owner(self):
+        #return 1 if owned by DMA, 0 if owned by the Host (aka CPU)
+        #read RDES0
+        return ((self.emu.read_memory(self.get_current_descriptor() + RDES0, 4) & OWN_MASK) >> 31)
+    
+    def get_tx_descriptor_owner(self):
+        #return 1 if owned by DMA, 0 if owned by the Host (aka CPU)
+        if not self.get_current_tx_descriptor() + RDES0:
+            return 0
+        return ((self.emu.read_memory(self.get_current_tx_descriptor() + RDES0, 4) & OWN_MASK) >> 31)
+
+    def get_buffer1_size(self):
