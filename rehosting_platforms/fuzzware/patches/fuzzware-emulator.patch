+from fuzzware_harness.network.artificial_network_interface import ANI
+from fuzzware_harness.tracing.trace_ids import next_event_id
+import importlib
+from ... import native
+from ... import globs
+
+
+# Channel - frquency mapping
+freq_to_chan = {2402: 37, 2404:0, 2406:1, 2408:2, 2410:3, 2412:4, 2414:5, 2416:6, 2418:7, 2420:8, 2422:9, 2424:10, 2426: 38, 2428:11, 2430:12, 2432:13, 2434:14, 2436:15, 2438:16, 2440:17, 2442:18, 2444:19, 2446:20, 2448:21, 2450:22, 2452:23, 2454:24, 2456:25, 2458:26, 2460:27, 2462:28, 2464:29, 2466:30, 2468:31, 2470:32, 2472:33, 2474:34, 2476:35, 2478:36, 2480:39}
+MMIO_PKT_PTR = 0x40001504
+MMIO_PCNF_1 = 0x40001518
+MMIO_FREQUENCY = 0x40001508
+LEN_MASK = 0xff
+TX_CHECK = 0x20007279
+last_fuzz_index = -1
+
+ani = None
+
+##################
+##### RECEIVE ####
+##################
+def nrf52_hook_rx(uc):
+    if not ani:
+        setup_ani(uc)
+    pkt_ptr = int.from_bytes(uc.mem_read(MMIO_PKT_PTR, 4), "little")
+    max_len = int.from_bytes(uc.mem_read(MMIO_PCNF_1, 4), "little") & 0xff
+    last_fuzz_index = native.fuzz_consumed()
+    fuzzing_input = ani.get_packet(max_n = max_len) 
+    if not fuzzing_input:
+        fuzzing_input = max_len * b'\x00'
+    uc.mem_write(pkt_ptr, fuzzing_input)
+    log_dma_access(pkt_ptr, len(fuzzing_input), fuzzing_input, "rx", True, last_fuzz_index)
+    print(f"writing fuzzing {max_len:#x} fuzzing bytes to {pkt_ptr:#x}")
+
+
+
+###################
+##### TRANSMIT ####
+###################
+def nrf52_hook_tx(uc):
+    if int.from_bytes(uc.mem_read(TX_CHECK, 1), "little") != 1:
+        return
+
+    if not ani:
+        setup_ani(uc)
+    pkt_ptr = int.from_bytes(uc.mem_read(MMIO_PKT_PTR, 4), "little")
+    packet_len = int.from_bytes(uc.mem_read(MMIO_PCNF_1, 4), "little") & 0xff
+    channel = _get_channel(_get_frequency(uc))
+
+    packet = uc.mem_read(pkt_ptr, packet_len)
+    ani.parse_packet(packet)
+    log_dma_access(pkt_ptr, len(packet), packet, "tx", False, last_fuzz_index)
+    print(f"trans {packet_len:#x} bytes from {pkt_ptr:#x} on channel {channel}: {packet}")
+
+
+def _get_channel(frequency: int) -> int:
+    """
+    Map a frquency value to a channel (Core v5.3 p. 2671; Table 1.3)
+    """
+    return freq_to_chan[frequency] if frequency in freq_to_chan else -1
+
+
+def _get_frequency(uc) -> int:
+    """
+    Get the freuency used for transmission
+    """
+    freq_val = int.from_bytes(uc.mem_read(MMIO_FREQUENCY, 4), "little")
+    base_frequency = 2360 if freq_val & 0x100 else 2400
+    return base_frequency + (freq_val & 0xff)
+
+def setup_ani(uc):
+    global ani
+    if globs.global_ani:
+        ani = globs.global_ani
+        return
+
+
+
+def log_dma_access( addr: int, size: int, data: bytes, mode: str, packed: bool,last_fuzz_access_index):
+    next_fuzz_access_index = native.fuzz_consumed()
+    from binascii import hexlify
+    globs.dma_state.append({'buffer': addr, 'packet_size': size, 'data': str(hexlify(data)), 'mode': mode, 'packed': packed, 'start_cursor': last_fuzz_access_index, 'next_cursor': next_fuzz_access_index, 'event_id': next_event_id(globs.uc)})
