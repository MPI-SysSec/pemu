+                logger.debug(f"[debug_tx] TDESC3 = {self.emu.read_memory(tdesc_base + RDES3, 4):#x}")
+                logger.debug(f"--------------------------------------")
+                logger.debug(f"")
+        else:
+            #chain structure rdes3 contains pointer to next descriptor
+            next_tdesc_base = self.emu.read_memory(tdesc_base + RDES3, 4)
+            while next_tdesc_base != tdesc_base:
+                logger.debug(f"[debug_tx] descriptor @ {next_tdesc_base:#x}")
+                logger.debug(f"-------------------------------")
+                logger.debug(f"[debug_tx] TDESC0 = {self.emu.read_memory(next_tdesc_base, 4):#x}")
+                logger.debug(f"-------------------------------")
+                logger.debug(f"[debug_tx] TDESC1 = {self.emu.read_memory(next_tdesc_base + RDES1, 4):#x}")
+                logger.debug(f"-------------------------------")
+                logger.debug(f"[debug_tx] TDESC2 = {self.emu.read_memory(next_tdesc_base + RDES2, 4):#x}")
+                logger.debug(f"-------------------------------")
+                logger.debug(f"[debug_tx] TDESC3 = {self.emu.read_memory(next_tdesc_base + RDES3, 4):#x}")
+                logger.debug(f"--------------------------------------")
+                logger.debug(f"")
+                next_tdesc_base = self.emu.read_memory(next_tdesc_base + RDES3, 4)
+
+
