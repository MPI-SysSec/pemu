+from binascii import hexlify
+
+from ..peripheral import Peripheral
+from .. import MMIO_HANDLE_RES_PASSTHROUGH, MMIO_HANDLE_RES_FORWARD_TO_DEFAULT
+
+CONFIG_NAME_NUM_DMA_CHANNELS = "num_channels"
+#TODO
+""" STM32 F767 DMA Controller Implementation
+Data sheet: https://www.st.com/resource/en/reference_manual/dm00224583-stm32f76xxx-and-stm32f77xxx-advanced-arm-based-32-bit-mcus-stmicroelectronics.pdf
+
+This implementation keeps its state in MMIO memory and evaluates the current DMA configuration
+and interrupt state based on RAM contents within the MMIO range.
+
+This is why in this implementation, MMIO hw_read and hw_write handlers are mostly pass-throughs.
+
+An alternative way of implementing this functionality is pre-calculating DMA buffer configuration
+states and ownerships whenever MMIO writes are performed.
+"""
+
+""" Config entry in config.yml
+peripheral:
+  stm32f767rb:
+    class: fuzzware_harness.peripherals.stm32.f767.DMAC
+    base_addr: 0x40020000
+    size: 0x400
+    irqs:
+        # DMA1_Channel1_IRQHandler
+        - 72
+"""
+
+# TODO: signal DMA send operation successes (to allow fw to not block on output)? PINC / PSIZE / MEM2MEM / DIR
+
+#completion: DMAflow controller: DMA_SxNDTR counter zero in M2P, clearing EN bit in DMA_SxCR and all data flushed from fifo to mem (M2M, P2M)
+
+#suspension
+
+#config procedure
+# 1. reset en bit in dma_sxcr
+# 2. set periph port register address DMA_sxpar
+# 3. Set mem address DMA_sxma0r (dma_sxma1r for double buffer)
+# 4. Configure data item number DMAsxndtr (decremented after perip event/burst)
+# 5. Select DMA channel CHSEL[3:0] In DMA_SxCR
+# 6. If periph flow controller set PFCTRL in DMA_Sxcr
+# 7. stream priority PL[1:] DMA_Sxcr
+# 8. Cinfigure FIFO usage
+# 9. Configure data transfer direction (increment/fixed, single/bursr, data width, circular/buffered)
+# 10. Active the stram by setting EN in DMA_sxcr
+
+#interrupts:
+# half-transfer, complete tranfer, transfer error, fifo error, direct mode error
+
+# TODO double buffering! --> done?
+# 1. set DBM bit in SxCR
+# 2. Circ mode is automatically enabled
+# 3. dma controller swaps between both memory adresses
+# 4. DMA_SxM0/1AR register can be updated on the fly (8.3.10. for rules)
+# --> tl;dr:check CT bit in SxCR --> otherwise these registers are write protected during enable
+
+# TODO FIFO? --> should be neglible as we always write item_count*item_size, skipping the fifo
+# each stream has an independent 4 word FIFO
+# threshods are 1/4, 1/2, 3/4 or full
+# threshold used wenn direct mode (DMDIS in DMA_SxFCR) is disabled
+# basically fifo doesn't matter: it only tells us how much memory we need to write at once: 1B - 32B
+
+# TODO peripheral flow controller --> maybe later
+# PFCTRL bit in DMA_SxCR
+# peroph flow controller only SDMMC1
+
+# TODO channel/stream priority --> maybe later (so far only one stream)
+
+# TODO single and burst transfers: --> maybe later (should be negligible)
+
+# TODO Error management (8.3.19) --> maybe later
+# Transfer error --> during double buffer mode
+# FIFO error --> probably negible ecept maybe fifo threshold lvl not compatible with mem burst size
+# direct mode error --> dma request when previos data not fully transferred
+
+DMA_LISR = 0x0 #dma low interrupt status register
+DMA_HISR = 0x04 #dma high interrupt status register
+DMA_LIFCR = 0x8 #dma low interrupt flag clear register
+DMA_HIFCR = 0x0c #dma high interript flag clear register
+DMA_SxCR = [0x10, 0x28, 0x40, 0x58, 0x70, 0x88, 0xa0] #dma stream control register
+DMA_SxNDTR = [0x14, 0x2c, 0x44, 0x5c, 0x74, 0x8c, 0xa4] #dma stream number of data register
+DMA_SxPAR = [0x18, 0x30, 0x48, 0x60, 0x78, 0x90, 0xa8] #dma stream periph addr register
+DMA_SxM0AR = [0x1c, 0x34, 0x4c, 0x64, 0x7c, 0x94, 0xac] #dma stram mem 0 addr register
+DMA_SxM1AR = [0x20, 0x38, 0x50, 0x68, 0x80, 0x98, 0xb0] #dma stream mem 1 addr register
+DMA_SxFCR = [0x24, 0x3c, 0x54, 0x6c, 0x84, 0x9c, 0xb4] #dma stream fifo ctrl register
+
+MINC_MASK = 1 << 10 #done
+MSIZE_MASK = 0x6000 #done
+MSIZE_MASK_SHIFT = 13 #done
+DIR_MASK = 0xc0 #done
+ENABLE_MASK = 0x01 #done
+#M2M_MASK = 0x4000 already encoded in the dir bits/mask
+CIRC_MASK = 0x100 #done
+DBM_MASK = 1 << 18 #done
+CT_MASK = 1 << 19
+HTIE = 1 << 3 #done
+TCIE = 1 << 4 #done
+INTERRUPTS_ENABLED_MASK = HTIE | TCIE #done
+
+BITMASK_INTERRUPTS_TRIGGERED = 0b110000
+
+ITEM_SIZES = {
+    0: 1,
+    1: 2,
+    2: 4
+}
+
+DEFAULT_BASE_ADDR = 0x40026000 #DMA1
+#DEFAULT_BASE_ADDR = 0x40026400 #DMA2
+
+DEFAULT_NUM_CHANNELS = 7
+
+def debug(msg):
+    #print("[DMA PERIPH]: " + msg)
+    #return
+    pass
+def debug2(msg):
+    print("[DMA PERIPH]: " + msg)
+    #return
+
+class DMAC(Peripheral):
+    _num_channels: int
+
+    def __init__(self, name, addr, size, owned_irqs, emu, comm, config=None, **kwargs):
+        if addr is None:
+            addr = DEFAULT_BASE_ADDR
+
+        debug("Init done")
+        debug(hex(addr))
+        debug(str(owned_irqs))
+
+        self._num_channels = config.get(CONFIG_NAME_NUM_DMA_CHANNELS, DEFAULT_NUM_CHANNELS)
+        super().__init__(name, addr, size, owned_irqs, emu, comm, config, kwargs=kwargs)
+
+    def get_dma_buf(self, channel_ind):
+        """
+        For a given index, get start address and size of a DMA buffer.
+
+        We use this to prepare DMA buffer writes
+
+        @return: (start, size)
+        """
+        start = self.emu.read_memory(self.address + DMA_SxM0AR[channel_ind], 4)
+        memsize = (self.emu.read_memory(self.address + DMA_SxCR[channel_ind], 4) & MSIZE_MASK) >> MSIZE_MASK_SHIFT
+        item_count = self.emu.read_memory(self.address + DMA_SxNDTR[channel_ind], 2)
+
+        multiplier = 1
+
+        if memsize == 1:
+            multiplier = 2
+            start &= ~0b01
+        if memsize == 2:
+            multiplier = 4
+            start &= ~0b11
+
+        return start, item_count * multiplier
+
+    def can_pend_interrupt(self, irq_num):
+        # We only own one interrupt, so don't even check irq_num
+
+        # TODO: when interrupts are not used for transfer of ownership, take this as a question to trigger a write anyways in this
+        #       case we could perform the writes in the loop here for those channels that are enabled, but have the interrupt disabled
+
+        return len(self.get_live_dma_channels()) != 0
+
+
+    def on_interrupt_entry(self, num_irq):
+        # print(f"[STM32 DMA on_interrupt_activation] irq num: {num_irq}")
+        debug("on_interrupt_activation irq num " + str(num_irq))
+
+        if not self.inc_packet_count():
+            # Raise value error to indicate ending
+            debug("packets placed exceeds packet limit")
+            self.emu.stop()
+            return
+        #f767 has two isr's!
+        cur_low_isr_val = self.emu.read_memory(self.address + DMA_LISR, 4)
+        cur_high_isr_val = self.emu.read_memory(self.address + DMA_HISR, 4)
+
+        for i, dma_buf_addr, dma_buf_len in self.get_live_dma_channels():
+            fuzz_bytes = self.comm.get_bytes(dma_buf_len)
+            #print(f"[STM32 DMA on_interrupt_activation] dma_buf_addr: {dma_buf_addr:#x}, dma_buf_len: {dma_buf_len:#x}. Writing contents: {hexlify(fuzz_bytes)}", flush=True)
+            self.emu.write_memory(dma_buf_addr, len(fuzz_bytes), fuzz_bytes, raw=True)
+
+            # increment DMA pointer register according to the MINC flag in the channel's config
+            cr_val = self.get_cr_val(i)
+            if self.get_minc(cr_val):
+                #TODO what about double buffering??
+                if self.get_double_buffered_mode(cr_val):
+                    if self.get_ct_val(cr_val):
+                        #current target in DMA_SxM1AR
+                        self.emu.write_memory(self.address + DMA_SxM1AR[i], 4, dma_buf_addr + dma_buf_len)
+                    else:
+                        #current target in DMA_SxM0AR
+                        self.emu.write_memory(self.address + DMA_SxM0AR[i], 4, dma_buf_addr + dma_buf_len)
+            else:
+                #no double buffering
+                self.emu.write_memory(self.address + DMA_SxM0AR[i], 4, dma_buf_addr + dma_buf_len)
+
+            # If we are not in circular mode (one-shot), set item count to 0
+            if self.get_circular_mode(cr_val) == 0:
+                self.emu.write_memory(self.address + DMA_SxNDTR[i], 2, 0)
+
+            # If we are in double buffer mode we need to toggle the ct bit, so next time the other buffer
+            # is choosen
+            if self.get_double_buffered_mode(cr_val):
+                self.emu.write_memory(self.address + DMA_SxCR[i], 4, cr_val ^ CT_MASK)
+            
+            # feed new DMA status into ISR (to not accidentally trigger another interrupt too early)
+            #mo: those bitmasks are some bs
+            if i < 4:
+                if i%2 == 0:
+                    cur_low_isr_val |= (0b11000 << (i*8))
+                else:
+                    cur_low_isr_val |= (0b1100 << (i*8))
+            else:
+
+                if i%2 == 0:
+                    cur_high_isr_val |= (0b11000 << ((i - 4)*8)) #otherwise we shift too much
+                else:
+                    cur_high_isr_val |= (0b1100 << ((i - 4)*8)) #^
+
+        self.emu.write_memory(self.address + DMA_LISR, 4, cur_low_isr_val)
+        self.emu.write_memory(self.address + DMA_HISR, 4, cur_high_isr_val)
+
+    def get_cr_val(self, channel_ind):
+        return self.emu.read_memory(self.address + DMA_SxCR[channel_ind], 4)
+
+
+    def channel_interrupt_already_triggered(self, lisr_val, hisr_val, channel_ind):
+        assert(channel_ind < 8, "[ASSERTION_ERROR] Illegal channel index")
+        if channel_ind < 4:
+            #LISR
+            int_bits = lisr_val >> (8*channel_ind)
+            if channel_ind % 2 == 0:
+                return (int_bits & 0b110000) != 0
+            else:
+                return (int_bits & 0b1100) != 0
+        else:
+            #HISR
+            channel_ind -= 4
+            int_bits = hisr_val >> (8*channel_ind)
+            if channel_ind % 2 == 0:
+                return (int_bits & 0b110000) != 0
+            else:
+                return (int_bits & 0b1100) != 0
+
+    def interrupts_enabled(self, cr_val):
+        # This is an approximation: If we are allowed to raise any 
+        # interrupts indicating progress, we will.
+        return cr_val & INTERRUPTS_ENABLED_MASK != 0
+
+    def channel_enabled(self, cr_val):
+        return cr_val & ENABLE_MASK == ENABLE_MASK
+
+    def get_number_of_data(self, channel_ind):
+        return self.emu.read_memory(self.address + DMA_SxNDTR[channel_ind], 2)
+
+    def is_to_mem_direction(self, cr_val):
+        #f67f allows for three modes: P2M, M2P, M2M, two of them are directed towards memory
+        return ((cr_val & DIR_MASK == 0b00) or (cr_val & DIR_MASK == 0b10))
+
+
+    def get_is_mem_to_mem(self, cr_val):
+        return cr_val & DIR_MASK == 0b01
+
+    def get_item_size(self, cr_val):
+        msize_field = (cr_val & MSIZE_MASK) >> MSIZE_MASK_SHIFT
+
+        # Value 3 is reserved
+        if msize_field not in ITEM_SIZES:
+            self.emu.crash()
+            return 1
+
+        return ITEM_SIZES[msize_field]
+
+    def get_dma_buf_addr(self, channel_ind):
+        return self.emu.read_memory(self.address + DMA_SxM0AR[channel_ind], 4)
+
+    def get_dma_double_buf_addr(self, channel_ind):
+        return self.emu.read_memory(self.address + DMA_SxM1AR[channel_ind], 4)
+
+    def get_minc(self, cr_val):
+        return cr_val & MINC_MASK
+
+    def get_circular_mode(self, cr_val):
+        return cr_val & CIRC_MASK
+
+    def get_double_buffered_mode(self, cr_val):
+        return cr_val & DBM_MASK
+
+    def get_ct_val(self, cr_val):
+        return cr_val & CT_MASK
+
+    def get_lisr(self):
+        return self.emu.read_memory(self.address + DMA_LISR, 4)
+
+    def get_hisr(self):
+        return self.emu.read_memory(self.address + DMA_HISR, 4)
+
+    def get_live_dma_channels(self):
+        # TODO perf: make this a generator? cache highest-used enabled channel index?
+
+        # Evaluate all the different flags and configs to figure out which buffers can be written to
+        # 1. Ownership
+        # 2. Enable Flag
+        # 3. Data Item Count
+        # 4. Data Direction
+
+        result = []
+
+        lisr_val = self.emu.read_memory(self.address + DMA_LISR, 4)
+        hisr_val = self.emu.read_memory(self.address + DMA_HISR, 4)
+
+        for i in range(self._num_channels):
+            cr_val = self.get_cr_val(i)
+            is_owned = self.interrupts_enabled(cr_val) and not self.channel_interrupt_already_triggered(lisr_val, hisr_val, i)
+            is_enabled = self.channel_enabled(cr_val)
+            item_count = self.get_number_of_data(i)
+            is_to_mem_data_direction = self.is_to_mem_direction(cr_val)
+            is_mem_to_mem = self.get_is_mem_to_mem(cr_val)
+            is_double_buffered = self.get_double_buffered_mode(cr_val)
+
+            if is_owned and is_enabled and item_count != 0 and is_to_mem_data_direction and not is_mem_to_mem:
+                # 8.3.10 Double-buffer mode
+                # When the CT bit is 0 in the DMA_SxCR register, the DMA_SxM1AR register can be written 
+                # and vice versa. Therefore, if the CT bit is 0 DMA_SxM0AR contains the correct dma
+                # buffer address and vice versa. (ct = current_target)
+                if is_double_buffered:
+                    if self.get_ct_val(cr_val):
+                        #current target in DMA_SxM1AR
+                        base_addr = self.get_dma_double_buf_addr(i)
+                    else:
+                        #current target in DMA_SxM0AR
+                        base_addr = self.get_dma_buf_addr(i)
+
+                else:
+                    base_addr = self.get_dma_buf_addr(i)
+
+                item_size = self.get_item_size(cr_val)
+                result.append((i, base_addr, item_count * item_size))
+
+        return result
+
+    # MMIO read
+    def hw_read(self, offset, size):
+        #8.5.1 & 8.5.2 DMA low/high interrupt status register (DMA_LISR/_HISR)
+
+        # Contrary to the f103 there is no global interrupt flag (only error flags)
+        # apart from the half/complete transfer. Therefore, we do not need to update
+        # it, and can simply mark LISR/HISR as passthrough
+
+        # We handle the rest of the registers in place in memory, so pass reads through
+        status = MMIO_HANDLE_RES_PASSTHROUGH
+        val = None
+
+        return status, val
+
+    # MMIO write
+    def hw_write(self, offset, size, value):
+        if offset == DMA_LISR:
+            # 8.5.1 DMA low interrupt status register (DMA_LISR)
+
+            # readonly register, do nothing
+            pass
+
+        if offset == DMA_HISR:
+            # 8.5.2 DMA high interrupt status register (DMA_HISR)
+
+            # readonly register, do nothing
+            pass
+
+        elif offset == DMA_LIFCR:
+            # 8.5.2 DMA low interrupt flag clear register (DMA_LIFCR)
+            # we need to update the low status register (DMA_LISR) based on 1-bits
+
+            cur_low_isr_val = self.get_lisr()
+            # mask the bits in the status registers which are to be cleared
+            new_isr_val = cur_low_isr_val & ~value
+            # print(f"[STM32 DMA hw_write] DMA_LIFCR low interrupt clear register write. Value: {value:#x}. This changes LIFCR from {cur_high_isr_val:#x} to {new_isr_val:#x}", flush=True)
+            self.emu.write_memory(self.address + DMA_LISR, 4, new_isr_val)
+
+        elif offset == DMA_HIFCR:
+            # 8.5.3 DMA high interrupt flag clear register (DMA_HIFCR)
+            # we need to update the high status register (DMA_HISR) based on 1-bits
+
+            cur_high_isr_val = self.get_hisr()
+            # mask the bits in the status registers which are to be cleared
+            new_isr_val = cur_high_isr_val & ~value
+            # print(f"[STM32 DMA hw_write] DMA_HIFCR high interrupt clear register write. Value: {value:#x}. This changes HIFCR from {cur_high_isr_val:#x} to {new_isr_val:#x}", flush=True)
+            self.emu.write_memory(self.address + DMA_HISR, 4, new_isr_val)
+
+        elif offset in DMA_SxCR:
+            # 8.5.5 DMA stream x configuration register (DMA_SxCr)
+            # We evaluate this when being asked about pending interrupts and
+            # placing input
+            pass
+
+        elif offset in DMA_SxNDTR:
+            # 8.5.6 DMA stream x number of data register (DMA_SxNDTR)
+            # we evaluate this when wanting to write to the DMA buffer
+            pass
+
+        elif offset in DMA_SxPAR:
+            # 8.5.7 DMA stream x peripheral address register (DMA_SxPAR)
+            # we ignore this register as it is the DMA peripheral register
+            pass
+
+        elif offset in DMA_SxM0AR:
+            # 8.5.8 DMA stream x memory 0 address register (DMA_SxM0AR)
+            # we evaluate this when wanting to write to the DMA buffer
+            # in double buffered mode this register can be written while the channel is enabled
+            pass
+
+        elif offset in DMA_SxM1AR:
+            # 8.5.9 DMA stream x memory 1 address register (DMA_SxM1AR)
+            # we evaluate this when wanting to write to the DMA buffer
+            # in double buffered mode this register can be written while the channel is enabled
+            pass
+
+        elif offset in DMA_SxFCR:
+            #8.5.10 DMA stream x FIFO control register (DMA_SxFCR)
+            #TODO threshold selection/direct mode should affect the amount of data processed
+            # at once?
+            pass
+
