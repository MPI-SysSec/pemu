+# https://infocenter.nordicsemi.com/pdf/nRF52832_PS_v1.1.pdf
+
+# Config:
+"""
+peripherals:
+  nrf52UARTe:
+    class: fuzzware_harness.peripherals.nordic.nrf52.SerialDMAC
+    base_addr: 0x40002000
+    size: 0x570
+    # Alternatives: SPIS
+    device_type: UARTE
+    irqs:
+      # UARTE0_UART0_IRQHandler
+      - 0x12
+"""
+
+import logging
+
+from typing import Dict
+
+from ..peripheral import Peripheral
+from .. import MMIO_HANDLE_RES_PASSTHROUGH, MMIO_HANDLE_RES_FORWARD_TO_DEFAULT
+
+logger = logging.getLogger("DMA")
+
+# TODO: Looking at the other peripheral types (I2S, ...), we might need separate implementations
+#       due to more conflicts in register offsets for other NRF52 peripherals.
+CONFIG_NAME_DEVICE_TYPE = "device_type"
+DEVICE_TYPE_UARTE = "UARTE"
+DEVICE_TYPE_SPIS = "SPIS"
+
+OFFSET_TASKS_STARTRX = 0
+OFFSET_TASKS_STOPRX = 4
+OFFSET_TASKS_STARTTX = 8
+OFFSET_TASKS_STOPTX = 0xc
+# SPIS ("SPI slave" peripheral) uses semaphore acquire/release tasks
+OFFSET_TASKS_ACQUIRE = 0x24
+OFFSET_TASKS_RELEASE = 0x28
+OFFSET_TASKS_FLUSHRX = 0x2c
+
+OFFSET_EVENTS_CTS = 0x100 # CTS is activated (set low). Clear To Send.
+# Collision between offsets! For now, we handle this via a flag.
+# SPIS  peripheral: EVENTS_END 0x104 Granted transaction completed
+# UARTE peripheral: EVENTS_NCTS 0x104 CTS is deactivated (set high). Not Clear To Send.
+OFFSET_EVENTS_NCTS = 0x104 # CTS is deactivated (set high). Not Clear To Send.
+OFFSET_EVENTS_END = OFFSET_EVENTS_NCTS
+OFFSET_EVENTS_RXDRDY = 0x108 # Data received in RXD (but potentially not yet transferred to Data RAM)
+OFFSET_EVENTS_ENDRX = 0x110 # Receive buffer is filled up
+OFFSET_EVENTS_TXDRDY = 0x11C # Data sent from TXD
+OFFSET_EVENTS_ENDTX = 0x120 # Last TX byte transmitted
+OFFSET_EVENTS_ERROR = 0x124 # Error detected
+OFFSET_EVENTS_ACQUIRED = 0x128 # Semaphore acquired
+OFFSET_EVENTS_RXTO = 0x144 # Receiver timeout
+OFFSET_EVENTS_RXSTARTED = 0x14C # UART receiver has started
+OFFSET_EVENTS_TXSTARTED = 0x150 # UART transmitter has started
+OFFSET_EVENTS_TXSTOPPED = 0x158 # Transmitter stopped
+
+OFFSET_SHORTS = 0x200 # Shortcut register
+OFFSET_INTEN = 0x300 # Enable or disable interrupt
+OFFSET_INTENSET = 0x304 # Enable interrupt
+OFFSET_INTENCLR = 0x308 # Disable interrupt
+OFFSET_ERRORSRC = 0x480 # Error source
+OFFSET_ENABLE = 0x500 # Enable UART
+OFFSET_PSEL_RTS = 0x508 # Pin select for RTS signal
+OFFSET_PSEL_TXD = 0x50C # Pin select for TXD signal
+OFFSET_PSEL_CTS = 0x510 # Pin select for CTS signal
+OFFSET_PSEL_RXD = 0x514 # Pin select for RXD signal
+OFFSET_BAUDRATE = 0x524 # Baud rate. Accuracy depends on the HFCLK source selected.
+OFFSET_RXD_PTR = 0x534 # Data pointer
+OFFSET_RXD_MAXCNT = 0x538 # Maximum number of bytes in receive buffer
+OFFSET_RXD_AMOUNT = 0x53C # Number of bytes transferred in the last transaction
+OFFSET_TXD_PTR = 0x544 # Data pointer
+OFFSET_TXD_MAXCNT = 0x548 # Maximum number of bytes in transmit buffer
+OFFSET_TXD_AMOUNT = 0x54C # Number of bytes transferred in the last transaction
+OFFSET_CONFIG = 0x56C # Configuration of parity and hardware flow control
+
+REG_OFFSETS = frozenset((
+    OFFSET_SHORTS, OFFSET_INTEN, OFFSET_INTENSET, OFFSET_INTENCLR, OFFSET_ERRORSRC, OFFSET_ENABLE, OFFSET_PSEL_RTS,
+    OFFSET_PSEL_TXD, OFFSET_PSEL_CTS, OFFSET_PSEL_RXD, OFFSET_BAUDRATE, OFFSET_RXD_PTR, OFFSET_RXD_MAXCNT, OFFSET_RXD_AMOUNT,
+    OFFSET_TXD_PTR, OFFSET_TXD_MAXCNT, OFFSET_TXD_AMOUNT, OFFSET_CONFIG, OFFSET_EVENTS_CTS, OFFSET_EVENTS_NCTS, OFFSET_EVENTS_RXDRDY,
+    OFFSET_EVENTS_ENDRX, OFFSET_EVENTS_TXDRDY, OFFSET_EVENTS_ENDTX, OFFSET_EVENTS_ERROR, OFFSET_EVENTS_ACQUIRED, OFFSET_EVENTS_RXTO,
+    OFFSET_EVENTS_RXSTARTED, OFFSET_EVENTS_TXSTARTED, OFFSET_EVENTS_TXSTOPPED
+))
+
+# 35.10.2 INTEN
+INTEN_EVENT_CTS = 1 << 0
+INTEN_EVENT_NCTS = 1 << 1
+INTEN_EVENT_RXDRDY = 1 << 2
+INTEN_EVENT_ENDRX = 1 << 4
+INTEN_EVENT_TXRDY = 1 << 7
+INTEN_EVENT_ENDTX = 1 << 8
+INTEN_EVENT_ERROR = 1 << 9
+INTEN_EVENT_RXTO = 1 << 17
+INTEN_EVENT_RXSTARTED = 1 << 19
+INTEN_EVENT_TXSTARTED = 1 << 20
+INTEN_EVENT_TXSTOPPED = 1 << 22
+
+MMIOREG_READ_CONSTS = {
+    OFFSET_EVENTS_CTS: 1, # always clear to send
+    OFFSET_EVENTS_NCTS: 0, # never "not clear to send"
+    OFFSET_EVENTS_ERROR: 0, # never errored
+    OFFSET_EVENTS_RXTO: 0, # never got interrupted without receiving everything
+}
+
+DEFAULT_IRQ_NUM = 0x48 // 4
+
+# TODOs:
+# - 35.10.1 SHORTS: Shortcutting events to new tasks (can explicitly stop after transmission or start new transmission). However, these only seem to apply in case we are not fast enough in transmitting data
+
+class SerialDMAC(Peripheral):
+    # Indication on whether we had an event coming in that wants an interrupt to be raised
+    interrupt_waiting: bool
+
+    _is_spis: bool
+    def __init__(self, name, addr, size, owned_irqs, emu, comm, ani, config, **kwargs):
+        if addr is None:
+            addr = DEFAULT_BASE_ADDR
+        if not owned_irqs:
+            owned_irqs = (DEFAULT_IRQ_NUM, )
+
+        # Configure device type (these may have subtle differences, e.g. SPIS semaphore)
+        device_type = config.get(CONFIG_NAME_DEVICE_TYPE, DEVICE_TYPE_UARTE).upper()
+        self._is_spis = device_type == DEVICE_TYPE_SPIS
+
+        self.interrupt_waiting = False
+
+        super().__init__(name, addr, size, owned_irqs, emu, comm, ani, config, kwargs=kwargs)
+
+    def startrx(self):
+        self.generate_event(OFFSET_EVENTS_RXSTARTED)
+        #self.generate_event(OFFSET_EVENTS_RXDRDY)
+
+        # start receive
+        dmabuf_size = self.emu.read_memory(self.address + OFFSET_RXD_MAXCNT, 4)
+
+        if dmabuf_size:
+            dmabuf_start = self.emu.read_memory(self.address + OFFSET_RXD_PTR, 4)
+            fuzzing_input = self.comm.get_bytes(dmabuf_size)
+            logger.info(f"[nrf52 SerialDMAC] DMA write to buf: {dmabuf_start:#x}, size: {dmabuf_size}, data {fuzzing_input}")
+            self.emu.write_memory(dmabuf_start, dmabuf_size, value=fuzzing_input, raw=True)
+
+            # Note: We need to perform the increment after the fuzzing input read
+            #       as this access might be the first one to consume fuzzing input.
+            if not self.inc_packet_count():
+                self.emu.stop()
+                return
+        else:
+            logger.warning(f"[nrf52 SerialDMAC] DMA write with length zero requested")
+
+        # Indicate the number of byte we wrote (all of the requested ones, in our case)
+        self.emu.write_memory(self.address + OFFSET_RXD_AMOUNT, 4, dmabuf_size)
+
+        # Generate the ENDRX event so that we know we can trigger an interrupt the next time we are asked to do so
+        self.generate_event(OFFSET_EVENTS_ENDRX)
+        if self._is_spis:
+            self.generate_event(OFFSET_EVENTS_END)
+
+    def generate_event(self, event_reg_off):
+        # Update event flag
+        self.set_event_reg(event_reg_off)
+        if self.is_event_interrupt_enbled(event_reg_off):
+            # print(f"Setting interrupt waiting while generating event {event_reg_off:x}", flush=True)
+            self.interrupt_waiting = True
+
+    def set_event_reg(self, reg_off, value=1):
+        self.emu.write_memory(self.address + reg_off, 4, value)
+
+    def get_event_reg(self, reg_off):
+        return self.emu.read_memory(self.address + reg_off, 4)
+
+    def is_event_set(self, event_off):
+        return self.get_event_reg(event_off) != 0
+
+    def is_event_interrupt_enbled(self, event_reg_off):
+        # The register offsets are organized in a way so that the register offset corresponds to a bit position
+        bitpos = (event_reg_off - 0x100) // 4
+        return (self.emu.read_memory(self.address + OFFSET_INTEN, 4) & (1<<bitpos)) != 0
+
+    def is_enabled(self):
+        # enable value depends on peripheral
+        # uarte: 8
+        # uart: 4
+        # spis: 2
+        # disabled is always at value 0
+        return self.emu.read_memory(self.address + OFFSET_ENABLE, 1) & 0xf != 0
+
+    #def timer_handler_trigger_irq(self):
+    #    self.emu.irq_pulse(self.owned_irqs[0])
+
+    def hw_read(self, offset, size):
+        if offset == MMIOREG_READ_CONSTS:
+            return MMIOREG_READ_CONSTS[offset]
+        elif offset in REG_OFFSETS:
+            # We handle the rest of the known registers in place in memory, so pass reads through
+            status = MMIO_HANDLE_RES_PASSTHROUGH
+            val = None
+        else:
+            # For other non DMA-related MMIO registers in the range, just forward to MMIO handling
+            status = MMIO_HANDLE_RES_FORWARD_TO_DEFAULT
+            val = None
+
+        # Fallback for not modifying what is already in RAM
+        return status, val
+
+    def can_pend_interrupt(self, irq_num):
+        # device must be enabled
+        # and an interrupt must be waiting to be triggered
+        #   - this means the interrupt must have been enabled (which is handled upon MMIO writes, however)
+
+        # not already set (TODO: would the actual device care about the firmware resetting the event?)
+        # and self.is_event_set(OFFSET_EVENTS_ENDRX) \
+
+        res = self.interrupt_waiting and self.is_enabled()
+
+        logger.debug(f"[can_pend_interrupt] self.interrupt_waiting={self.interrupt_waiting}, self.is_enabled()={self.is_enabled()}")
+
+        # Unset pending interrupts as we are now raising one
+        self.interrupt_waiting = False
+
+        return res
+
+    # MMIO write
+    def hw_write(self, offset, size, value):
+        if size != 4:
+            # TODO: do we need to handle this?
+            return
+
+        if offset == OFFSET_TASKS_STARTRX:
+            logger.debug(f"TASKS_STARTRX = {value:#010x}")
+            if not self.is_enabled():
+                logger.warning("[nrf52 SerialDMAC] Warning: STARTRX task received while disabled")
+                return
+
+            self.startrx()
+
+            # For an active implementation, we might want to set a timer to trigger an interrupt instead:
+            # self.emu.set_timer(DMA_READ_DELAY_BBS, self.timer_handler_trigger_irq, self)
+
+        elif offset == OFFSET_TASKS_FLUSHRX:
+            logger.debug(f"TASKS_FLUSHRX = {value:#010x}")
+
+            # If we are asked to flush, we immediately generate the ENDRX event
+            # also indicate that we have not transferred any more bytes
+            self.emu.write_memory(self.address + OFFSET_RXD_AMOUNT, 4, 0)
+            self.generate_event(OFFSET_EVENTS_ENDRX)
+            pass
+        elif offset == OFFSET_TASKS_STOPRX:
+            logger.debug(f"TASKS_STOPRX = {value:#010x}")
+
+            # stop receive
+            # Can ignore: always already transmitted
+            pass
+        elif offset == OFFSET_TASKS_STARTTX:
+            logger.debug(f"TASKS_STOPRX = {value:#010x}")
+
+            # start transmit
+            # We just generate all the events so we can trigger an interrupt next time around
+            self.generate_event(OFFSET_EVENTS_TXSTARTED)
+            self.generate_event(OFFSET_EVENTS_TXDRDY)
+            self.generate_event(OFFSET_EVENTS_ENDTX)
+            self.generate_event(OFFSET_EVENTS_TXSTOPPED)
+            pass
+        elif offset == OFFSET_TASKS_ACQUIRE:
+            if self._is_spis:
+                logger.debug(f"TASKS_ACQUIRE = {value:#010x}")
+
+                # acquire semaphore (used in SPIS)
+                # See "32.3 SPI slave operation" in https://infocenter.nordicsemi.com/pdf/nRF52832_PS_v1.1.pdf
+                self.generate_event(OFFSET_EVENTS_ACQUIRED)
+            pass
+        elif offset == OFFSET_TASKS_RELEASE:
+            if self._is_spis:
+                logger.debug(f"TASKS_RELEASE = {value:#010x}")
+
+                # release semaphore (used in SPIS)
+                # See "32.3 SPI slave operation" in https://infocenter.nordicsemi.com/pdf/nRF52832_PS_v1.1.pdf
+
+                # The firmware indicates that updated DMA addresses can be used. We trigger a transfer here
+                if not self.is_enabled():
+                    print("[nrf52 SerialDMAC] Warning: STARTRX task received while disabled", flush=True)
+                    return
+
+                self.startrx()
+            pass
+        elif offset == OFFSET_RXD_PTR:
+            logger.debug(f"RXD_PTR = {value:#010x}")
+
+            # Read DMA buffer address
+            # We evaluate this lazily once we are asked to transmit
+            pass
+        elif offset == OFFSET_RXD_MAXCNT:
+            logger.debug(f"RXD_MAXCNT = {value:#010x}")
+
+            # Read DMA buffer address
+            # We evaluate this lazily once we are asked to transmit
+            pass
+        elif offset == OFFSET_INTEN:
+            logger.debug(f"INTEN = {value:#010x}")
+
+            # Set enable/disable state for interrupts 
+            pass
+        elif offset == OFFSET_INTENSET:
+            logger.debug(f"INTENSET = {value:#010x}")
+
+            # add corresponding enable bits in INTEN
+            curr_inten = self.emu.read_memory(self.address + OFFSET_INTEN, 4)
+            self.emu.write_memory(self.address + OFFSET_INTEN, 4, curr_inten | value)
+        elif offset == OFFSET_INTENCLR:
+            logger.debug(f"INTENCLR = {value:#010x}")
+
+            # clear corresponding enable bits in INTEN
+            curr_inten = self.emu.read_memory(self.address + OFFSET_INTEN, 4)
+            self.emu.write_memory(self.address + OFFSET_INTEN, 4, curr_inten & ~value)
+        elif offset == OFFSET_ERRORSRC:
+            logger.debug(f"ERRORSRC = {value:#010x}")
+
+            # no errors here
+            pass
+        elif offset == OFFSET_ENABLE:
+            logger.debug(f"ENABLE = {value:#010x}")
+
+            # nothing to do here, value written to RAM
+            pass
+        elif offset == OFFSET_RXD_AMOUNT:
+            logger.debug(f"RXD_AMOUNT = {value:#010x}")
+
+            pass
+
+    def take_snapshot(self):
+        return super().take_snapshot()
