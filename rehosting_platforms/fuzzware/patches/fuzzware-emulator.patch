+    OFFSET_EVENTS_DEVMISS : 1 << 6,
+    OFFSET_EVENTS_RSSIEND : 1 << 7,
+    OFFSET_EVENTS_BCMATCH : 1 << 10,
+}
+
+# STATE MACHINE
+STATE_TURNED_OFF = 5 # -> DISABLED
+STATE_DISABLED = 0 # -> TXRU / -> RXRU
+STATE_TXRU = 9 # -> TXIDLE / -> TXDISABLE
+STATE_TXIDLE = 10 # ->TXRU / -> RXRU / -> TX / -> TXDISABLE
+STATE_TX = 11 # -> TX / -> TXIDLE / -> TXDISABLE
+STATE_TXDISABLE = 12 # -> DISABLED
+STATE_RXRU = 1 # -> RXIDLE / -> RXDISABLE
+STATE_RXIDLE = 2 # -> RX / -> RXDISABLE / -> TXRU / -> RXRU
+STATE_RX = 3 # -> RX / -> RXIDLE / -> RXDISABLE
+STATE_RXDISABLE = 4 # -> DISABLED
+
+# change to increase coverage in softdevice
+MMIOREG_READ_CONSTS = {
+    OFFSET_EVENTS_DEVMATCH: 0, # always address match
+    OFFSET_EVENTS_DEVMISS: 0, # never miss address
+    OFFSET_CRCSTATUS: 1 # for now set crc status to always ok
+}
+
+STATE_OFFSETS = frozenset((
+    OFFSET_TASKS_TXEN, OFFSET_TASKS_RXEN, OFFSET_TASKS_START, OFFSET_TASKS_STOP, OFFSET_TASKS_DISABLE, 
+    ))
+
+SHORTS_EVENTS = frozenset((
+    OFFSET_EVENTS_READY, OFFSET_EVENTS_END, OFFSET_EVENTS_DISABLED, OFFSET_EVENTS_ADDRESS
+    ))
+
+# TODO move constants to reg offsets to enhance fuzzing
+REG_OFFSETS = frozenset((
+    OFFSET_SHORTS, OFFSET_INTENSET, OFFSET_INTENCLR, OFFSET_RXMATCH, OFFSET_RXCRC, OFFSET_DAI, 
+    OFFSET_PACKETPTR, OFFSET_FREQUENCY, OFFSET_TXPOWER, OFFSET_MODE, OFFSET_PCNF0, OFFSET_PCNF1, OFFSET_BASE0, 
+    OFFSET_BASE1, OFFSET_PREFIX0, OFFSET_PREFIX1, OFFSET_TXADDRESS, OFFSET_RXADDRESSES, OFFSET_CRCCNF, OFFSET_CRCPOLY, 
+    OFFSET_CRCINIT, OFFSET_TIFS, OFFSET_RSSISAMPLE, OFFSET_STATE, OFFSET_DATAWHITEIV, OFFSET_BCC, OFFSET_DAB_0, 
+    OFFSET_DAB_1, OFFSET_DAB_2, OFFSET_DAB_3, OFFSET_DAB_4, OFFSET_DAB_5, OFFSET_DAB_6, OFFSET_DAB_7, OFFSET_DAP_0, 
+    OFFSET_DAP_1, OFFSET_DAP_2, OFFSET_DAP_3, OFFSET_DAP_4, OFFSET_DAP_5, OFFSET_DAP_6, OFFSET_DAP_7, OFFSET_DACNF, 
+    OFFSET_OVERRIDE_0, OFFSET_OVERRIDE_1, OFFSET_OVERRIDE_2, OFFSET_OVERRIDE_3, OFFSET_OVERRIDE_4, OFFSET_POWER, OFFSET_TEST
+    ))
+
+DEFAULT_IRQ_NUM = 0x11
+
+def debug(msg):
+    print("[DMA RADIO PERIPH]: " + msg, flush=True)
+    return
+
+#TODO change name
+class SerialDMAC(Peripheral):
+    # Indication on whether we had an event coming in that wants an interrupt to be raised
+    interrupt_waiting: bool
+    state: int
+    inten: int
+    buffered_packetptr: int #packet pointer is double buffered and may be updated while we use it
+    do_rssi: bool
+    do_bcc: bool
+    bitcounter: int
+    shortcut_queue: list
+    cleared_interrupt: bool
+    event_shortcutted: bool # if a radio event might lead to task we need to handle
+
+    def __init__(self, name, addr, size, owned_irqs, emu, comm, config=None, **kwargs):
+        if addr is None:
+            addr = DEFAULT_BASE_ADDR
+        if not owned_irqs:
+            owned_irqs = (DEFAULT_IRQ_NUM, )
+
+        super().__init__(name, addr, size, owned_irqs, emu, comm, config, kwargs=kwargs)
+        self.reset_peripheral()
+        self.state = STATE_DISABLED
+        self.cleared_interrupt = True
+        self.event_shortcutted = False
+
+        custom_protocol_config = config['protocol_config'] if 'protocol_config' in config else None
+
+    #def timer_handler_trigger_irq(self):
+    #    self.emu.irq_pulse(self.owned_irqs[0])
+    def on_interrupt_entry(self, irq_num):
+        # Unset pending interrupts as we are now raising one
+        self.interrupt_waiting = False
+
+
+    def can_pend_interrupt(self, irq_num):
+        # use this as a tick
+        # first see if any shortcutted tasks are waiting to be executed
+        
+        debug("[can_pend_interrupt] entering")
+        self.check_ppi()
+        self.update_state_machine(self.pop_shortcut())    
+        
+        # check if state changes OR we can receive/transmit
+        self.update_state_machine(NO_TASK)
+
+        
+        # now check if we have an interrupt waiting and are enabled
+        res = self.interrupt_waiting and self.state != STATE_TURNED_OFF
+
+
+        debug(f"[can_pend_interrupt] {res}")
+        return res     
+
+    def reset_peripheral(self):
+        """ When the peripheral is turned off the periph and its registers need to be reset """
+        # reset state vars
+        self.interrupt_waiting = False
+        self.inten = 0x0
+        self.do_rssi = False
+        self.do_bcc = False
+        self.bitcounter = 0
+        self.shortcut_queue = []
+        # reset periph values
+        for index in REG_OFFSETS:
+            if index == OFFSET_POWER:
+                self.emu.write_memory(self.address + index, 4, 1)
+            elif index == OFFSET_FREQUENCY:
+                self.emu.write_memory(self.address + index, 4, 1)
+            elif index == OFFSET_DATAWHITEIV:
+                self.emu.write_memory(self.address + index, 4, 1)
+            else:
+                self.emu.write_memory(self.address + index, 4, 0)
+
+        # reset events to 0
+        for index in range(0x100, 0x200, 4):
+            self.emu.write_memory(self.address + index, 4, 0)
+        # reset tasks
+        for index in range(0x0, 0x100, 4):
+            self.emu.write_memory(self.address + index, 4, 0)
+
+        return
+
+    def starttx(self):
+        """ transmit packets """
+        debug(f"[starttx] starting TX")
+        dmabuf_size = self.emu.read_memory(self.address + OFFSET_PCNF1, 4) & 0xff #;MAXLEN
+        debug(f"[starttx] Sending {dmabuf_size:#x} bytes") 
+        debug(f"[starttx] Sending data from: {self.buffered_packetptr:#x}") 
+        for i in range(0, dmabuf_size, 4):
+            debug(f"{int.from_bytes(self.emu.read_memory(self.buffered_packetptr + i, 4).to_bytes(4, 'little'), 'big'):x}")
+
+
+        debug(f"[starttx] Sending data from: {self.buffered_packetptr:#x}, data {self.emu.read_memory(self.buffered_packetptr, 4):#x}")
+        #debug(f"[starttx] Sending data from: {self.buffered_packetptr+ 4:#x}, data {self.emu.read_memory(self.buffered_packetptr+4, 4):#x}")
+
+
+        self.generate_event(OFFSET_EVENTS_ADDRESS)
+        self.generate_event(OFFSET_EVENTS_PAYLOAD)
+        self.generate_event(OFFSET_EVENTS_END)
+        return
+
+
+    def startrx(self):
+        """ Receive packets """
+        debug(f"[startrx] starting RX")
+        # received address event 
+        self.generate_event(OFFSET_EVENTS_ADDRESS)
+        # rx match to specify logical received address TODO randomize
+        self.emu.write_memory(self.address + OFFSET_RXMATCH, 4, self.get_logical_addresses()[0])
+        
+        # sanity check
+        if not self.buffered_packetptr:
+            return
+        # received payload event
+        self.generate_event(OFFSET_EVENTS_PAYLOAD)
+        # TODO get information for protocol encapsulation. For now just random data
+        debug(f"[startrx] PCNF1 {self.emu.read_memory(self.address + OFFSET_PCNF1, 4):#x}")
+        dmabuf_size = self.emu.read_memory(self.address + OFFSET_PCNF1, 4) & 0xff #;MAXLEN
+        packed = False
+        if dmabuf_size:
+            packed = False
+            fuzzing_input = self.comm.get_bytes(dmabuf_size)
+
+            #fuzzing_input = b'\x05\x22' + (dmabuf_size -2) * b'A' #alt b'\x03\x0c'
+            debug(f"[startrx] DMA write to buf: {self.buffered_packetptr:#x},size: {dmabuf_size:#x}, data: {fuzzing_input}")
+            print(f"[startrx] DMA write to buf: {self.buffered_packetptr:#x},size: {dmabuf_size:#x}, data: {binascii.hexlify(fuzzing_input)}", flush = True) #TODO delete
+            self.emu.write_memory(self.buffered_packetptr, dmabuf_size, fuzzing_input, raw = True)
+
+            globs.dma_state = {'buffer': self.buffered_packetptr, 'size': len(fuzzing_input), 'data':str(binascii.hexlify(fuzzing_input)), 'packed': packed}
+                    
+
+        # ignore crc for now
+        self.generate_event(OFFSET_EVENTS_END)
+
+        # rssi check
+        if self.do_rssi:
+            self.emu.write_memory(self.address + OFFSET_RSSISAMPLE, 4, self.comm.get_bytes(1) & 0x7f)
+            self.generate_event(OFFSET_EVENTS_RSSIEND)
+
+        # bc check:
+        if self.do_bcc:
+            bcc = self.emu.read_memory(self.address + OFFSET_BCC, 4)
+            if (self.bitcounter + dmabuf_size * 8) > bcc:
+                self.generate_event(OFFSET_EVENTS_BCMATCH)
+                # TODO when to reset bcc
+                # TODO one packet can trigger multiple BCMATCHEs in theory
+
+        return
+
+    def start_state_machine(self):
+        """ 'power on' the radio and start state machine """
+        self.state = STATE_DISABLED
+
+    def stop_state_machine(self):
+        """ 'power off' the radio and start state machine """
+        self.state = STATE_TURNED_OFF
+
+    def update_state_machine(self, task, in_shortcut = False):
+        """ Update the state machine after writes to tasks """
+        # 6.20.5
+        # "if a task is triggered from the wrong state, for example if
+        # the RXEN task is triggered from the RXDISABLE state, this may 
+        # lead to incorrect behaviour."
+        # --> for now only accept correct states
+        
+        # if radio is powered off do nothing
+        if self.state == STATE_TURNED_OFF or task == None:
+            return
+
+        short_queue_len = len(self.shortcut_queue)
+        if task == NO_TASK:
+            # check if we are in a 'self-changing' state
+            if self.state == STATE_TXRU:
+                self.state = STATE_TXIDLE
+                self.generate_event(OFFSET_EVENTS_READY)
+
+            elif self.state == STATE_RXRU:
+                self.state = STATE_RXIDLE
+                self.generate_event(OFFSET_EVENTS_READY)
+
+            elif self.state == STATE_TXDISABLE or self.state == STATE_RXDISABLE:
+                self.state = STATE_DISABLED
+                self.generate_event(OFFSET_EVENTS_DISABLED)
+
+            elif self.state == STATE_RX:
+                self.startrx() # change state depending on output
+                self.state = STATE_RXIDLE
+                # TODO right now we do receiving in one function
+                #       but actually there are many seperate events
+                #       whicht lead back to STATE_RX
+                #       We can trigger each of them separated in time
+
+            elif self.state == STATE_TX:
+                self.starttx() 
+                self.state = STATE_TXIDLE
+
+        elif task == OFFSET_TASKS_TXEN:
+            if self.state in [STATE_DISABLED]:
+                # 'major' change from nrf52
+                self.state = STATE_TXRU
+
+        elif task == OFFSET_TASKS_RXEN:
+            if self.state in [STATE_DISABLED]:
+                # 'major' change from nrf52
+                self.state = STATE_RXRU
+
+        elif task == OFFSET_TASKS_START:
+            if self.state == STATE_TXIDLE:
+                self.state = STATE_TX
+
+            elif self.state == STATE_RXIDLE:
+                self.state = STATE_RX
+                self.startrx() # TODO for testing increase speed
+                self.state = STATE_RXIDLE
+
+        elif task == OFFSET_TASKS_STOP:
+            if self.state == STATE_TX:
+                self.state = STATE_TXIDLE
+
+            elif self.state == STATE_RX:
+                self.state = STATE_RXIDLE
+
+        elif task == OFFSET_TASKS_DISABLE:
+            if self.state in [STATE_TXRU, STATE_TXIDLE, STATE_TX]:
+                self.state = STATE_TXDISABLE
+
+            elif self.state in [STATE_RXRU, STATE_RXIDLE, STATE_RX]:
+                self.state = STATE_RXDISABLE
+
+            elif self.state == STATE_DISABLED:
+                self.generate_event(OFFSET_EVENTS_DISABLED) # this can happen during a reset
+
+        # update the state register to reflect the current state
+        self.update_state_reg()
+
+        # if shortcut was added execute it, but only one to avoid infinite loops
+        if not in_shortcut and len(self.shortcut_queue) > short_queue_len:
+            # TODO which short the first one or the last added one
+            debug(f"[update_state_machine] directly executing shortcut {self.shortcut_queue[-1]:#x}")
+            self.update_state_machine(self.shortcut_queue.pop(-1), in_shortcut = True)
+
+        return
+
+    
+
+    def update_state_reg(self):
+        """ update the state register to reflect the current state """
+        debug(f"current_state = {self.state}")
+        self.emu.write_memory(self.address + OFFSET_STATE, 4, self.state)
+
+    def generate_event(self, event_reg_off):
+        """ create an event for an offset """
+        self.set_event_reg(event_reg_off)
+        debug(f"[generate_event] event = {event_reg_off:#x}, cuurent intenset: {self.inten:#x}")
+        if self.is_event_interrupt_enabled(event_reg_off):
+            debug(f"[generate_event] Setting interrupt waiting while generating event {event_reg_off:#x}")
+            self.interrupt_waiting = True
+
+        # check for shortcuts
+        if event_reg_off in SHORTS_EVENTS:
+            self.shortcut_event(event_reg_off)
+
+        # check if we need to handle a task generated by this event
+        if self.event_shortcutted:
+            self.handle_shortcut(event_reg_off)
+
+
+    def set_event_reg(self, reg_off, value=1):
+        """ Turn on (or off) an event """
+        self.emu.write_memory(self.address + reg_off, 4, value)
+
+    def get_event_reg(self, reg_off):
+        """ Get value of an event register """
+        return self.emu.read_memory(self.address + reg_off, 4)
+
+    def is_event_interrupt_enabled(self, event_reg_off):
+        """ Check if interrupt for a certain event is enabled """
+        bitpos = INTEN_SHIFT[event_reg_off]
+        return (self.inten & bitpos) != 0
+
+    def shortcut_event(self, event_reg_off):
+        """ execute shortcuts for given event if the exist """
+        if event_reg_off == OFFSET_EVENTS_DISABLED:
+            if self.is_shortcutted(SHORT_DISABLED_TXEN):
+                self.add_shortcut(OFFSET_TASKS_TXEN)
+            if self.is_shortcutted(SHORT_DISABLED_RXEN):
+                self.add_shortcut(OFFSET_TASKS_RXEN)
+            if self.is_shortcutted(SHORT_DISABLED_RSSISTOP):
+                self.do_rssi = False
+        elif event_reg_off == OFFSET_EVENTS_READY:
+            if self.is_shortcutted(SHORT_READY_START):
+                self.add_shortcut(OFFSET_TASKS_START)
+        elif event_reg_off == OFFSET_EVENTS_END:
+            if self.is_shortcutted(SHORT_END_DISABLE):
+                self.add_shortcut(OFFSET_TASKS_DISABLE)
+            if self.is_shortcutted(SHORT_END_START):
+                self.add_shortcut(OFFSET_TASKS_START)
+        elif event_reg_off == OFFSET_EVENTS_ADDRESS:
+            if self.is_shortcutted(SHORT_ADDRESS_RSSISTART):
+                self.do_rssi = True
+            if self.is_shortcutted(SHORT_ADDRESS_BCSTART):
+                self.do_bc = True
+        
+        # TODO do we update the state machine here or later (probably here?
+        return
+
+    def is_shortcutted(self, shortcut):
+        """ check if a shortcut is enabled """
+        debug(f"[is_shortcutted] short: {self.emu.read_memory(self.address + OFFSET_SHORTS, 4):#x}")
+        return (self.emu.read_memory(self.address + OFFSET_SHORTS, 4) & (1 << shortcut)) != 0
+
+    def add_shortcut(self, shortcut):
+        """ add a task to the shortcut queue, to be executed on next tick """
+        debug(f"[add_shortcut] adding {shortcut}")
+        self.shortcut_queue.append(shortcut)
+        return
+
+    def pop_shortcut(self):
+        """ return the first shortcut in the shortcut queue or None """
+        if len(self.shortcut_queue) == 0:
+            return None
+        
+        debug(f"[pop_shortcut] pooping {self.shortcut_queue[0]}")
+        return self.shortcut_queue.pop(0)
+
+    def get_logical_addresses(self):
+        """ return a list of all logical address indexes in use """
+        indices = []
+        existing_logical_addresses = self.emu.read_memory(self.address + OFFSET_RXADDRESSES, 4)
+        for i in range(8):
+            if (existing_logical_addresses > i) & 0x1:
+                indices.append(i)
+
+        return indices
+
+    def hw_read(self, offset, size):
+        debug(f"[hw_read] reading {size} bytes at {offset:#x}; value = {self.emu.read_memory(self.address + offset, size)}")
+        #TODO
+        if offset in MMIOREG_READ_CONSTS:
+            debug(f"[hw_read] returning {MMIOREG_READ_CONSTS[offset]}")
+            return MMIOREG_READ_CONSTS[offset]
+        elif offset in REG_OFFSETS: 
+            status = MMIO_HANDLE_RES_PASSTHROUGH
+            val = None
+        else:
+            # For other non DMA-related MMIO registers in the range, just forward to MMIO handling
+            status = MMIO_HANDLE_RES_PASSTHROUGH 
+            # quickfix to make evetns passthrough TODO evaluate again
+            val = None
+
+        # Fallback for not modifying what is already in RAM
+        return status, val
+
+    # MMIO write
+    def hw_write(self, offset, size, value):
+        debug(f"[hw_write] writing {size} bytes at {offset:#x} (data = {value:#x})")
+        if size != 4:
+            # TODO: do we need to handle this?
+            return
+
+        if offset in STATE_OFFSETS:
+            if value != 0:
+                debug(f"[hw_write] received a new task")
+                self.update_state_machine(offset)
+            # TODO what about rssi and bc tasks?
+
+        elif offset == OFFSET_POWER:
+            # ret
+            if value == 0 and self.state != STATE_TURNED_OFF:
+                self.stop_state_machine()
+                self.reset_peripheral()
+
+            elif value == 1 and self.state == STATE_TURNED_OFF:
+                self.start_state_machine()
+
+        elif offset == OFFSET_INTENSET:
+            self.inten = self.inten | value
+
+        elif offset == OFFSET_INTENCLR:
+            self.inten = self.inten & ~value
+
+        elif offset == OFFSET_PACKETPTR:
+            self.buffered_packetptr = value
+            pass
+        elif offset == OFFSET_TASKS_RSSISTART:
+            self.do_rssi = True
+        elif offset == OFFSET_TASKS_RSSISTOP:
+            self.do_rssi = False
+        elif offset == OFFSET_TASKS_BCSTART:
+            self.do_bc = True
+        elif offset == OFFSET_TASKS_BCSTOP:
+            self.do_bc = False
+
+
+
+
+    def take_snapshot(self):
+        return super().take_snapshot()
+
+    def parse_config(self, config: Dict):
+        super().parse_config(config)
+
+
+    ##########################################
+    ############ PPI FUNCTIONS ###############
+    ##########################################
+    def handle_shortcut(self, event_reg):
+        """
+            if a radio event leads to a new ppi task (for now only group en/disable)
+            we need to handle it.
+            TODO write to PPI here should trigger hw_write
+        """
+        # check which task we need to do
+        cur_chen = self.emu.read_memory(PPI_BASE_ADDR + OFFSET_PPI_CHEN, 4)
+        debug(f"[handle_shortcut] cur_chen before handling {cur_chen:#x}")
+        for index in range(0, 20): # we only need to check lower 20 channels
+            if (cur_chen >> index) & 1 == 0:
+                continue
+
+            cur_eep = self.emu.read_memory(PPI_BASE_ADDR + OFFSET_EEP_BASE + OFFSET * index, 4)
+            if not (cur_eep == self.address + event_reg):
+                #not the current event so we dont care
+                continue
+
+            # we only care if TEP or FORKTEP is a RADIO tasks 
+            cur_tep = self.emu.read_memory(PPI_BASE_ADDR + OFFSET_TEP_BASE + OFFSET * index, 4)
+            if cur_tep in range(PPI_BASE_ADDR, PPI_BASE_ADDR + 0x100):
+                self.handle_ppi_task(cur_tep)
+
+        cur_chen = self.emu.read_memory(PPI_BASE_ADDR + OFFSET_PPI_CHEN, 4)
+        debug(f"[handle_shortcut] cur_chen after handling {cur_chen:#x}")
+
+    def handle_ppi_task(self, task):
+        """ Handle the actual ppi task """
+        if task & 0b0100 == 1:
+            # disable
+            chan = ((task & 0xff) - 4) // 4
+            cur_chen = self.emu.read_memory(PPI_BASE_ADDR + OFFSET_PPI_CHEN, 4)
+            group_chans = self.emu.read_memory(PPI_BASE_ADDR + OFFSET_CHG + chan * 4, 4)
+            self.emu.write_memory(PPI_BASE_ADDR + OFFSET_PPI_CHEN, 4, cur_chen & ~group_chans)
+
+        else:
+            # enable
+            chan = (task & 0xff) // 4
+            cur_chen = self.emu.read_memory(PPI_BASE_ADDR + OFFSET_PPI_CHEN, 4)
+            group_chans = self.emu.read_memory(PPI_BASE_ADDR + OFFSET_CHG + chan * 4, 4)
+            self.emu.write_memory(PPI_BASE_ADDR + OFFSET_PPI_CHEN, 4, cur_chen | group_chans)
+
+
+    def check_ppi(self):
+        """ 
+            check if there are any activated ppi shortcuts with other peripherals
+            and  add the task to the shortcut list. also set the according event (?)
+        """
+        cur_chen = self.emu.read_memory(PPI_BASE_ADDR + OFFSET_PPI_CHEN, 4)
+        self.event_shortcutted = False
+
+        if cur_chen == 0:
+            return
+        
+        debug(f"[check_ppi] chur_chen = {cur_chen:#x}")
+        cur_shortcuts = len(self.shortcut_queue)
+        # check if the shortcut affects us
+        if cur_chen & 0xfffff:
+            # configurable channels
+            for index in range(0, 20):
+                if (cur_chen >> index) & 1 == 0:
+                    continue
+
+                cur_eep = self.emu.read_memory(PPI_BASE_ADDR + OFFSET_EEP_BASE + OFFSET * index, 4)
+
+                # we only care if TEP or FORKTEP is a RADIO tasks 
+                cur_tep = self.emu.read_memory(PPI_BASE_ADDR + OFFSET_TEP_BASE + OFFSET * index, 4)
+                
+                if cur_tep > self.address and cur_tep < self.address + self.size:
+                    self.add_shortcut(cur_tep - self.address)
+
+                if (cur_eep in range(self.address + 0x100, self.address + 0x200)
+                    and(cur_tep in range(PPI_BASE_ADDR, PPI_BASE_ADDR + 0x100) )):
+                    self.event_shortcutted = True
+
+        if len(self.shortcut_queue) > cur_shortcuts:
+            # already added tasks
+            # assume only one timer has gone off?
+            return
+
+        if cur_chen & 0xfff00000:
+            # predefined channels
+            if (cur_chen & 0x100000) >> 20:
+                self.add_shortcut(OFFSET_TASKS_TXEN)
+
+            if (cur_chen & 0x200000) >> 21:
+                self.add_shortcut(OFFSET_TASKS_RXEN)
+
+            if (cur_chen & 0x400000) >> 22:
+                self.add_shortcut(OFFSET_TASKS_DISABLE)
+
+            if (cur_chen & 0x10000000) >> 28:
+                self.add_shortcut(OFFSET_TASKS_TXEN)
+
+            if (cur_chen & 0x20000000) >> 29:
+                self.add_shortcut(OFFSET_TASKS_TXEN)
+
+        return
+    
