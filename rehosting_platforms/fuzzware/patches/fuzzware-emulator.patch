@@ -0,0 +1,786 @@
+# https://infocenter.nordicsemi.com/pdf/nRF52832_PS_v1.1.pdf
+from typing import Dict
+import binascii
+import logging
+
+from ..peripheral import Peripheral
+import fuzzware_harness.globs as globs
+from fuzzware_harness.peripherals.nordic.nrf52840_header import *
+from .. import MMIO_HANDLE_RES_PASSTHROUGH, MMIO_HANDLE_RES_FORWARD_TO_DEFAULT
+
+logger = logging.getLogger("DMA")
+#logger.setLevel(logging.WARNING)
+
+#TODO change name
+class RADIO(Peripheral):
+    # Indication on whether we had an event coming in that wants an interrupt to be raised
+    mode: int
+    interrupt_waiting: bool
+    state: int
+    inten: int
+    buffered_packetptr: int #packet pointer is double buffered and may be updated while we use it
+    do_rssi: bool
+    do_bcc: bool
+    bitcounter: int
+    shortcut_queue: list
+    cleared_interrupt: bool
+    event_shortcutted: bool # if a radio event might lead to task we need to handle
+    freeze_state: bool
+    
+
+    def __init__(self, name, addr, size, owned_irqs, emu, comm, ani, config=None, **kwargs):
+        logger.debug("INIT")
+        if addr is None:
+            addr = BASE_ADDR
+        if not owned_irqs:
+            owned_irqs = (DEFAULT_IRQ_NUM, )
+
+        super().__init__(name, addr, size, owned_irqs, emu, comm, ani, config, kwargs=kwargs)
+        self._reset_peripheral()
+        self.packets_placed = 0
+        self.cleared_interrupt = True
+        self.event_shortcutted = False
+        self.mode = MODE_BLE
+        self.freeze_state = False
+        self.parse_config(config)
+        self._set_state(STATE_DISABLED)
+
+        custom_protocol_config = config['protocol_config'] if 'protocol_config' in config else None
+
+    """ TODO should be removable
+    def _get_fuzz_bytes(self, n: int):
+        if self._ani:
+            pkt = self._ani.get_packet()
+            if pkt:
+                return pkt
+        
+        return self.comm.get_bytes(n)
+    """
+    """
+    def interrupt_pending_trigger(self, irq_num):
+        logger.debug(f"testing {irq_num}")
+        if irq_num == 22:
+            print(self.shortcut_queue)
+            self._check_ppi()
+            self._update_state_machine(self._pop_shortcut())
+            self._update_state_reg()
+    """
+
+    def parse_config(self, config):
+        self._packet_limit = config.get("packet_limit", 0xffffffff)
+
+    def on_interrupt_entry(self, irq_num):
+        # Unset pending interrupts as we are now raising one
+        logger.debug("[on_interrupt_entry] entering")
+        self.interrupt_waiting = False
+
+    def can_pend_interrupt(self, irq_num):
+        # use this as a tick
+        # first see if any shortcutted tasks are waiting to be executed
+        self.freeze_state = False
+        # do we want to enter if interrupt is waiting
+        logger.debug(f"can_pend_interrutp: {self.interrupt_waiting}")
+        if self.interrupt_waiting and self.state != STATE_TURNED_OFF:
+            return True
+        
+        logger.debug(f"[can_pend_interrupt] entering for {irq_num}")
+        self._check_ppi()
+        #logger.debug(self.shortcut_queue)
+        tmp_state = self.state
+        #while 1 == 1:
+        
+        self._update_state_machine(self._pop_shortcut())    
+        # check if state changes OR we can receive/transmit
+        logger.debug(f"[can_prend_interrupt] executing state machine with no task")
+        self._update_state_machine(NO_TASK)
+        self._update_state_reg()
+
+        while self.shortcut_queue and not self.freeze_state:
+            self._update_state_machine(self._pop_shortcut())    
+            # check if state changes OR we can receive/transmit
+            logger.debug(f"[can_prend_interrupt] executing state machine with no task")
+            self._update_state_machine(NO_TASK)
+            self._update_state_reg()
+        """
+        if tmp_state == self.state or self.interrupt_waiting:
+            break
+        tmp_state = self.state
+        """
+        
+        # now check if we have an interrupt waiting and are enabled
+        # TODO is the second clause necessary? interrupt still valid even if we are turned of  right?
+        # --> check doc
+        res = self.interrupt_waiting and self.state != STATE_TURNED_OFF
+
+
+        logger.debug(f"[can_pend_interrupt] {res}")
+        logger.debug(f"with state = {states[self.state]}")        
+        return res     
+
+    def _reset_peripheral(self):
+        """ When the peripheral is turned off the periph and its registers need to be reset """
+        # reset state vars
+        self.interrupt_waiting = False
+        self.inten = 0x0
+        self.do_rssi = False
+        self.do_bcc = False
+        self.bitcounter = 0
+        self.shortcut_queue = []
+        self.ppi_queue = []
+
+
+        # reset periph values
+        for index in REG_OFFSETS:
+            if index == OFFSET_POWER:
+                self.emu.write_memory(self.address + index, 4, 1)
+            elif index == OFFSET_FREQUENCY:
+                self.emu.write_memory(self.address + index, 4, 1)
+            elif index == OFFSET_DATAWHITEIV:
+                self.emu.write_memory(self.address + index, 4, 1)
+            elif index == OFFSET_MODECNF0:
+                self.emu.write_memory(self.address + index, 4, 1)
+            else:
+                self.emu.write_memory(self.address + index, 4, 0)
+
+        # reset events to 0
+        for index in range(0x100, 0x200, 4):
+            self.emu.write_memory(self.address + index, 4, 0)
+        # reset tasks
+        for index in range(0x0, 0x100, 4):
+            self.emu.write_memory(self.address + index, 4, 0)
+
+        return
+
+    def _starttx(self):
+        """ transmit packets """
+        logger.debug(f"[starttx] starting TX")
+        dmabuf_size = self.emu.read_memory(self.address + OFFSET_PCNF1, 4) & 0xff #;MAXLEN
+        memory= b'' 
+        for i in range(0, dmabuf_size, 4):
+            memory += self.emu.read_memory(self.buffered_packetptr + i, 4).to_bytes(4, "little")
+
+        logger.debug(f"[starttx] Sending data from: {self.buffered_packetptr:#x}, data {binascii.hexlify(memory)}")
+        print(f"[starttx] Sending data from: {self.buffered_packetptr:#x}, data {binascii.hexlify(memory)}")
+        if self.mode == MODE_BLE:
+            channel = self._get_channel(self._get_frequency())
+            self._on_transmission(memory, channel)
+
+        else:
+            self._on_transmission(memory)
+        self.log_dma_access(self.buffered_packetptr, len(memory), memory, 'tx', False)
+
+
+        if self.mode == MODE_BLE:
+            self._generate_event(OFFSET_EVENTS_ADDRESS)
+            self._generate_event(OFFSET_EVENTS_PAYLOAD)
+            self._generate_event(OFFSET_EVENTS_END)
+            self._generate_event(OFFSET_EVENTS_PHYEND)
+
+        if self.mode == MODE_IEEE802154:
+            self._generate_event(OFFSET_EVENTS_FRAMESTART)
+            self._generate_event(OFFSET_EVENTS_END)
+            self._generate_event(OFFSET_EVENTS_PHYEND)
+        
+        if self.state == STATE_TX:
+            self._set_state(STATE_TXIDLE) 
+        return
+
+    def _startrx(self):
+        """ Receive packets """
+        logger.debug(f"[startrx] starting RX")
+        if self.packets_placed > self.packet_limit:
+            logger.debug(f"[startrx] too many packets sent")
+            self.emu.exit()
+        # received address event
+        if self.mode == MODE_BLE: 
+            self._generate_event(OFFSET_EVENTS_ADDRESS)
+        
+        # rx match to specify logical received address TODO randomize
+        # does this ghold up? TODO
+        if not self._get_logical_addresses():
+            self.emu.write_memory(self.address + OFFSET_RXMATCH, 4, 0xffffffff)
+        else:
+            self.emu.write_memory(self.address + OFFSET_RXMATCH, 4, self._get_logical_addresses()[0])
+        
+        # sanity check
+        if not self.buffered_packetptr:
+            return
+
+        # received payload event
+        if self.mode == MODE_BLE:
+            self._generate_event(OFFSET_EVENTS_PAYLOAD)
+        # framestart and mhrmatch event
+        if self.mode == MODE_IEEE802154:
+            self._generate_event(OFFSET_EVENTS_FRAMESTART)
+            self._generate_event(OFFSET_EVENTS_MHRMATCH)
+        
+        # TODO get information for protocol encapsulation. For now just random data
+        logger.debug(f"[startrx] PCNF1 {self.emu.read_memory(self.address + OFFSET_PCNF1, 4):#x}")
+        dmabuf_size = self.emu.read_memory(self.address + OFFSET_PCNF1, 4) & 0xff #;MAXLEN
+        logger.debug(f"dmabuf size is {dmabuf_size:#x}")
+        cursor_start = self.comm.get_cursor()
+        packed = False
+        if dmabuf_size:
+            # get fuzzing input
+            if self.mode == MODE_IEEE802154:
+                fuzzing_input = self._get_fuzz_bytes(dmabuf_size)
+                #fuzzing_input = binascii.unhexlify(b'008063ffff0000ffcf000000208473656e736f720000ffffff00')
+            if self.mode == MODE_BLE:
+                fuzzing_input = self._get_fuzz_bytes(dmabuf_size)
+                #fuzzing_input = binascii.unhexlify(b'601e00c0a2758219c802010614094e6f726469635f554152545f5365727669636500000000000000')
+
+            logger.debug(f"[startrx] DMA write to buf: {self.buffered_packetptr:#x},size: {dmabuf_size:#x}, data: {fuzzing_input}")
+            self.packets_placed += 1
+            print(f"[startrx] DMA write to buf: {self.buffered_packetptr:#x},size: {dmabuf_size:#x}, data: {binascii.hexlify(fuzzing_input)}")
+            
+            # write bytes to memory and update the global state
+            self.emu.write_memory(self.buffered_packetptr, dmabuf_size, fuzzing_input, raw = True)
+            self.log_dma_access(self.buffered_packetptr, len(fuzzing_input), fuzzing_input, 'rx', False, cursor_start) # TODO: packed                     
+
+        # ignore crc for now
+        self._generate_event(OFFSET_EVENTS_CRCOK)
+        self._generate_event(OFFSET_EVENTS_END)
+
+        # rssi check
+        if self.do_rssi:
+            self.emu.write_memory(self.address + OFFSET_RSSISAMPLE, 4, int.from_bytes(self.comm.get_bytes(1), "big") & 0x7f)
+            self._generate_event(OFFSET_EVENTS_RSSIEND)
+
+        # bc check:
+        if self.do_bcc:
+            bcc = self.emu.read_memory(self.address + OFFSET_BCC, 4)
+            if (self.bitcounter + dmabuf_size * 8) > bcc:
+                self._generate_event(OFFSET_EVENTS_BCMATCH)
+                # TODO when to reset bcc
+                # TODO one packet can trigger multiple BCMATCHEs in theory
+        
+        if self.state == STATE_RX:
+            self._set_state(STATE_RXIDLE) 
+        return
+
+    def _start_state_machine(self):
+        """ 'power on' the radio and start state machine """
+        self._set_state(STATE_DISABLED)
+
+    def _stop_state_machine(self):
+        """ 'power off' the radio and start state machine """
+        self._set_state(STATE_TURNED_OFF)
+
+    def _update_state_machine(self, task, in_shortcut = False):
+        """ Update the state machine after writes to tasks """
+        # 6.20.5
+        # "if a task is triggered from the wrong state, for example if
+        # the RXEN task is triggered from the RXDISABLE state, this may 
+        # lead to incorrect behaviour."
+        # --> for now only accept correct states
+        
+        # if radio is powered off do nothing
+        logger.debug(f"[update_state_machine] state maching is in state {states[self.state]}; received taske {tasks[task]}; shorts are {self.emu.read_memory(self.address + OFFSET_SHORTS, 4):#x}")
+        if self.state == STATE_TURNED_OFF or task == None:
+            return
+
+        short_queue_len = len(self.shortcut_queue)
+        if task == NO_TASK:
+            # check if we are in a 'self-changing' state
+            if self.state == STATE_TXRU:
+                self._set_state(STATE_TXIDLE)
+                self._generate_event(OFFSET_EVENTS_READY)
+                self._generate_event(OFFSET_EVENTS_TXREADY)
+
+            elif self.state == STATE_RXRU:
+                self._set_state(STATE_RXIDLE)
+                self._generate_event(OFFSET_EVENTS_READY)
+                self._generate_event(OFFSET_EVENTS_RXREADY)
+
+            elif self.state == STATE_TXDISABLE or self.state == STATE_RXDISABLE:
+                self._set_state(STATE_DISABLED)
+                logger.debug("entry 1")
+                self._generate_event(OFFSET_EVENTS_DISABLED)
+
+            elif self.state == STATE_RX:      
+                self._startrx() # change state depending on output
+                #self._set_state(STATE_RXIDLE)
+                # TODO right now we do receiving in one function
+                #       but actually there are many seperate events
+                #       whicht lead back to STATE_RX
+                #       We can trigger each of them separated in time
+
+            elif self.state == STATE_TX:
