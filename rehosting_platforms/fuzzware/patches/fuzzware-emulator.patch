+                logger.debug(f"[debug_tx] TDESC0 = {self.emu.read_memory(next_tdesc_base, 4):#x}")
+                logger.debug(f"-------------------------------")
+                logger.debug(f"[debug_tx] TDESC1 = {self.emu.read_memory(next_tdesc_base + RDES1, 4):#x}")
+                logger.debug(f"-------------------------------")
+                logger.debug(f"[debug_tx] TDESC2 = {self.emu.read_memory(next_tdesc_base + RDES2, 4):#x}")
+                logger.debug(f"-------------------------------")
+                logger.debug(f"[debug_tx] TDESC3 = {self.emu.read_memory(next_tdesc_base + RDES3, 4):#x}")
+                logger.debug(f"--------------------------------------")
+                logger.debug(f"")
+                next_tdesc_base = self.emu.read_memory(next_tdesc_base + RDES3, 4)
diff --git a/harness/fuzzware_harness/peripherals/stm32/f446.py b/harness/fuzzware_harness/peripherals/stm32/f446.py
new file mode 100644
index 0000000..64b7ead
--- /dev/null
+++ b/harness/fuzzware_harness/peripherals/stm32/f446.py
@@ -0,0 +1,560 @@
+import logging
+from binascii import hexlify
+
+from ..peripheral import Peripheral
+from .. import MMIO_HANDLE_RES_PASSTHROUGH, MMIO_HANDLE_RES_FORWARD_TO_DEFAULT
+from typing import List
+
+logger = logging.getLogger("emulator")
+
+CONFIG_NAME_BASE_IRQ = "base_irq"
+
+""" STM32 F446xx Controller Implementation
+Reference Manual
+- https://www.st.com/resource/en/reference_manual/rm0390-stm32f446xx-advanced-armbased-32bit-mcus-stmicroelectronics.pdf
+- Implemented Section: 9 Direct Memory Access Controller
+
+Features (Implemented):
+- Circular Mode
+- Double Buffering
+
+Features (Hardware Details, ignored):
+- Flow Control (early stop)
+- Burst Modes
+- Hardware FIFO
+- Stream Priority
+- Error handling interrupts
+    - TEIFx
+    - FEIFx
+- Interrupt status <-> stream enabling interaction hardware error cases
+    - Not enforced: "MA transfer must be cleared before the stream can be re-enabled."
+- MINC: Memory address increment (This is only done if we do not want to write to a buffer, but a single field)
+"""
+
+""" Config entry in config.yml
+peripherals:
+  stm32f446_DMA1:
+    class: fuzzware_harness.peripherals.stm32.f446.DMAC
+    base_addr: 0x40026000
+    size: 0x100
+    irqs:
+        # DMA1_Stream0_IRQHandler
+        - 27
+        # DMA1_Stream1_IRQHandler
+        - 28
+        # DMA1_Stream2_IRQHandler
+        - 29
+        # DMA1_Stream3_IRQHandler
+        - 30
+        # DMA1_Stream4_IRQHandler
+        - 31
+        # DMA1_Stream5_IRQHandler
+        - 32
+        # DMA1_Stream6_IRQHandler
+        - 33
+        # DMA1_Stream7_IRQHandler
+        - 34
+  stm32f446_DMA2:
+    class: fuzzware_harness.peripherals.stm32.f446.DMAC
+    base_addr: 0x40026400
+    size: 0x100
+    irqs:
+        # DMA1_Stream1_IRQHandler
+        - 35
+        # DMA1_Stream1_IRQHandler
+        - 36
+        # DMA1_Stream2_IRQHandler
+        - 37
+        # DMA1_Stream3_IRQHandler
+        - 38
+        # DMA1_Stream4_IRQHandler
+        - 39
+        # DMA1_Stream5_IRQHandler
+        - 40
+        # DMA1_Stream6_IRQHandler
+        - 41
+        # DMA1_Stream7_IRQHandler
+        - 42
+"""
+
+DMA_LISR = 0x0  # DMA low interrupt status register
+DMA_HISR = 0x4  # DMA high interrupt status register
+DMA_LIFCR = 0x8 # DMA low interrupt flag clear register
+DMA_HIFCR = 0xc # DMA high interrupt flag clear register
+
+NUM_STREAMS = 8
+OFF_STREAM_REGS_BASE = 0x10
+STREAM_REGS_SIZE = 0x18
+
+# DMA stream x configuration register
+# Address offset: 0x010 + 0x018 * x, (x = 0 to 7)
+DMA_SxCR   = [0x010 + STREAM_REGS_SIZE * x for x in range(NUM_STREAMS)]
+# DMA stream x number of data register
+# Address offset: 0x014 + 0x018 * x, (x = 0 to 7)
+DMA_SxNDTR = [0x014 + STREAM_REGS_SIZE * x for x in range(NUM_STREAMS)]
+# DMA stream x peripheral address register
+# Address offset: 0x018 + 0x018 * x, (x = 0 to 7)
+DMA_SxPAR  = [0x018 + STREAM_REGS_SIZE * x for x in range(NUM_STREAMS)]
+# DMA stream x memory 0 address register
+# Address offset: 0x01C + 0x018 * x, (x = 0 to 7)
+DMA_SxM0AR = [0x01c + STREAM_REGS_SIZE * x for x in range(NUM_STREAMS)]
+# DMA stream x memory 1 address register
+# Address offset: 0x020 + 0x018 * x, (x = 0 to 7)
+DMA_SxM1AR = [0x020 + STREAM_REGS_SIZE * x for x in range(NUM_STREAMS)]
+# DMA stream x FIFO control register
+# Address offset: 0x024 + 0x018 * x, (x = 0 to 7)
+DMA_SxFCR  = [0x024 + STREAM_REGS_SIZE * x for x in range(NUM_STREAMS)]
+
+# Stream configuration register flags
+FLAG_EN     = 1       # Bit 0 EN: stream enable / flag stream ready when read low
+FLAG_TEIE   = 1 <<  1 # Bit 1 DMEIE: direct mode error interrupt enable
+FLAG_DMEIE  = 1 <<  2 # Bit 2 TEIE: transfer error interrupt enable
+FLAG_HTIE   = 1 <<  3 # Bit 3 HTIE: half transfer interrupt enable
+FLAG_TCIE   = 1 <<  4 # Bit 4 TCIE: transfer complete interrupt enable
+FLAG_PFCTRL = 1 <<  5 # Bit 5 PFCTRL: peripheral flow controller
+FLAG_CIRC   = 1 <<  8 # Bit 8 CIRC: circular mode
+FLAG_MINC   = 1 << 10 # Bit 10 MINC: memory increment mode
+
+SHIFT_DIR   = 6       # Bits 7:6 DIR[1:0]: data transfer direction
+MASK_DIR    = 0b11 << SHIFT_DIR
+SHIFT_PSIZE = 11    # Bits 12:11 PSIZE[1:0]: peripheral data size
+MASK_PSIZE  = 0b11 << SHIFT_PSIZE
+SHIFT_MSIZE = 13    # Bits 14:13 MSIZE[1:0]: memory data size
+MASK_MSIZE  = 0b11 << SHIFT_MSIZE
+
+DIR_P2M = 0b00 # 00: peripheral-to-memory
+DIR_M2P = 0b01 # 01: memory-to-peripheral
+DIR_M2M = 0b10 # 10: memory-to-memory
+
+# Interrupt Status flags
+# Bits 26, 20, 10, 4 HTIF[3:0]: stream x half transfer interrupt flag (x = 3 to 0)
+FLAG_HTIFx = 4
+# Bits 27, 21, 11, 5 TCIF[3:0]: stream x transfer complete interrupt flag (x = 3 to 0)
+FLAG_TCIFx = 5
+
+HTIF_FLAG_SHIFTS = {
+    0: 4,
+    1: 10,
+    2: 20,
+    3: 26
+}
+
+# FIFO control register flags
+FLAG_DBM  = 1 << 18 # Bit 18 DBM: double-buffer mode
+SHIFT_CT    = 19
+FLAG_CT   = 1 << SHIFT_CT # Bit 19 CT: current target (only in double-buffer mode)
+
+FLAG_DMDIS = 1 << 2 # Bit 2 DMDIS: direct mode disable
+
+
+# Ignored HW Config Flags
+# CHSEL, MBURST, PBURST, PL, PINCOS, PSIZE, PINC, MINC
+
+ITEM_SIZES = {
+    0: 1,
+    1: 2,
+    2: 4
+}
+
+DEFAULT_BASE_ADDR = 0x40026000
+DEFAULT_BASE_IRQ  = 27
+
+def describe_stream_config(config_val):
+    res  = f"enabled: {config_val & FLAG_EN == FLAG_EN}\n"
+    res += f"circ: {config_val & FLAG_CIRC == FLAG_CIRC}\n"
+    res += f"interrupts: half={config_val & FLAG_HTIE == FLAG_HTIE}, full={config_val & FLAG_TCIE == FLAG_TCIE}\n"
+    return res
+
+# Could make this a data class, but let's stay compatible
+class ChannelBaseConfig:
+    par: int
+    mars: List[int]
+    ndtr: int
+
+    def __init__(self, par, mar1, ndtr, mar2=0):
+        self.par = par
+        self.mars = [mar1, mar2]
+        self.ndtr = ndtr
+
+class DMAC(Peripheral):
+    # A copy of original transfer values used for reloading configs
+    chan_base_configs: List[ChannelBaseConfig]
+    stream_ids_in_half_complete_state: set
+
+    # Cached stream status register values (as parts may be auto-set by hw)
+    status_regs: List[int]
+
+    _base_irq: int
+
+    def __init__(self, name, addr, size, owned_irqs, emu, comm, config, **kwargs):
+        if addr is None:
+            addr = DEFAULT_BASE_ADDR
+        self._base_irq = config.get(CONFIG_NAME_BASE_IRQ, min(owned_irqs))
+        self.stream_ids_in_half_complete_state = set()
+        self.config_regs = NUM_STREAMS * [ 0 ]
+
+        super().__init__(name, addr, size, owned_irqs, emu, comm, config, kwargs=kwargs)
+
+        self.chan_base_configs =  [ChannelBaseConfig(0, 0, 0) for _ in range(NUM_STREAMS)]
+
+    def is_stream_ready(self, stream_no):
+        assert(stream_no < NUM_STREAMS)
+
+        # TODO: More checks to perform?
+        return self.config_regs[stream_no] & FLAG_EN == FLAG_EN
+
+    def can_pend_interrupt(self, irq_num) -> bool:
+        stream_no = irq_num - self._base_irq
+
+        # TODO: when interrupts are not used for transfer of ownership, take this as a question to trigger a write anyways in this
+        #       case we could perform the writes in the loop here for those channels that are enabled, but have the interrupt disabled
+
+        # TODO: This currently discards the situation where HALF complete is enabled,
+        #       but full complete interrupts are disabled (which should not really happen?)
+        res = stream_no in self.stream_ids_in_half_complete_state
+        if not res:
+            stream_config = self.config_regs[stream_no]
+            res = stream_config & FLAG_EN == FLAG_EN and \
+                    (stream_config & FLAG_TCIE == FLAG_TCIE or \
+                    stream_config & FLAG_HTIE == FLAG_HTIE)
+
+        # logger.debug(f"can_pend_interrupt({irq_num}) = {res}(config:\n {describe_stream_config(stream_config)})")
+        return res
+
+    def compute_interrupt_status_flag(self, stream_ind, is_half_complete=False):
+        flag_shift = HTIF_FLAG_SHIFTS[stream_ind % 4]
+        # LISR and HISR conveniently are adjacent
+        status_reg_offset = DMA_LISR + 4 * (stream_ind // 4)
+
+        if not is_half_complete:
+            flag_shift += 1
+
+        return status_reg_offset, 1 << flag_shift
+
+    def on_interrupt_entry(self, irq_num):
+        stream_ind = irq_num - self._base_irq
+        logger.debug(f"[STM32F446 DMA on_interrupt_entry] irq num: {irq_num} (stream ind: {stream_ind})")
+        stream_config = self.config_regs[stream_ind]
+        logger.debug(f"Config ({stream_config:#010x}): {describe_stream_config(stream_config)}")
+
+        if stream_config & FLAG_DBM:
+            mem_addr_ind = (stream_config & FLAG_CT) >> SHIFT_CT
+        else:
+            mem_addr_ind = 0
+
+        # DMA_SxM1AR is located next to DMA_SxM0AR
+        off_mem_addr_reg = DMA_SxM0AR[stream_ind] + 4 * mem_addr_ind
+        dma_buf_addr = self.read_mmio_reg(off_mem_addr_reg)
+        orig_transfer_count = self.read_mmio_reg(DMA_SxNDTR[stream_ind])
+        transfer_count = orig_transfer_count
+
+        reset_config  = stream_config & FLAG_CIRC
+        indicate_half_complete = False
+
+        perform_write = self.extract_dir(stream_config) == DIR_P2M
+        if stream_ind in self.stream_ids_in_half_complete_state:
+            # We are in the middle of a half complete -> complete transfer
+            logger.debug(f"[STM32F446 DMA on_interrupt_entry] in half completed state")
+            self.stream_ids_in_half_complete_state.discard(stream_ind)
+            pass
+        else:
+            # We are starting a new transfer
+            if stream_config & FLAG_HTIE:
+                # We need to transfer half
+                self.stream_ids_in_half_complete_state.add(stream_ind)
+                transfer_count //= 2
+                indicate_half_complete = True
+            else:
+                assert(stream_config & FLAG_TCIE)
+
+        # Disable stream if full completion is indicated
+        if not indicate_half_complete:
+            self.config_regs[stream_ind] = stream_config & ~FLAG_EN
+
+        # Update interrupt status register
+        interrupt_status_reg_off, flag_bit = self.compute_interrupt_status_flag(stream_ind, indicate_half_complete)
+        curr_isr_val = self.read_mmio_reg(interrupt_status_reg_off)
+        self.write_mmio_reg(interrupt_status_reg_off, curr_isr_val | flag_bit)
+
+        # Write DMA buffer contents
+        if perform_write:
+            if not indicate_half_complete:
+                if not self.inc_packet_count():
+                    # Raise value error to indicate ending
+                    self.emu.stop()
+                    return
+
+            msize = self.extract_msize(stream_config)
+            dma_write_len = ITEM_SIZES[msize] * transfer_count
+            logger.debug(f"[STM32F446 DMA] writing {dma_write_len:#x} bytes to {dma_buf_addr:#010x}:")
+            fuzz_bytes = self.comm.get_bytes(dma_write_len)
+            logger.debug(f"Contents: {fuzz_bytes[:8]} ({hexlify(fuzz_bytes[:8])})")
+            self.emu.write_memory(dma_buf_addr, len(fuzz_bytes), fuzz_bytes, raw=True)
+
+            if indicate_half_complete:
+                self.write_mmio_reg(off_mem_addr_reg, dma_buf_addr + dma_write_len)
+
+        # For fully completed
+        if reset_config:
+            self.reset_base_config(stream_ind)
+        else:
+            new_count_value = orig_transfer_count - transfer_count
+            self.write_mmio_reg(DMA_SxNDTR[stream_ind], new_count_value)
+
+        # Toggle memory pointer target bit
+        if stream_config & FLAG_DBM:
+            stream_config ^= FLAG_CT
+
+    def extract_msize(self, conf_reg):
+        return (conf_reg & MASK_MSIZE) >> SHIFT_MSIZE
+
+    def replace_msize(self, conf_reg, msize):
+        return (conf_reg & ~MASK_MSIZE) | (msize << SHIFT_MSIZE)
+
+    def extract_psize(self, conf_reg):
+        return (conf_reg & MASK_MSIZE) >> SHIFT_MSIZE
+
+    def replace_psize(self, conf_reg, psize):
+        return (conf_reg & ~MASK_PSIZE) | (psize << SHIFT_PSIZE)
+
+    def extract_dir(self, conf_reg):
+        return (conf_reg & MASK_DIR) >> SHIFT_DIR
+
+    def reset_base_config(self, stream_ind):
+        self.write_mmio_reg(DMA_SxNDTR[stream_ind], self.chan_base_configs[stream_ind].ndtr)
+        self.write_mmio_reg(DMA_SxPAR[stream_ind], self.chan_base_configs[stream_ind].par)
+        self.write_mmio_reg(DMA_SxM0AR[stream_ind], self.chan_base_configs[stream_ind].mars[0])
+        self.write_mmio_reg(DMA_SxM1AR[stream_ind], self.chan_base_configs[stream_ind].mars[1])
+
+    # MMIO read
+    def hw_read(self, offset, size):
+        if size != 4 or (offset % 4 != 0):
+            # The DMA registers have to be accessed by words (32 bits).
+            self.emu.stop()
+            return MMIO_HANDLE_RES_PASSTHROUGH, None
+
+        if offset == DMA_LISR:
+            # 9.5.1 DMA low interrupt status register (DMA_LISR)
+
+            # Value kept in memory, pass through
+            pass
+
+        elif offset == DMA_HISR:
+            # 9.5.2 DMA high interrupt status register (DMA_HISR)
+
+            # Value kept in memory, pass through
+            pass
+
+        elif offset == DMA_LIFCR:
+            # 9.5.3 DMA low interrupt flag clear register (DMA_LIFCR)
+
+            # Err: Write-only register
+            logger.debug(f"[STM32F446 DMA hw_read] ERR: LIFCR not writable")
+            self.emu.crash()
+            pass
+
+        elif offset == DMA_HIFCR:
+            # 9.5.4 DMA high interrupt flag clear register (DMA_HIFCR)
+
+            # Err: Write-only register
+            logger.debug(f"[STM32F446 DMA hw_read] ERR: HIFCR not writable")
+            self.emu.crash()
+            pass
+
+        elif offset in DMA_SxCR:
+            # 9.5.5 DMA stream x configuration register (DMA_SxCR)
+            stream_ind = DMA_SxCR.index(offset)
+
+            # Sync config MMIO register value
+            self.write_mmio_reg(offset, self.config_regs[stream_ind])
+
+        #elif offset in DMA_SxNDTR:
+        #    # 9.5.6 DMA stream x number of data register (DMA_SxNDTR)
+        #
+        #    # Value kept in memory, pass through
+        #    pass
+
+        #elif offset in DMA_SxPAR:
+        #    # 9.5.7 DMA stream x peripheral address register (DMA_SxPAR)
+        #
+        #    # Value kept in memory, pass through
+        #    pass
+
+        #elif offset in DMA_SxM0AR:
+        #    # 9.5.8 DMA stream x memory 0 address register (DMA_SxM0AR)
+        #
+        #    # Value kept in memory, pass through
+        #    pass
+
+        #elif offset in DMA_SxM1AR:
+        #    # 9.5.9 DMA stream x memory 1 address register (DMA_SxM1AR)
+        #
+        #    # Value kept in memory, pass through
+        #    pass
+
+        #elif offset in DMA_SxFCR:
+        #    # 9.5.10 DMA stream x FIFO control register (DMA_SxFCR)
+        #
+        #    # Value kept in memory, pass through
+        #    pass
+
+        # We handle the rest of the registers in place in memory, so pass reads through
+        status = MMIO_HANDLE_RES_PASSTHROUGH
+        val = None
+
+        logger.debug(f"[STM32F446 DMA] [{self.emu.read_register('pc'):x}] MMIO read [{self.address+offset:#010x}] = {self.read_mmio_reg(offset):#x}")
+        return status, val
+
+    # MMIO write
+    def hw_write(self, offset, size, value):
+        logger.debug(f"[STM32F446 DMA] MMIO write {self.address+offset:#010x} = {value:#x}")
+
+        if size != 4 or (offset % 4 != 0):
+            # The DMA registers have to be accessed by words (32 bits).
+            logger.debug(f"[STM32F446 DMA hw_write] ERR: address {self.address+offset:#010x} not aligned")
+            self.emu.crash()
+            return
+
+        if offset == DMA_LISR:
+            # 9.5.1 DMA low interrupt status register (DMA_LISR)
+
+            # Err: read-only register
+            logger.debug(f"[STM32F446 DMA hw_write] ERR: LISR not writable")
+            self.emu.crash()
+
+        elif offset == DMA_HISR:
+            # 9.5.2 DMA high interrupt status register (DMA_HISR)
+
+            # Err: read-only register
+            logger.debug(f"[STM32F446 DMA hw_write] ERR: HISR not writable")
+            self.emu.crash()
+
+        elif offset == DMA_LIFCR:
+            # 9.5.3 DMA low interrupt flag clear register (DMA_LIFCR)
+            curr_lisr = self.read_mmio_reg(DMA_LISR)
+
+            self.write_mmio_reg(DMA_LISR, curr_lisr & ~value)
+
+        elif offset == DMA_HIFCR:
+            # 9.5.4 DMA high interrupt flag clear register (DMA_HIFCR)
+            curr_hisr = self.read_mmio_reg(DMA_HISR)
+
+            self.write_mmio_reg(DMA_HISR, curr_hisr & ~value)
+
+        elif offset in DMA_SxCR:
+            # 9.5.5 DMA stream x configuration register (DMA_SxCR)
+            stream_ind = DMA_SxCR.index(offset)
+            curr_config = self.config_regs[stream_ind]
+            if curr_config & FLAG_EN:
+                # Can only change the enable interrupt-related status
+                if value & FLAG_EN:
+                    diff = value ^ curr_config
+                    allowed_diffs = FLAG_TCIE | FLAG_HTIE | FLAG_TEIE | FLAG_DMEIE | FLAG_EN
+                    forbidden_diffs = diff & ~allowed_diffs
+                    if forbidden_diffs:
+                        logger.error(f"[STM32F446 DMA] ERR: DMA stream already enabled (current: {curr_config:#010x}, new: {value:#010x})...")
+                        # At least make sure we are not "finishing" half-completed transfers
+                        self.stream_ids_in_half_complete_state.discard(stream_ind)
+                        self.emu.crash()
+                else:
+                    logger.warning(f"[STM32F446 DMA] WARN: DMA prematurely disabled...")
+                return
+
+            if value & FLAG_EN:
+                fcr = self.read_mmio_reg(DMA_SxFCR[stream_ind])
+                if fcr & FLAG_DMDIS == 0:
+                    # In direct mode, MSIZE is forced by hardware to the same value as PSIZE as soon as
+                    value = self.replace_msize(value, self.extract_psize(value))
+
+                if self.extract_dir(value) == 0b10:
+                    # Bit 5 PFCTRL: peripheral flow controller
+                    # When the memory-to-memory mode is selected (bits DIR[1:0]=10), then this bit is
+                    # automatically forced to 0 by hardware.
+                    value &= ~FLAG_PFCTRL
+
+                if value & FLAG_DBM:
+                    # Bit 8 CIRC: circular mode
+                    # It is automatically forced by hardware to 1 if the DBM bit is set, as soon as the stream is
+                    # enabled (EN = 1).
+                    value |= FLAG_CIRC
+
+                if value & FLAG_PFCTRL:
+                    # Bit 8 CIRC: circular mode
+                    # When the peripheral is the flow controller (bit PFCTRL = 1) and the stream is enabled
+                    # (EN = 1), then this bit is automatically forced by hardware to 0.
+                    value &= ~FLAG_CIRC
+
+                self.reset_base_config(stream_ind)
+
+            # We keep a separate copy of the status registers as we cannot modify the written value in-flight
+            # Synchronize (potentially modified) value to member
+            self.config_regs[stream_ind] = value
+
+        elif offset in DMA_SxNDTR:
+            # 9.5.6 DMA stream x number of data register (DMA_SxNDTR)
+            stream_ind = DMA_SxNDTR.index(offset)
+            curr_config = self.config_regs[stream_ind]
+            if curr_config & FLAG_EN:
+                #  Err: currently enabled. Cannot write
+                logger.error(f"[STM32F446 DMA] ERR: NDTR not writable while stream enabled")
+                self.emu.crash()
+                return
+
+            # Otherwise, pass write through
+            logger.debug(f"[STM32F446 DMA] NDTR[{stream_ind}] = {value}")
+            self.chan_base_configs[stream_ind].ndtr = value & 0xffff
+
+        elif offset in DMA_SxPAR:
+            # 9.5.7 DMA stream x peripheral address register (DMA_SxPAR)
+            stream_ind = DMA_SxPAR.index(offset)
+            curr_config = self.config_regs[stream_ind]
+            if curr_config & FLAG_EN:
+                #  Err: currently enabled. Cannot write
+                logger.error(f"[STM32F446 DMA] ERR: SxPAR not writable while stream enabled")
+                self.emu.crash()
+                return
+
+            # Otherwise, pass write through
+            logger.debug(f"[STM32F446 DMA] PAR[{stream_ind}] = {value:#010x}")
+            self.chan_base_configs[stream_ind].par = value
+
+        elif offset in DMA_SxM0AR:
+            # 9.5.8 DMA stream x memory 0 address register (DMA_SxM0AR)
+            stream_ind = DMA_SxM0AR.index(offset)
+            curr_config = self.config_regs[stream_ind]
+            if curr_config & FLAG_EN:
+                #  Err: currently enabled. Cannot write
+                logger.error(f"[STM32F446 DMA] ERR: SxM0AR not writable while stream enabled")
+                self.emu.crash()
+                return
+
+            # Otherwise, pass write through
+            logger.debug(f"[STM32F446 DMA] M0AR[{stream_ind}] = {value:#010x}")
+            self.chan_base_configs[stream_ind].mars[0] = value
+
+        elif offset in DMA_SxM1AR:
+            # 9.5.9 DMA stream x memory 1 address register (DMA_SxM1AR)
+            stream_ind = DMA_SxM1AR.index(offset)
+            curr_config = self.config_regs[stream_ind]
+            if curr_config & FLAG_EN:
+                #  Err: currently enabled. Cannot write
+                logger.error(f"[STM32F446 DMA] ERR: SxM1AR not writable while stream enabled")
+                self.emu.crash()
+                return
+
+            # Otherwise, pass write through
+            logger.debug(f"[STM32F446 DMA] M1AR[{stream_ind}] = {value:#010x}")
+            self.chan_base_configs[stream_ind].mars[1] = value
+
+        elif offset in DMA_SxFCR:
+            # 9.5.10 DMA stream x FIFO control register (DMA_SxFCR)
+            stream_ind = DMA_SxFCR.index(offset)
+            curr_config = self.config_regs[stream_ind]
+            if curr_config & FLAG_EN:
+                #  Err: currently enabled. Cannot write
+                logger.error(f"[STM32F446 DMA] ERR: DMA_SxFCR not writable while stream enabled")
+                self.emu.crash()
+                return
+
+            # Otherwise, pass write through
+            logger.debug(f"[STM32F446 DMA] DMA_SxFCR[{stream_ind}] = {value:#010x}")
