@@ -0,0 +1,101 @@
+# https://infocenter.nordicsemi.com/pdf/nRF51_RM_v3.0.pdf
+# Config:
+"""
+peripherals:
+  PPI:
+    class: fuzzware_harness.peripherals.nordic.nrf51_ppi.PPI
+    base_addr: 0x4001F000
+    size: 0x990
+"""
+
+from typing import Dict
+
+from ..peripheral import Peripheral
+from .. import MMIO_HANDLE_RES_PASSTHROUGH, MMIO_HANDLE_RES_FORWARD_TO_DEFAULT
+
+OFFSET_CHEN = 0x500
+OFFSET_CHENSET = 0x504
+OFFSET_CHENCLR = 0x508
+OFFSET_EEP_BASE = 0x510
+OFFSET_TEP_BASE = 0x514
+OFFSET = 0x8
+OFFSET_CHG = 0x800
+
+
+GROUPS = 4
+CHANNELS = 16
+
+CH_EN_OFFSETS = frozenset((
+    0x0, 0x8, 0x10, 0x18 
+    ))
+CH_DIS_OFFSETS = frozenset((
+    0x4, 0xc, 0x14, 0x1c
+    ))
+
+
+DEFAULT_BASE_ADDR = 0x4001F000
+def debug(msg):
+    # print("[DMA PPI PERIPH]: " + msg, flush=True)
+    return
+
+class PPI(Peripheral):
+
+    def __init__(self, name, addr, size, owned_irqs, emu, comm, config=None, **kwargs):
+        if addr is None:
+            addr = DEFAULT_BASE_ADDR
+
+        super().__init__(name, addr, size, owned_irqs, emu, comm, config, kwargs=kwargs)
+
+    #def timer_handler_trigger_irq(self):
+    #    self.emu.irq_pulse(self.owned_irqs[0])
+
+    def hw_read(self, offset, size):
+        debug(f"[hw_read] reading {size} bytes at {offset:#x}; value = {self.emu.read_memory(self.address + offset, size):#x}")
+        if offset == OFFSET_CHENSET:
+            return self.emu.read_memory(self.address + OFFSET_CHEN, size)
+
+        elif offset == OFFSET_CHENCLR:
+            return self.emu.read_memory(self.address + OFFSET_CHEN, size)
+        status = MMIO_HANDLE_RES_PASSTHROUGH
+        val = None
+
+        return status, val
+
+    # MMIO write
+    def hw_write(self, offset, size, value):
+        debug(f"[hw_write] writing {size} bytes at {offset:#x} (data = {value:#x})")
+        if size != 4:
+            # TODO: do we need to handle this?
+            return
+
+        elif offset == OFFSET_CHENSET:
+            cur_chen = self.emu.read_memory(self.address + OFFSET_CHEN, 4)
+            self.emu.write_memory(self.address + OFFSET_CHEN, 4, cur_chen | value)
+
+        elif offset == OFFSET_CHENCLR:
+            cur_chen = self.emu.read_memory(self.address + OFFSET_CHEN, 4)
+            self.emu.write_memory(self.address + OFFSET_CHEN, 4, cur_chen & ~value)
+        elif offset in CH_EN_OFFSETS:
+            # not sure if this is entirely as in hardware
+            # but simply write enabled channels in group to chen
+            cur_chen = self.emu.read_memory(self.address + OFFSET_CHEN, 4)
+            group_chans = self.emu.read_memory(self.address + OFFSET_CHG + offset, 4)
+            self.emu.write_memory(self.address + OFFSET_CHEN, 4, cur_chen | group_chans)
+        elif offset in CH_DIS_OFFSETS:
+            # not sure if this is entirely as in hardware
+            # but simply clear disabled channels from chen
+            cur_chen = self.emu.read_memory(self.address + OFFSET_CHEN, 4)
+            group_chans = self.emu.read_memory(self.address + OFFSET_CHG + offset, 4)
+            self.emu.write_memory(self.address + OFFSET_CHEN, 4, cur_chen & ~group_chans)
+
+
+
+
+
+    def take_snapshot(self):
+        return super().take_snapshot()
+
+    def parse_config(self, config: Dict):
+        super().parse_config(config)
+
+
