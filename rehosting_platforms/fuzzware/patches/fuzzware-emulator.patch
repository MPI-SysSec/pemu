index 0000000..dc092f5
--- /dev/null
+++ b/harness/fuzzware_harness/peripherals/nxp/lpc18xx.py
@@ -0,0 +1,297 @@
+from binascii import hexlify
+
+from ..peripheral import Peripheral
+from .. import MMIO_HANDLE_RES_PASSTHROUGH, MMIO_HANDLE_RES_FORWARD_TO_DEFAULT
+
+CONFIG_NAME_NUM_DMA_CHANNELS = "num_channels"
+
+""" NXP LPC18xx DMA Controller Implementation
+Data sheet: https://www.keil.com/dd/docs/datashts/nxp/lpc18xx/um10430.pdf
+
+This implementation keeps its state in MMIO memory and evaluates the current DMA configuration
+and interrupt state based on RAM contents within the MMIO range.
+
+This is why in this implementation, MMIO hw_read and hw_write handlers are mostly pass-throughs.
+
+An alternative way of implementing this functionality is pre-calculating DMA buffer configuration
+states and ownerships whenever MMIO writes are performed.
+"""
+
+""" Config entry in config.yml
+peripherals:
+  lpc18xx:
+    class: fuzzware_harness.peripherals.nxp.lpc18xx.GPDMA
+    base_addr: 0x40002000
+    size: 0x200
+    irqs:
+        # DMA_IRQHandler
+        - 19
+"""
+# allows for s-g dma --< out of scope for now maybe?
+
+INTSTAT = 0x0 #ro mark channel in which interrupt occured
+INTTCSTAT = 0x4 #ro what is terminal count?
+INTTCCLEAR = 0x8 #wo clears therminal count interrupt request
+INTERRSTAT = 0xc #ro status of error request 
+INTERRCLR = 0x10 #wo clears error interrupt requestsp
+RAWINTTCSTAT = 0x14 #ro dma channel requesting transfer complete pre maskin
+RAWINTERRSTAT = 0x18 #ro dma channel requesting transfer error interrupt pre maskin
+ENBLDCHNS = 0x1c #ro shows enabled dma channels
+SOFTBREQ = 0x20 #rw enables dma burst requests
+SOFTSREQ = 0x24 #rw enables single transfer requests
+SOFTLBREQ = 0x28 #rw enables last burst requests
+SOFTLSREQ = 0x2c #rw enables last single requests
+CONFIG = 0x30 #rw configures dma controller
+SYNC = 0x34 #rw en/disables synchronization logic
+
+SRCADDRx = [0x100, 0x120, 0x140, 0x160, 0x180, 0x1a0, 0x1c0, 0x1e0] #rw srcaddr
+DESTADDRx = [0x104, 0x124, 0x144, 0x164, 0x184, 0x1a4, 0x1c4, 0x1e4] #rw destaddr
+LLIx = [0x108, 0x128, 0x148, 0x168, 0x188, 0x1a8, 0x1c8, 0x1e08] #rw next lli item
+CONTROLx = [0x10c, 0x12c, 0x14c, 0x16c, 0x18c, 0x1ac, 0x1cc, 0x1ec] #rw control inforamtion
+CONFIGx = [0x110, 0x130, 0x150, 0x170, 0x190, 0x1b0, 0x1d0, 0x1f0] #rw(!) configure channel
+
+TRANSFERSIZE_MASK = 0xfff
+SWIDTH_MASK = 0x1c0000
+ENABLE_MASK = 0x01
+DINC_MASK = 1 << 27 #source increment
+P2E_MASK_1 = 0x5
+P2E_MASK_2 = 0x6
+M2M_MASK = 0x0
+
+IE = 1 << 14
+ITC = 1 << 15
+INTERRUPTS_ENABLED_MASK = IE | ITC
+
+SWIDTH_MASK_SHIFT = 18
+DINC_MASK_SHIFT = 27
+
+
+                    
+
+ITEM_SIZES = {
+    0: 1,
+    1: 2,
+    2: 4
+}
+
+DEFAULT_BASE_ADDR = 0x40002000
+
+DEFAULT_NUM_CHANNELS = 8
+class GPDMA(Peripheral):
+    _num_channels: int
+
+    def __init__(self, name, addr, size, owned_irqs, emu, comm, config=None, **kwargs):
+        if addr is None:
+            addr = DEFAULT_BASE_ADDR
+
+        super().__init__(name, addr, size, owned_irqs, emu, comm, config, kwargs=kwargs)
+
+        self._num_channels = config.get(CONFIG_NAME_NUM_DMA_CHANNELS, DEFAULT_NUM_CHANNELS)
+
+    def debug(self, message):
+        print(f"[LPC18xx GPDMA] {message}", flush = True)
+        return
+
+    def get_dma_buf(self, channel_ind):
+        """
+        For a given index, get start address and size of a DMA buffer.
+
+        We use this to prepare DMA buffer writes
+
+        @return: (start, size)
+        """
+        start = self.emu.read_memory(self.address + DESTADDRx[channel_ind], 4)
+        memsize = (self.emu.read_memory(self.address + CONTROLx[channel_ind], 4) & SWIDTH_MASK) >> SWIDTH_MASK_SHIFT
+        transfersize = self.emu.read_memory(self.address + CONTROLx[channel_ind], 2) & TRANSFERSIZE_MASK
+
+        if memsize == 1:
+            multiplier = 2
+            start &= ~0b01
+        if memsize == 2:
+            multiplier = 4
+            start &= ~0b11
+
+        return start, transfersize * multiplier
+
+    def can_pend_interrupt(self, irq_num):
+        # We only own one interrupt, so don't even check irq_num
+
+        # TODO: when interrupts are not used for transfer of ownership, take this as a question to trigger a write anyways in this
+        #       case we could perform the writes in the loop here for those channels that are enabled, but have the interrupt disabled
+
+        return len(self.get_live_dma_channels()) != 0
+
+    def on_interrupt_entry(self, num_irq):
+        self.debug(f"irq num: {num_irq}")
+
+        if not self.inc_packet_count():
+            # Raise value error to indicate ending
+            self.emu.stop()
+            return
+
+        curr_isr_val = self.emu.read_memory(self.address + INTSTAT, 4)
+        self.debug(f"ISR val @ interrupt start = {curr_isr_val:#x}")
+        curr_inttcstat_val = self.emu.read_memory(self.address + INTTCSTAT, 4)
+        curr_rawinttcstat_val = self.emu.read_memory(self.address + RAWINTTCSTAT, 4)
+        for i, dma_buf_addr, dma_buf_len in self.get_live_dma_channels():
+            fuzz_bytes = self.comm.get_bytes(dma_buf_len)
+            #self.debug(f"[on_interrupt_activation] dma_buf_addr: {dma_buf_addr:#x}, dma_buf_len: {dma_buf_len:#x}. Writing contents: {hexlify(fuzz_bytes)}")
+            #print(f"[on_interrupt_activation] dma_buf_addr: {dma_buf_addr:#x}, dma_buf_len: {dma_buf_len:#x}. Writing contents: {hexlify(fuzz_bytes)}", flush = True)
+            self.emu.write_memory(dma_buf_addr, len(fuzz_bytes), fuzz_bytes, raw=True)
+
+            # increment DMA pointer register according to the MINC flag in the channel's config
+            config_val = self.get_config_val(i)
+            if self.get_minc(config_val):
+                self.emu.write_memory(self.address + DESTADDRx[i], 4, dma_buf_addr + dma_buf_len)
+
+            # feed new DMA status into ISR (to not accidentally trigger another interrupt too early)
+            curr_isr_val |= (0b1 << i)
+            curr_inttcstat_val |= (0b1 << i)
+            curr_rawinttcstat_val |= (0b1 << i)
+
+        self.debug(f"ISR val @ interrupt end = {curr_isr_val:#x}")
+        self.emu.write_memory(self.address + RAWINTTCSTAT, 4, curr_rawinttcstat_val)
+        self.emu.write_memory(self.address + INTSTAT, 4, curr_inttcstat_val)
+        self.emu.write_memory(self.address + INTTCSTAT, 4, curr_isr_val)
+
+    def get_config_val(self, channel_ind):
+        return self.emu.read_memory(self.address + CONFIGx[channel_ind], 4)
+
+    def get_control_val(self, channel_ind):
+        return self.emu.read_memory(self.address + CONTROLx[channel_ind], 4)
+    
+    def channel_interrupt_already_triggered(self, isr_val, channel_ind):
+        return ((isr_val >> channel_ind) & 0x1) != 0
+
+    def interrupts_enabled(self, config_val):
+        # This is an approximation: If we are allowed to raise any 
+        # interrupts indicating progress, we will.
+        # TODO returns 1 if error interrupt allowed, but not the second one
+        return config_val & INTERRUPTS_ENABLED_MASK != 0
+
+    def channel_enabled(self, config_val):
+        return config_val & ENABLE_MASK
+
+    def controller_enabled(self):
+        return self.emu.read_memory(self.address + CONFIG) & 0x1 
+
+    def get_number_of_data(self, channel_ind):
+        return self.emu.read_memory(self.address + CONTROLx[channel_ind], 2) & TRANSFERSIZE_MASK
+
+    def is_to_mem_direction(self, config_val):
+        return (config_val & M2M_MASK == M2M_MASK) | (config_val & P2E_MASK_1 == P2E_MASK_1) | (config_val & P2E_MASK_2 == P2E_MASK_2)
+
+    def get_is_mem_to_mem(self, config_val):
+        return config_val & M2M_MASK != 0
+
+    def get_item_size(self, channel_ind):
+        memsize = (self.emu.read_memory(self.address + CONTROLx[channel_ind], 4) & SWIDTH_MASK) >> SWIDTH_MASK_SHIFT
+
+        if memsize not in ITEM_SIZES:
+            self.emu.crash()
+            return 1
+
+        return ITEM_SIZES[memsize]
+
+    def get_dma_buf_addr(self, channel_ind):
+        return self.emu.read_memory(self.address + DESTADDRx[channel_ind], 4)
+
+    def get_minc(self, control_val):
+        return control_val & DINC_MASK == DINC_MASK
+
+    def get_isr(self):
+        return self.emu.read_memory(self.address + INTSTAT, 4)
+
+    def get_live_dma_channels(self):
+        # TODO perf: make this a generator? cache highest-used enabled channel index?
+
+        # Evaluate all the different flags and configs to figure out which buffers can be written to
+        # 1. Ownership
+        # 2. Enable Flag
+        # 3. Data Item Count
+        # 4. Data Direction
+
+        result = []
+
+        # isr_val = self.emu.read_memory(self.address + DMA_ISR, 4)
+        isr_val = self.get_isr()
+        for i in range(self._num_channels):
+            config_val = self.get_config_val(i)
+            is_owned = self.interrupts_enabled(config_val) and not self.channel_interrupt_already_triggered(isr_val, i)
+            is_enabled = self.channel_enabled(config_val)
+            item_count = self.get_number_of_data(i)
+            is_to_mem_data_direction = self.is_to_mem_direction(config_val)
+            is_mem_to_mem = self.get_is_mem_to_mem(config_val)
+            
+            # TODO why no is_mem_to_mem
+            if is_owned and is_enabled and item_count != 0 and is_to_mem_data_direction and not is_mem_to_mem:
+                item_size = self.get_item_size(i)
+                base_addr = self.get_dma_buf_addr(i)
+                result.append((i, base_addr, item_count * item_size))
+
+        return result
+
+    # MMIO read
+    def hw_read(self, offset, size):
+        self.debug(f"Registered hw read: address {(self.address + offset):#x}")
+        if offset == INTSTAT: 
+            intstat_val = self.emu.read_memory(self.address + INTSTAT, 4)
+            self.debug(f"INTSTAT val = {intstat_val:#x}")
+            return intstat_val
+        # We handle the rest of the registers in place in memory, so pass reads through
+        status = MMIO_HANDLE_RES_PASSTHROUGH
+        #status = MMIO_HANDLE_RES_FORWARD_TO_DEFAULT
+        val = None
+
+        return status, val
+
+    # MMIO write
+    def hw_write(self, offset, size, value):
+        self.debug(f"Registered hw write: address = {(self.address + offset):#x}, value = {value:#x}")
+        if offset == INTSTAT: 
+            pass
+        if offset == INTTCSTAT: 
+            pass
+        if offset == INTTCCLEAR:
+            # 17.6.3 clears INTTCSTAT bits
+            self.emu.write_memory(self.address + INTTCSTAT, 4, (self.emu.read_memory(self.address + INTTCSTAT, 4) & ((value & 0xff) ^ 0xff)))
+            # update intstat
+            self.emu.write_memory(self.address + INTSTAT, 4, (self.emu.read_memory(self.address + INTTCSTAT, 4) | self.emu.read_memory(self.address + INTERRSTAT, 4)))
+
+        if offset == INTERRSTAT: 
+            pass
+        if offset == INTERRCLR: 
+            # 17.6.5 clears INTERRSTAT bits
+            self.emu.write_memory(self.address + INTERRSTAT, 4, (self.emu.read_memory(self.address + INTERRSTAT, 4) & ((value & 0xff) ^ 0xff)))
+            # update intstat
+            self.emu.write_memory(self.address + INTSTAT, 4, (self.emu.read_memory(self.address + INTTCSTAT, 4) | self.emu.read_memory(self.address + INTERRSTAT, 4)))
+
+        if offset == RAWINTTCSTAT: 
+            pass
+        if offset == RAWINTERRSTAT: 
+            pass
+        if offset == ENBLDCHNS:
+            pass
+        if offset == SOFTBREQ:
+            pass
+        if offset == SOFTSREQ:
+            pass
+        if offset == SOFTLBREQ:
+            pass
+        if offset == SOFTLSREQ:
+            pass
+        if offset == CONFIG:
+            pass
+        if offset == SYNC:
+            pass
+        if offset == SRCADDRx: 
+            pass
+        if offset == DESTADDRx: 
+            pass
+        if offset == LLIx: 
+            pass
+        if offset == CONTROLx:
+            pass
+        if offset == CONFIGx:
+            pass
+
