+OFFSET_DAP_0 = 0x620 #Device address prefix = 0
+OFFSET_DAP_1 = 0x624 #Device address prefix 1
+OFFSET_DAP_2 = 0x628 #Device address prefix 2
+OFFSET_DAP_3 = 0x62C #Device address prefix 3
+OFFSET_DAP_4 = 0x630 #Device address prefix 4
+OFFSET_DAP_5 = 0x634 #Device address prefix 5
+OFFSET_DAP_6 = 0x638 #Device address prefix 6
+OFFSET_DAP_7 = 0x63C #Device address prefix 7
