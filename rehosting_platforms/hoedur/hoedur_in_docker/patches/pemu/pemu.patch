+    size: 1
+    doc: TxPower level field
+
+  # TODO
+  ACAD:
+    type: conditional
+    size: 0 
+    doc: Remainder of header is filled by additional controller advertising data.
+
+body:
+  size: fuzzed
+  max: 31
