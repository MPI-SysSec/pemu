diff --git a/emulator/src/hooks/pemu/cc2538.rs b/emulator/src/hooks/pemu/cc2538.rs
new file mode 100644
index 0000000..395b059
--- /dev/null
+++ b/emulator/src/hooks/pemu/cc2538.rs
@@ -0,0 +1,115 @@
+use crate::hooks::pemu::common::{
+    read_area_bytes, read_mmio, read_word, to_hex_string, write_area_bytes, write_word,
+};
+use common::hashbrown::HashMap;
+
+//const STRUCT_START: u32 = 0x20000030;
+const RF_DATA_REG: u32 = 0x40088828;
+//const STATUS_OFFSET: u32 = 0x8;
+const CONTROL_OFFSET: u32 = 0x8;
+//const LEN: u32 = 0x80;
+//const TX_STRUCT_START: u32 = 0x20000020;
+const DMA_BASE: u32 = 0x400ff000;
+const DMA_STRUCT_BASE: u32 = 0x400ff008;
+const DMA_STRUCT_MAX_SIZE: u32 = 0x3f0;
+const DMA_STRUCT_ENTRY_SIZE: u32 = 0x10;
+//const RADIO_TX_OFFSET: u32 = 0x20;
+//const RADIO_RX_OFFSET: u32 = 0x30;
+
+pub fn cc2538_is_store_mmio(address: u32) -> bool {
+    if address >= DMA_BASE && address < DMA_BASE + 0x1000 {
+        return true;
+    }
+    return false;
+}
+
+pub fn pemu_place_packet(mmio_writes: &mut HashMap<u32, u32>, address: u32, packet: Vec<u8>) {
+    //println!("Pemu place packet: {:#0x}", address);
+    if packet.len() < 2 {
+        return;
+    }
+    let packet_wo_size = Vec::from(&packet[1..]);
+    let hex_packet: String = to_hex_string(&packet_wo_size);
+
+    //println!("Writing packet: {}", hex_packet);
+    write_area_bytes(address, packet_wo_size);
+}
+
+// The problem is the read function reads the size from a mmio register
+// and THEN configures the reception.
+// We can add a mmio model that always returns max size, then we dont need to hook a second mmio region?
+// We need to find the place in time AFTER the reception is configured
+// ON udma_channel_get_mode!!!!
+// TODO some init that automatically adds this model
+pub fn pemu_cc2538_receive(mmio_writes: &mut HashMap<u32, u32>) -> (u32, u32, u32) {
+    //println!("[Receive] enter");
+    let rx_struct = find_rx_descriptor(mmio_writes);
+    if let Some(rx_struct_base) = rx_struct {
+        let control_word = read_word(rx_struct_base + CONTROL_OFFSET);
+        let packet_len = (control_word >> 4) & 0x1ff;
+        let rx_ptr = read_word(rx_struct_base + 4) - packet_len;
+        //println!("[Receive] exit 1");
+        return (1, rx_ptr, packet_len);
+    }
+    let buf_addr: u32 = 0;
+    let send_packet: u32 = 0;
+    let buf_size: u32 = 0;
+    //println!("[Receive] exit 2");
+    return (send_packet, buf_addr, buf_size);
+}
+
+pub fn pemu_cc2538_post_receive(mmio_writes: &mut HashMap<u32, u32>) {
+    // We need to remove the first byte from the buffer and move it to mmio
+    // Then shift everything else leftwards by 1
+    //println!("[Post-Receive] enter");
+    let rx_struct = find_rx_descriptor(mmio_writes);
+    if let Some(rx_struct_base) = rx_struct {
+        let status = read_word(rx_struct_base + CONTROL_OFFSET);
+        write_word(rx_struct_base + CONTROL_OFFSET, status & 0xfffffff8);
+    }
+}
+
+pub fn pemu_cc2538_transmit(mmio_writes: &mut HashMap<u32, u32>) -> (Vec<u8>, i32) {
+    //println!("[Tansmit] enter");
+    let tx_struct = find_tx_descriptor(mmio_writes);
+    if let Some(tx_struct_base) = tx_struct {
+        //println!("[Transmit] got tx struct {:#0x}", tx_struct_base);
+
+        let control_word = read_word(tx_struct_base + CONTROL_OFFSET);
+        let packet_len = (control_word >> 4) & 0x1ff;
+        let tx_ptr = read_word(tx_struct_base) - packet_len;
+        let packet = read_area_bytes(tx_ptr, packet_len);
+        //println!("Packetlength: {:#0x} :: {}", packet_len, to_hex_string(&packet));
+        //println!("[Tansmit] exit 1");
+        return (packet, -1);
+    }
+    //println!("[Tansmit] exit 2");
+
+    (vec![], -1)
+}
+
+fn find_rx_descriptor(mmio_writes: &mut HashMap<u32, u32>) -> Option<u32> {
+    let dma_struct_base = read_mmio(DMA_STRUCT_BASE, mmio_writes);
+    for i in (0..DMA_STRUCT_MAX_SIZE).step_by(DMA_STRUCT_ENTRY_SIZE as usize) {
+        let source = read_word(dma_struct_base + i);
+        if source == RF_DATA_REG {
+            return Some(dma_struct_base + i);
+        }
+    }
+    None
+}
+
+fn find_tx_descriptor(mmio_writes: &mut HashMap<u32, u32>) -> Option<u32> {
+    let dma_struct_base = read_mmio(DMA_STRUCT_BASE, mmio_writes);
+    if dma_struct_base == 0 {
+        return None;
+    }
+    //println!("[find_tx_descriptor] got base addr: {}", dma_struct_base);
+    for i in (0..DMA_STRUCT_MAX_SIZE).step_by(DMA_STRUCT_ENTRY_SIZE as usize) {
+        let destination = read_word(dma_struct_base + i + 4);
+        if destination == RF_DATA_REG {
+            return Some(dma_struct_base + i);
+        }
+    }
+    None
+}
diff --git a/emulator/src/hooks/pemu/common.rs b/emulator/src/hooks/pemu/common.rs
new file mode 100644
index 0000000..8a34d33
--- /dev/null
+++ b/emulator/src/hooks/pemu/common.rs
@@ -0,0 +1,123 @@
+use crate::hooks::custom;
+use common::hashbrown::HashMap;
+use qemu_rs::{qcontrol, Address, Register};
+
+pub fn to_hex_string(bytes: &[u8]) -> String {
+    bytes.iter().map(|byte| format!("{:02x}", byte)).collect()
+}
+
+pub fn get_register(reg: Register) -> u32 {
+    qcontrol().register(reg)
+}
+
+pub fn read_mmio(addr: Address, mmio_writes: &mut HashMap<u32, u32>) -> u32 {
+    let mut res: u32 = 0;
+    if let Some(val) = mmio_writes.get(&addr) {
+        res = *val;
+    };
+    //println!("[DEBUG] reading MMIO from {:#0x}: {:#0x}", addr, res);
+    res
+}
+
+pub fn write_mmio(addr: Address, val: u32, mmio_writes: &mut HashMap<u32, u32>) {
+    mmio_writes.insert(addr, val);
+}
+
+pub fn read_word(address: Address) -> u32 {
+    let test = custom::memory_read::<u32, 4>(address);
+    match test {
+        Ok(value) => {
+            //println!("[DEBUG] reading from {:#0x}: {:#0x}", address, value);
+            value
+        }
+        Err(_err) => 0,
+    }
+}
+
+pub fn write_word(address: Address, data: u32) {
+    //println!("[DEBUG] writing to {:#0x}: {:#0x}", address, data);
+
+    let _ = custom::memory_write::<u32, 4>(address, data);
+}
+
+pub fn read_byte(address: Address) -> u8 {
+    let test = custom::memory_read::<u8, 1>(address);
+    match test {
+        Ok(value) => {
+            ////println!("[DEBUG] reading from {:#0x}: {:#0x}", address, value);
+            value
+        }
+        Err(_err) => 0,
+    }
+}
+
+pub fn write_byte(address: Address, data: u8) {
+    //println!("[DEBUG] writing to {:#0x}: {:#0x}", address, data);
+    let _ = custom::memory_write::<u8, 1>(address, data);
+}
+
+pub fn read_area_bytes(address: Address, size: u32) -> Vec<u8> {
+    let mut res: Vec<u8> = Vec::new();
+    for i in 0..size {
+        let cur_address = address + i;
+        let test = read_byte(cur_address);
+        res.push(test);
+    }
+    res
+}
+
+pub fn read_area_bytes_le(address: Address, size: u32) -> Vec<u8> {
+    let mut res: Vec<u8> = Vec::new();
+    let mut tmp: Vec<u8> = Vec::new();
+
+    for index in 0..size {
+        if tmp.len() == 4 {
+            for x in tmp.into_iter().rev() {
+                res.push(x);
+            }
+            tmp = Vec::new();
+        }
+
+        let cur_address = address + index;
+        tmp.push(read_byte(cur_address));
+    }
+
+    if tmp.len() != 0 {
+        for _ in 0..(4 - tmp.len()) {
+            tmp.push(0);
+        }
+        for x in tmp.into_iter().rev() {
+            res.push(x);
+        }
+    }
+
+    res
+}
+
+pub fn write_area_bytes(address: Address, data: Vec<u8>) {
+    //println!("Write area bytes!");
+    //println!("Written to {:#0x}", address);
+    let mut index = 0;
+    for i in data {
+        write_byte(address + index, i);
+        index += 1;
+    }
+}
+
+pub fn _read_area_words(address: Address, size: u32) -> Vec<u32> {
+    let mut res: Vec<u32> = Vec::new();
+    for i in 0..size {
+        let cur_address = address + i;
+        let test = read_word(cur_address);
+        res.push(test);
+    }
+    res
+}
+
+pub fn _write_area_words(address: Address, data: Vec<u32>) {
+    let mut index = 0;
+    for i in data {
+        write_word(address + index, i);
+        index += 1;
+    }
+}
