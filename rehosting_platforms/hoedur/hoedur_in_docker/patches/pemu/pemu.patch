+    type: data
+    size: b2
+    value: 0
+    doc: mode decides which header fields are obligatory
+
+  extended_header_length:
+    type: handler
+    handler: ble_ext_header_length_handler
+    size: b6
+    doc: Length of the extended header
+
+  # now the variable extended header flags; table 2.12; page 2692
+  # bits      extended header
+  # ---------------------------
+  # 0         AdvA
+  # 1         TargetA
+  # 2         CTEInfo
+  # 3         AdvDataInfo (ADI)
+  # 4         AuxPtr
+  # 5         SyncInfo
+  # 6         TxPower
