+
+    if frame_type in [IEEE802154_DATA, IEEE802154_BEACON] and dest_addr_mode in [2,3] and not source_addr_mode and not pan_id_compr:
+        # dest pand id + dest addr
+        set_field_info(header['destination_PAN'], SIZE, 2) 
+        header['destination_addr'][SIZE] = 2 if dest_addr_mode == 2 else 8
+    if frame_type != IEEE802154_ACK and not dest_addr_mode and source_addr_mode in [2,3] and not pan_id_compr:
+        #src pan id + src addr
+        set_field_info(header['source_PAN'], SIZE, 2) 
+        header['source_addr'][SIZE] = 2 if source_addr_mode == 2 else 8
+    if frame_type in [IEEE802154_DATA, IEEE802154_COMMAND] and dest_addr_mode in [2,3] and source_addr_mode in[2,3]:
+        if not pan_id_compr:
+            # all ids and addrs
+            set_field_info(header['destination_PAN'], SIZE, 2) 
+            header['destination_addr'][SIZE] = 2 if dest_addr_mode == 2 else 8
+            set_field_info(header['source_PAN'], SIZE, 2) 
+            header['source_addr'][SIZE] = 2 if source_addr_mode == 2 else 8
+        if pan_id_compr:
+            # all but src addr -> should  be pan right?
+            set_field_info(header['destination_PAN'], SIZE, 2) 
