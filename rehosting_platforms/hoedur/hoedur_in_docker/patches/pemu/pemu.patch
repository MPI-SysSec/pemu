+++ b/emulator/src/hooks/pemu/nrf52.rs
@@ -0,0 +1,112 @@
+use common::hashbrown::HashMap;
+
+use super::common::{read_area_bytes, read_mmio, to_hex_string, write_area_bytes};
+
+// Channel - frquency mapping
+const MMIO_PKT_PTR: u32 = 0x40001504;
+const MMIO_PCNF_1: u32 = 0x40001518;
+const MMIO_FREQUENCY: u32 = 0x40001508;
+const LEN_MASK: u32 = 0xff;
+const RADIO_BASE: u32 = 0x40001000;
+
+pub fn nrf52_is_store_mmio(address: u32) -> bool {
+    if address >= RADIO_BASE && address < RADIO_BASE + 0x1000 {
+        return true;
+    }
+    return false;
+}
+
+pub fn pemu_place_packet(mmio_writes: &mut HashMap<u32, u32>, address: u32, packet: Vec<u8>) {
+    //println!("Pemu place packet: {:#0x}", address);
+    let hex_packet: String = to_hex_string(&packet);
+    //println!("Writing packet: {}", hex_packet);
+    write_area_bytes(address, packet);
+}
+
+pub fn pemu_nrf52_receive(mmio_writes: &mut HashMap<u32, u32>) -> (u32, u32, u32) {
+    //println!("[NRF52 Receive] Enter");
+    let send_packet = 1;
+    let buf_addr = read_mmio(MMIO_PKT_PTR, mmio_writes);
+    let max_size = read_mmio(MMIO_PCNF_1, mmio_writes) & LEN_MASK;
+    if buf_addr == 0 {
+        //println!("[NRF52 Receive] Exit 1");
+        return (0, 0, 0);
+    }
+    //println!("[NRF52 Receive] Exit 2: {:#0x}", buf_addr);
+    return (send_packet, buf_addr, max_size);
+}
+
+pub fn pemu_nrf52_transmit(mmio_writes: &mut HashMap<u32, u32>) -> (Vec<u8>, i32) {
+    // First we need to test some ram address if it is 1
+    //println!("[NRF52 Transmit] Enter");
+    let buf_addr = read_mmio(MMIO_PKT_PTR, mmio_writes);
+
+    if buf_addr == 0 {
+        //println!("[NRF52 Transmit] Exit 1");
+        return (vec![], -1);
+    }
+    let packet_size = read_mmio(MMIO_PCNF_1, mmio_writes) & LEN_MASK;
+    let packet: Vec<u8> = read_area_bytes(buf_addr, packet_size);
+    //println!("[NRF52 Transmit] {}", to_hex_string(&packet));
+
+    return (packet, pemu_nrf52_get_channel(mmio_writes) as i32);
+}
+
+pub fn pemu_nrf52_get_channel(mmio_writes: &mut HashMap<u32, u32>) -> u32 {
+    let freq = read_mmio(MMIO_FREQUENCY, mmio_writes);
+    let base_frequency = if freq & 0x100 != 0 { 2360 } else { 2400 };
+    return freq_to_chan(base_frequency + (freq & 0xff));
+}
+
+fn freq_to_chan(freq: u32) -> u32 {
+    let freq_chan_map: HashMap<u32, u32> = [
+        (2402, 37),
+        (2404, 0),
+        (2406, 1),
+        (2408, 2),
+        (2410, 3),
+        (2412, 4),
+        (2414, 5),
+        (2416, 6),
+        (2418, 7),
+        (2420, 8),
+        (2422, 9),
+        (2424, 10),
+        (2426, 38),
+        (2428, 11),
+        (2430, 12),
+        (2432, 13),
+        (2434, 14),
+        (2436, 15),
+        (2438, 16),
+        (2440, 17),
+        (2442, 18),
+        (2444, 19),
+        (2446, 20),
+        (2448, 21),
+        (2450, 22),
+        (2452, 23),
+        (2454, 24),
+        (2456, 25),
+        (2458, 26),
+        (2460, 27),
+        (2462, 28),
+        (2464, 29),
+        (2466, 30),
+        (2468, 31),
+        (2470, 32),
+        (2472, 33),
+        (2474, 34),
+        (2476, 35),
+        (2478, 36),
+        (2480, 39),
+    ]
+    .iter()
+    .cloned()
+    .collect();
+
+    if let Some(chan) = freq_chan_map.get(&freq) {
+        return *chan;
+    }
+    return 0;
+}
