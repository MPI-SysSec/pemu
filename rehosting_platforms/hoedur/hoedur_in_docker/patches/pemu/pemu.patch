+def le_to_bytes(val: int) -> bytes:
+    """    
+    Transfrom a little endian integer to bytestring
+    """
+    be_bytes = bytes.fromhex(((len(hex(val)[2:]) % 2) * '0') +  hex(val)[2:])
+    le_bytes = b''.join([be_bytes[i:i+4][::-1] for i in range(0, len(be_bytes), 4)])
+    return le_bytes
