+        #if not self._consumed_fuzz:
+            # not enough fuzz bytes to choose a layer; maybe change this TODO
+        #self._logger.warning(f"[choose_fault_layer] entering")
+        #dice = (reduce(lambda x,y: x ^ y,self._consumed_fuzz) >> 1) % (len(self._protocols) + 1) 
+        dice = self._get_fuzz(1)
+        if self._ran_out_of_fuzz:
+            return NOT_ENOUGH_FUZZ
+        dice = int.from_bytes(dice, "big") % (len(self._protocols)) 
