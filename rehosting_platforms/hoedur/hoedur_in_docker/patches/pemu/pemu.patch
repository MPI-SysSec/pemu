+
+const _ETH_DMAMR: u32 = 0x000; //dma bus mode register
+const _ETH_DMASBMR: u32 = 0x004; //dma bus mode register
+const _ETH_DMAISR: u32 = 0x008; //dma interrupt status register
+const _ETH_DMADSR: u32 = 0x00c; //dma debgug status register
+const _ETH_DMACCR: u32 = 0x100; //dma channel control register
+const _ETH_DMACTXCR: u32 = 0x104; //dma channel transmit control register
+const _ETH_DMACRXCR: u32 = 0x108; //dma channel receive control register
+const _ETH_DMACTXDLAR: u32 = 0x114; //dma channel transmit descriptor list register
+const _ETH_DMACRXDLAR: u32 = 0x11c; //dma channel receive descriptor list register
+const _ETH_DMACTXDTPR: u32 = 0x120; //dma channel transmit descriptor tail pointer register
+const _ETH_DMACRXDTPR: u32 = 0x128; //dma channel receive descriptor rail pointerregister
+const _ETH_DMACTXRLR: u32 = 0x12c; //dma channel transmit descriptor ring length register
+const _ETH_DMACRXRLR: u32 = 0x130; //dma channel receive descriptor ring length register
+const _ETH_DMACIER: u32 = 0x134; //dma interrupt enable register
+const _ETH_DMACRXIWTR: u32 = 0x138; //dma channel receive interrupt watchdog timer register
+const _ETH_DMACCATXDR: u32 = 0x144; //dma channel current application transmit descriptor  register
+const _ETH_DMACCARXDR: u32 = 0x14c; //dma channel current application receive descriptor register
+const _ETH_DMACCATXBR: u32 = 0x154; //dma channel current application transmit descriptor buffer register
+const _ETH_DMACCARXBR: u32 = 0x15c; //dma channel current application receive descriptor buffer register
+const _ETH_DMACSR: u32 = 0x160; //dma status register
+const _ETH_DMACMFCR: u32 = 0x16c; //dma channel miossed frame count register
+                                  //
+                                  //
+                                  //
+const _ETH_DMATPDR: u32 = 0x004; //ddma transmit poll demand register
+const _ETH_DMARPDR: u32 = 0x008; //dma receive poll demand register
+const _ETH_DMAMFBOCR: u32 = 0x020; //dma missed frame and buffer overflow counter register
+const _ETH_DMARSWTR: u32 = 0x024; //dma receive status watchdog timer register
+const _ETH_DMACHTDR: u32 = 0x048; //dma current host transmit descriptor register
+const _ETH_DMACHRDR: u32 = 0x04c; //dma current host receive descriptor register
+const ETH_DMACHTBAR: u32 = 0x050; //dma current host transmit buffer address register
+const ETH_DMACHRBAR: u32 = 0x054; //dma current host receive buffer address register
+
+const RDES0: u32 = 0x0; //offset to value given in eth_dmardlar, status
+const RDES1: u32 = 0x4; // sizes of of buffer1 and 2
+const RDES2: u32 = 0x8; // buffer1 addr
+const RDES3: u32 = 0xc; // buffer2 addr or next descriptor addr
+
+const SR_MASK: u32 = 0x1; //start/stop receive bit
+const ST_MASK: u32 = 1; //start/stop transmit bit
+const OWN_MASK: u32 = 1 << 31;
+const RBS1_MASK: u32 = 0x1fff;
+const _RBS2_MASK: u32 = 0x1fff0000;
+const _DIC_MASK: u32 = 1 << 31; //TODO???
+const TX_LS_MASK: u32 = 1 << 28;
+const RS_MASK: u32 = 1 << 6; //receive stauts bit in ETH_DMASR
+const ERS_MASK: u32 = 1 << 11; //early receive status in ETH_DMASR
+const TS_MASK: u32 = 1;
+const TBUS_MASK: u32 = 1 << 2;
+
+const DESCRIPTOR_SIZE: u32 = 0x10 * 4; // 4 dwords
+
+const BASE_ADDR: u32 = 0x40029000; //TODO ethernet base addr
+
+const RCV_COUNTER: u32 = 0xdeadbeef;
+
+pub fn h753_is_store_mmio(address: u32) -> bool {
+    if address >= BASE_ADDR && address < BASE_ADDR + 0x1000 {
+        return true;
+    }
+    return false;
+}
+const _MMIO_BLOCK_LIST: &[u32] = &[
+    BASE_ADDR + _ETH_DMACCATXDR,
+    BASE_ADDR + _ETH_DMACCATXDR,
+    BASE_ADDR + _ETH_DMACCARXBR,
+    BASE_ADDR + _ETH_DMACCATXBR,
+];
+pub fn _h753_is_hook_mmio_read(address: u32) -> bool {
+    // More or less debugging purposes
+    // What do we need to hook?
+    // ETHDMASR
+    // ETH_DMACHRBAR
+    // ETH_DMACHTBAR
+    if _MMIO_BLOCK_LIST.contains(&address) {
+        return true;
+    }
+    return false;
+}
+
+pub fn _h753_post_read_hook(address: u32, mmio_writes: &mut HashMap<u32, u32>) {
+    mmio_writes.remove(&address);
+}
+
+pub fn pemu_place_packet(mmio_writes: &mut HashMap<u32, u32>, address: u32, packet: Vec<u8>) {
+    //println!("Place packet {:x}", address);
+    //dbg!(&packet);
+    let mut mut_packet = packet;
+    //let mut mut_packet = packet.clone();
+    /*
+        if mut_packet.len() > 0x20 {
+            mut_packet[0x1e] = 10;
+            mut_packet[0x1f] = 42;
+            mut_packet[0x20] = 0;
+            mut_packet[0x21] = 2;
+        }
+    */
+    let hex_packet: String = to_hex_string(&mut_packet);
+    //println!("Placed packet {}", hex_packet);
+    set_buffer_size(mmio_writes, mut_packet.len() as u32);
+    write_area_bytes(address, mut_packet);
+}
+
+pub fn pemu_post_h753_receive(mmio_writes: &mut HashMap<u32, u32>) {
+    //println!("Postprocessing");
+    // Postprocessing
+    // RDES3
+    let descriptor = get_current_descriptor(mmio_writes);
+    //println!("descriptor {:x}", descriptor);
+
+    let mut rdes3 = read_word(descriptor + RDES3);
+    rdes3 = (rdes3 & 0x7fff) | 0x30000000;
+    //println!("writing to rdes3: {:x}::{:x}", descriptor + RDES3, rdes3);
+    write_word(descriptor + RDES3, rdes3);
+
+    set_receive_status(mmio_writes);
+
+    return;
+}
+
+pub fn pemu_h753_receive(mmio_writes: &mut HashMap<u32, u32>) -> (u32, u32, u32) {
+    //println!("RECEIVE");
+    let buf_size: u32 = 0;
+    let buf_addr: u32 = 0;
+    let send_packet: u32 = 0;
+    let rcv_counter = read_mmio(RCV_COUNTER, mmio_writes);
+    /*
+    if rcv_counter > 0 {
+        write_mmio(RCV_COUNTER, rcv_counter - 1, mmio_writes);
+        //println!("SKibidi placement {}", rcv_counter);
+        return (send_packet, buf_addr, buf_size);
+    }
+    write_mmio(RCV_COUNTER, 2, mmio_writes);
+    */
+    if rcv_counter < 2 {
+        write_mmio(RCV_COUNTER, rcv_counter + 1, mmio_writes);
+        //println!("SKibidi placement {}", rcv_counter);
+        return (send_packet, buf_addr, buf_size);
+    }
+    write_mmio(RCV_COUNTER, 0, mmio_writes);
+
+    // TODO
+    let receive_status = get_receive_status(mmio_writes);
+    if !receive_status {
+        // Not allowed to do anythin yet
+        ////println!("Not allowed to send yet :-(");
+        return (send_packet, buf_addr, buf_size);
+    }
+    if poll_descriptor(mmio_writes) == 0 {
+        ////println!("Not owning the descriptor");
+        return (send_packet, buf_addr, buf_size);
+    }
+
+    // Values for the emulator to insert the packet
+    let buf_size = get_buffer_size(mmio_writes);
+    let buf_addr = get_buffer_addr(mmio_writes);
+    //println!("buf addr, buf size: {:x}::{:x}", buf_addr, buf_size);
+    write_mmio(BASE_ADDR + _ETH_DMACCARXBR, buf_addr, mmio_writes);
+    if buf_addr == 0 {
+        return (send_packet, buf_addr, buf_size);
+    }
+
+    let send_packet: u32 = 1;
+    return (send_packet, buf_addr, buf_size);
+}
+
+pub fn pemu_h753_transmit(mmio_writes: &mut HashMap<u32, u32>) -> (Vec<u8>, i32) {
+    //println!("TRANSMIT!");
+    let transmit_status = get_transmit_status(mmio_writes);
+    //println!("transmit_status: {}", transmit_status);
+    if !transmit_status {
+        // Not allowed to transmit yet
+        return (vec![], -1);
+    }
+
+    if poll_tx_descriptor(mmio_writes) == 0 {
+        ////println!("[Transmit] no desciptor found");
+        // no descriptor found
+        // TODO maybe set_tbus_state?
+        return (vec![], -1);
+    }
+
+    let descriptor = get_current_tx_descriptor(mmio_writes);
+    ////println!("[transmit] polled descriptor");
+
+    // So far we only read out the buffer of one descriptor
+    // In theory a packet might be spread among multiple buffers
+    let packet_size = get_tx_buffer_size(mmio_writes);
+    let buf_addr = get_tx_buffer_addr(mmio_writes);
+    if buf_addr == 0 {
+        return (vec![], -1);
+    }
+    write_mmio(BASE_ADDR + _ETH_DMACCATXBR, buf_addr, mmio_writes);
+    let packet: Vec<u8> = read_area_bytes_le(buf_addr, packet_size);
+    //dbg!(&packet);
+
+    // Post transfer steps
+    // reset own bit
+    write_word(
+        get_current_tx_descriptor(mmio_writes) + RDES3,
+        read_word(get_current_tx_descriptor(mmio_writes) + RDES3) & 0x7fffffff,
+    );
+
+    // Do this for all further descriptors?
+    let mut cur_descriptor = get_current_tx_descriptor(mmio_writes);
+    let base_descriptor = cur_descriptor;
+    while read_word(cur_descriptor + RDES3) & TX_LS_MASK == 0 {
+        if poll_tx_descriptor(mmio_writes) == 1 {
+            // TODO maybe set tbus state
+            return (packet, -1);
+        }
+        cur_descriptor = get_current_tx_descriptor(mmio_writes);
+        write_word(
+            cur_descriptor + RDES3,
+            read_word(cur_descriptor + RDES3) & 0x7fffffff,
+        );
+
+        if cur_descriptor == base_descriptor {
+            break;
+        }
+    }
+
+    (packet, -1)
+}
+
+fn set_receive_status(mmio_writes: &mut HashMap<u32, u32>) {
+    // Set the the RS bit in ETH_DMASR
+    // clear ERS (early receive status)
+    // set NIS (normal interrupt summary)
+    let enabled_interrupts = get_active_receive_interrupts(mmio_writes);
+    write_mmio(
+        BASE_ADDR + _ETH_DMACSR,
+        enabled_interrupts & RS_MASK,
+        mmio_writes,
+    );
+    if enabled_interrupts & RS_MASK != 0 {
+        // ERS is cleared if RS is set
+        let status_reg = read_mmio(BASE_ADDR + _ETH_DMACSR, mmio_writes);
+        let new_status_reg = status_reg & (0xffffffff ^ ERS_MASK);
+        write_mmio(BASE_ADDR + _ETH_DMACSR, new_status_reg, mmio_writes);
+    }
+
+    // NIS
+    let status_reg = read_mmio(BASE_ADDR + _ETH_DMACSR, mmio_writes);
+    let new_status_reg = status_reg | get_nis_val(status_reg);
+    write_mmio(BASE_ADDR + _ETH_DMACSR, new_status_reg, mmio_writes);
+}
+
+fn get_nis_val(status_reg: u32) -> u32 {
+    let nis_val = ((status_reg & TS_MASK)
+        | ((status_reg & TBUS_MASK) >> 2)
+        | ((status_reg & RS_MASK) >> 6)
+        | ((status_reg & ERS_MASK) >> 14))
+        << 16;
+    nis_val
+}
+
+fn is_descriptor_owner(mmio_writes: &mut HashMap<u32, u32>) -> bool {
+    let cur_descriptor = get_current_descriptor(mmio_writes);
+    ((read_word(cur_descriptor + RDES3) & OWN_MASK) >> 31) == 1
+}
+
+fn get_active_receive_interrupts(mmio_writes: &mut HashMap<u32, u32>) -> u32 {
+    let h753_mask = 0x8840;
+    read_mmio(BASE_ADDR + _ETH_DMACIER, mmio_writes) & h753_mask
+}
+
+fn get_buffer_addr(mmio_writes: &mut HashMap<u32, u32>) -> u32 {
+    let cur_descriptor = get_current_descriptor(mmio_writes);
+    // check which address is valid:
+    let status = read_word(cur_descriptor + RDES3);
+    if (status >> 24) & 1 == 1 {
+        return read_word(cur_descriptor + RDES0);
+    } else if (status >> 25) & 1 == 1 {
+        //buffer addr 2 valid
+        return read_word(cur_descriptor + RDES2);
+    }
+    0
+}
+
+fn get_buffer_size(mmio_writes: &mut HashMap<u32, u32>) -> u32 {
+    let receive_control = read_mmio(BASE_ADDR + _ETH_DMACRXCR, mmio_writes);
+    let buf_size = (receive_control >> 1) & 0x3fff;
+    buf_size
+}
+
+fn set_buffer_size(mmio_writes: &mut HashMap<u32, u32>, val: u32) {
+    let cur_descriptor = get_current_descriptor(mmio_writes);
+    let cur_descriptor_val = read_word(cur_descriptor + RDES3);
+    let updated_descriptor = (cur_descriptor_val & 0xffff7fff) | val;
+    ////println!("Setting seize: {:x}::{:x}-->{:x}", cur_descriptor, cur_descriptor_val ,updated_descriptor,);
+    write_word(cur_descriptor + RDES3, updated_descriptor);
+}
+
+fn get_receive_status(mmio_writes: &mut HashMap<u32, u32>) -> bool {
+    (read_mmio(BASE_ADDR + _ETH_DMACRXCR, mmio_writes) & SR_MASK) == 1
+}
+
+fn get_transmit_status(mmio_writes: &mut HashMap<u32, u32>) -> bool {
+    (read_mmio(BASE_ADDR + _ETH_DMACTXCR, mmio_writes) & ST_MASK) == 1
+}
+
+fn get_current_descriptor(mmio_writes: &mut HashMap<u32, u32>) -> u32 {
+    read_mmio(BASE_ADDR + _ETH_DMACCARXDR, mmio_writes)
+}
+
+// TODO: do we propagate changes through to the firmware mmio reads?
+fn set_current_descriptor(descriptor: u32, mmio_writes: &mut HashMap<u32, u32>) {
+    write_mmio(BASE_ADDR + _ETH_DMACCARXDR, descriptor, mmio_writes);
+}
+
+fn get_current_tx_descriptor(mmio_writes: &mut HashMap<u32, u32>) -> u32 {
+    read_mmio(BASE_ADDR + _ETH_DMACCATXDR, mmio_writes)
+}
+
+// TODO: do we propagate changes through to the firmware mmio reads?
+fn set_current_tx_descriptor(descriptor: u32, mmio_writes: &mut HashMap<u32, u32>) {
+    write_mmio(BASE_ADDR + _ETH_DMACCATXDR, descriptor, mmio_writes);
+}
+
+fn poll_descriptor(mmio_writes: &mut HashMap<u32, u32>) -> u32 {
+    /*
+    let first_descriptor = read_mmio(BASE_ADDR + _ETH_DMACRXDLAR, mmio_writes);
+    let beyond_last_descriptor = read_mmio(BASE_ADDR + _ETH_DMACRXDTPR, mmio_writes);
+    let ring_length = read_mmio(BASE_ADDR + _ETH_DMACTXRLR, mmio_writes);
+
+    let rx_channel_control = read_mmio(BASE_ADDR + _ETH_DMACRXCR, mmio_writes);
+    let start_receive = rx_channel_control & SR_MASK;
+    let receive_buffer_size = (rx_channel_control & 0x7ffe) >> 1;
+
+    let channel_control = read_mmio(BASE_ADDR + _ETH_DMACCR, mmio_writes);
+    let dsl = (channel_control >> 18) & 0x3; // dwords to skip between descriptors
+
+    //println!("first_descriptor: {:x}", first_descriptor);
+    //println!("beyond last descriptor {:x}", beyond_last_descriptor);
+    //println!("ring_length {:x}", ring_length);
+    //println!("Rx channel_control {:x}", rx_channel_control);
+    //println!("channel_control {:x}", channel_control);
+    //println!("dsl is {:x}", dsl);
+    */
+
+    let cur_descriptor = get_current_descriptor(mmio_writes);
+    if cur_descriptor == 0 {
+        let base_descriptor: u32 = read_mmio(BASE_ADDR + _ETH_DMACRXDLAR, mmio_writes);
+        set_current_descriptor(base_descriptor, mmio_writes);
+    } else {
+        set_current_descriptor(poll_ring(cur_descriptor, mmio_writes), mmio_writes);
+
+        if get_current_descriptor(mmio_writes) == 0 {
+            ////println!("ERROR");
+            return 0;
+        }
+    }
+    //println!("got descriptor {:x}", get_current_descriptor(mmio_writes));
+    if !is_descriptor_owner(mmio_writes) {
+        return 0;
+    }
+
+    return 1;
+}
+
+fn poll_ring(descriptor: u32, mmio_writes: &mut HashMap<u32, u32>) -> u32 {
+    //
+    //println!("descriptor {:x}::{:x}", descriptor, RDES3);
+    let rdes3 = read_word(descriptor + RDES3);
+    if rdes3 & OWN_MASK != 0 {
+        // we can just keep the descriptor - its ours
+        return descriptor;
+    }
+
+    //loop over list from the beginnging
+    let descriptor_base = read_mmio(BASE_ADDR + _ETH_DMACRXDLAR, mmio_writes);
+    let ring_length = read_mmio(BASE_ADDR + _ETH_DMACRXRLR, mmio_writes) & 0x3ff;
+    //println!("Got {:x} items in the ring", ring_length);
+
+    let channel_control = read_mmio(BASE_ADDR + _ETH_DMACCR, mmio_writes);
+    let dsl = (channel_control >> 18) & 0x3; // dwords to skip between descriptors
+    let beyond_last_descriptor = read_mmio(BASE_ADDR + _ETH_DMACRXDTPR, mmio_writes);
+    // loop over list until we either reach the parsed descriptor or find a free one
+    for cur_descriptor in (descriptor_base..beyond_last_descriptor)
+        .step_by((DESCRIPTOR_SIZE + dsl * 0x10).try_into().unwrap())
+    {
+        let rdes3 = read_word(cur_descriptor + RDES3);
+        if rdes3 & OWN_MASK != 0 {
+            return cur_descriptor;
+        }
+    }
+
+    return 0;
+}
+
+fn poll_tx_descriptor(mmio_writes: &mut HashMap<u32, u32>) -> u32 {
+    let cur_descriptor = get_current_tx_descriptor(mmio_writes);
+    //println!("[1] cur_descriptor: {:x}", cur_descriptor);
+
+    if cur_descriptor == 0 {
+        // Not descriptor set, look at the start of the descriptor list
+        let base_descriptor = read_mmio(BASE_ADDR + _ETH_DMACTXDLAR, mmio_writes);
+        set_current_tx_descriptor(base_descriptor, mmio_writes);
+    }
+
+    let cur_descriptor = get_current_tx_descriptor(mmio_writes);
+    //println!("[2] cur_descriptor: {:x}", cur_descriptor);
+    let descriptor_owner = get_tx_descriptor_owner(cur_descriptor);
+    //println!("descriptor_owner {:x}", descriptor_owner);
+    if descriptor_owner != 0 {
+        // Nice we already own the first descriptor
+        return 1;
+    }
+
+    //loop over list from the beginnging
+    let descriptor_base = read_mmio(BASE_ADDR + _ETH_DMACTXDLAR, mmio_writes);
+    let ring_length = read_mmio(BASE_ADDR + _ETH_DMACTXRLR, mmio_writes) & 0x3ff;
+    //println!("Got {:x} items in the ring", ring_length);
+
+    let channel_control = read_mmio(BASE_ADDR + _ETH_DMACCR, mmio_writes);
+    let dsl = (channel_control >> 18) & 0x3; // dwords to skip between descriptors
+    let beyond_last_descriptor = read_mmio(BASE_ADDR + _ETH_DMACTXDTPR, mmio_writes);
+    //println!("first_descriptor: {:x}", descriptor_base);
+    //println!("beyond last descriptor {:x}", beyond_last_descriptor);
+    //println!("ring_length {:x}", ring_length);
+    //println!("channel_control {:x}", channel_control);
+    //println!("dsl is {:x}", dsl);
+    // loop over list until we either reach the parsed descriptor or find a free one
+    for cur_descriptor in (descriptor_base..beyond_last_descriptor)
+        .step_by((DESCRIPTOR_SIZE + dsl * 0x10).try_into().unwrap())
+    {
+        //println!("Checking cur_descriptor {:x}", cur_descriptor);
+        let rdes3 = read_word(cur_descriptor + RDES3);
+        if rdes3 & OWN_MASK != 0 {
+            set_current_tx_descriptor(cur_descriptor, mmio_writes);
+            return 1;
+        }
+    }
+
+    return 0;
+}
+
+fn get_tx_descriptor_owner(cur_descriptor: u32) -> u32 {
+    if cur_descriptor + RDES3 == 0 {
+        return 0;
+    }
+    (read_word(cur_descriptor + RDES3) & OWN_MASK) >> 31
+}
+
+fn get_tx_buffer_addr(mmio_writes: &mut HashMap<u32, u32>) -> u32 {
+    let cur_descriptor = get_current_tx_descriptor(mmio_writes);
+    let rdes3 = read_word(cur_descriptor + RDES3);
+    if (rdes3 >> 18) & 0x801 == 0x801 {
+        // First buffer is TSO Header Address pointer
+        let buf_addr = read_word(cur_descriptor + RDES1);
+        return buf_addr;
+    } else {
+        let buf_addr = read_word(cur_descriptor + RDES0);
+        return buf_addr;
+    }
+    0
+}
+
+fn get_tx_buffer_size(mmio_writes: &mut HashMap<u32, u32>) -> u32 {
+    let cur_descriptor = get_current_tx_descriptor(mmio_writes);
+    let rdes3 = read_word(cur_descriptor + RDES3);
+    if (rdes3 >> 18) & 0x801 == 0x801 {
+        // First buffer is TSO Header Address pointer
+        let buf_size = (read_word(cur_descriptor + RDES2) >> 16) & RBS1_MASK;
+        return buf_size;
+    } else {
+        let buf_size = read_word(cur_descriptor + RDES2) & RBS1_MASK;
+        return buf_size;
+    }
+}
