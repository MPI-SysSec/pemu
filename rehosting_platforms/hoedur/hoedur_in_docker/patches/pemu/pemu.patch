+    if field[VALUE] != fcf:
+        field[VALUE] = fcf
+        field[STREAM_LEN] = get_bitsize(field)
+        field[STREAM_DATA] = f"{le_place_data(field[VALUE], field[STREAM_LEN]):0{field[STREAM_LEN]}b}"[-field[STREAM_LEN]:]
+
+    return
