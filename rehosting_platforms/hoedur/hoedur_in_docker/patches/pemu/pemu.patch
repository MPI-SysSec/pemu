+        for attr_name, val in self._snapshot.items():
+            #print(f"\t[Packer] restoring snapshot of attr '{attr_name}' from value '{getattr(self, attr_name)}' to value '{self._snapshot[attr_name]}'")
+            setattr(self, attr_name, copy.deepcopy(self._snapshot[attr_name]))
+        #print(f"\t[Packer] restoring snapshot of attr '_protocols' from value '{self._protocols}' to value '{self._static_protocols}'")
+        self._protocols = self._static_protocols
