+    if encoding >> 8 & 3== 0b11:
+        set_header_field(ip6_layer, 'hop_limit', COMPRESSED, True) 
+        set_header_field(ip6_layer, 'hop_limit', VALUE, 255) 
+
+    # cid
+    cid = ''
+    if encoding >> 7 & 1 == 1:
+        cid = pkt[16:24]
