+/// PemuDataSnapshot
+/// Struct containing the snapshot information for PemuData
+struct PemuDataSnapshot {
+    access_pc: Option<Address>,
+    access_mmio: Option<Address>,
+    size_pc: Option<Address>,
+    size_mmio: Option<Address>,
+    size_val: Option<u32>,
+    packet_index: Option<usize>,
+    is_active: bool,
+    access_size: Option<u8>,
+}
+
+/// PemuData
+/// Struct that can be used to buffer a PEMU generated packet.
+/// This is necessary when packets are received via MMIO instead of DMA
+/// In this case the PemuData can facilitate the byte/word/dword-wise reception of the packet.
+#[derive(Debug)]
+struct PemuData {
+    access_pc: Option<Address>,
+    access_mmio: Option<Address>,
+    size_pc: Option<Address>,
+    size_mmio: Option<Address>,
+    size_val: Option<u32>,
+    packet: Option<Vec<u8>>,
+    packet_index: Option<usize>,
+    is_active: bool,
+    max_size: u32,
+    access_size: Option<u8>,
+}
+
+impl PemuData {
+    /// new
+    /// Initialize a new instance
+    pub fn new() -> Self {
+        Self {
+            access_pc: None,
+            access_mmio: None,
+            size_pc: None,
+            size_mmio: None,
+            size_val: None,
+            packet: None,
+            packet_index: None,
+            is_active: false,
+            max_size: 0,
+            access_size: None,
+        }
+    }
+
+    /// reset
+    /// Reset a pemuData object
+    pub fn reset(&mut self) {
+        self.is_active = false;
+        self.access_mmio = None;
+        self.access_pc = None;
+        self.packet = None;
+        self.size_pc = None;
+        self.size_mmio = None;
+        self.size_val = None;
+        self.packet_index = None;
+        self.access_size = None
+    }
+
+    /// snapshot_create
+    /// Create a PemuDataSnapshot from a PemuData object
+    pub fn snapshot_create(&self) -> PemuDataSnapshot {
+        PemuDataSnapshot {
+            access_pc: self.access_pc,
+            access_mmio: self.access_mmio,
+            size_pc: self.size_pc,
+            size_mmio: self.size_mmio,
+            size_val: self.size_val,
+            packet_index: self.packet_index,
+            is_active: self.is_active,
+            access_size: self.access_size,
+        }
+    }
+
+    /// snapshot_restore
+    /// Restore a PemuData object from a PemuDataSnapshot
+    pub fn snapshot_restore(&mut self, snapshot: &PemuDataSnapshot) {
+        self.access_pc = snapshot.access_pc;
+        self.access_mmio = snapshot.access_mmio;
+        self.size_pc = snapshot.size_pc;
+        self.size_mmio = snapshot.size_mmio;
+        self.size_val = snapshot.size_val;
+        self.packet = None;
+        self.packet_index = snapshot.packet_index;
+        self.is_active = snapshot.is_active;
+        self.access_size = snapshot.access_size;
+    }
+
+    /// is_packet_waiting
+    /// Return if there is currently a cached packet waiting for reception
+    pub fn is_packet_waiting(&self) -> bool {
+        self.is_active
+    }
+
+    pub fn match_context(&self, pc: Address, addr: Address) -> bool {
+        // First check if it fits with the data access
+        if let Some(cur_addr) = self.access_mmio {
+            if cur_addr == addr {
+                //println!("[match_context] matching access mmio");
+                if let Some(cur_pc) = self.access_pc {
+                    if cur_pc == pc {
+                        return true;
+                    }
+                } else {
+                    return true;
+                }
+            }
+        }
+        //Check if it fits with the size adrdress
+        if let Some(cur_addr) = self.size_mmio {
+            if cur_addr == addr {
+                //println!("[match_context] matching size mmio");
+                if let Some(cur_pc) = self.size_pc {
+                    if cur_pc == pc {
+                        return true;
+                    }
+                } else {
+                    return true;
+                }
+            }
+        }
+
+        return false;
+    }
+
+    /// add_size
+    pub fn add_size(&mut self, mmio_addr: Address, pc: Option<Address>, size: u32) {
+        self.size_mmio = Some(mmio_addr);
+        self.size_pc = pc;
+        self.size_val = Some(size);
+    }
+
+    /// add_access_size
+    /// Set access size field: Defines how many bytes per read should be returned
+    pub fn add_access_size(&mut self, access_size: u8) {
+        self.access_size = Some(access_size);
+    }
+
+    /// add_input
+    /// add a network packet that will be sent to the firmware
+    pub fn add_input(&mut self, mmio_addr: Address, data: Vec<u8>) {
+        if self.is_active {
+            if let Some(cur_index) = self.packet_index {
+                if let Some(cur_packet) = &self.packet {
+                    if cur_index + 1 < cur_packet.len() {
+                        ()
+                    }
+                }
+            }
+        }
+
+        self.access_mmio = Some(mmio_addr);
+        self.packet_index = Some(0);
+        self.is_active = true;
+
+        if data.len() % 4 != 0 {
+            let mut padded_buf = data;
+            while padded_buf.len() % 4 != 0 {
+                padded_buf.push(0)
+            }
+            self.packet = Some(padded_buf);
+        } else {
+            self.packet = Some(data);
+        }
+    }
+
+    /// consume_input
+    /// Called by an MMIO handler. Take access_size amount of bytes from the currently stored
+    /// packet
+    pub fn consume_input(&mut self, addr: Address, access_size: ReadSize) -> Option<u32> {
+        if !self.is_active {
+            return None;
+        }
+        // If the requested addr is related to the size return the size value
+        // In some cases data and size mmio address are the same.
+        // Hence we consume the size, such that only the first access will return the size
+        // TODO There might be cases where the size is read multiple times. In that case we need to
+        // allow for extra handling of such cases.
+        if let Some(cur_size_mmio) = self.size_mmio {
+            if addr == cur_size_mmio {
+                let res = self.size_val;
+                self.size_mmio = None;
+                self.size_pc = None;
+                self.size_val = None;
+                return res;
+            }
+        }
+
+        let mut ret: Option<u32> = None;
+        let mut size = access_size as usize;
+        // Sometimes there maybe a mask and we need a special, pre defined access sizze
+        if let Some(masked_access) = self.access_size {
+            size = masked_access as usize;
+        }
+
+        let index = self.packet_index?;
+        self.packet.as_ref()?.get(index..index + size).map(|bytes| {
+            let mut buf = [0u8; 4]; // Zero-initialized buffer
+            buf[..size].copy_from_slice(bytes); // Copy the necessary bytes
+            ret = Some(u32::from_le_bytes(buf)); // Convert to u64 (little-endian)
+        });
+        if index + size > self.packet.as_ref()?.len() {
+            // RESET
+            self.packet_index = None;
+            self.packet = None;
+            self.access_mmio = None;
+            self.access_pc = None;
+            self.is_active = false;
+        } else {
+            self.packet_index = Some(index + size);
+        }
+
+        return ret;
+    }
+}
