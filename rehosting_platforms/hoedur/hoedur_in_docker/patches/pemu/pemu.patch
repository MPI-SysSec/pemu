+        #field[C_MASKED] = True
+        field[HEADER]['pattern'][VALUE] = 0b01000001 
+        field[HEADER]['pattern'][SIZE] = 1
+        field[HEADER]['pattern'][TYPE] = T_DATA 
+        field[HEADER]['encoding'][SIZE] = 0
+
+        return 0
+    #print(f"chosen {handler}")
+    return handler(field, layer, upper_layer, get_bytes)
