+def bytes_change_endianess_32(val: bytes) -> bytes:
+
+    val = val + b'\x00' * ((4 - len(val) % 4) % 4)
+    res = b''
+    for i in range(0, len(val), 4):
+        res += val[i:(i+4)][::-1]
