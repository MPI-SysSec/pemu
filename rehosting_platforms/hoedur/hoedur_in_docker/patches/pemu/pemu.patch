+/* PEMU functions */
+
+/// pemu_init
+/// Given the pemu config intialize the artificial_network_interface python object
+/// which serves as the main interface for creating and parsing packets
+fn pemu_init(pemu_config: TargetNetworkConfig) -> Result<PyObject, Box<dyn std::error::Error>> {
+    let split_string = pemu_config.ani.split('.');
+
+    let mut path = String::from("./");
+    for part in split_string {
+        if part == "artificial_network_interface" {
+            break;
+        } else {
+            path.push_str(part);
+            path.push_str("/");
+        }
+    }
+
+    let pemu_path = path;
+    let config = serde_yaml::to_string(&pemu_config)
+        .expect("Unexpected error while trying to parse the PEMU config");
+
+    let path = Path::new(&pemu_path);
+
+    let pemu_object: PyResult<PyObject> = Python::with_gil(|py| {
+        let syspath: &PyList = py.import_bound("sys")?.getattr("path")?.extract()?;
+        syspath.insert(0, &path)?;
+        let plugin = PyModule::import_bound(py, "artificial_network_interface")?;
+        let class = plugin.getattr("ANI").unwrap();
+        let output = pemu_config.output;
+        let native_args: Vec<&str> = vec![&config, "get_bytes", "", &output];
+        let args = PyTuple::new_bound(py, native_args);
+        let inited_class = class.call1(args).unwrap();
+        Ok(inited_class.into())
+    });
+
+    let working_ref = pemu_object.expect("Error getting a valid reference to the class");
+    Ok(working_ref)
+}
+
+/// pemu_create_snapshot
+/// Rust wrapper around the take_snapshot function of the ANI python object
+fn pemu_create_snapshot(pemu: PyObject) -> Result<(), Box<dyn std::error::Error>> {
+    //println!("Taking snapshot");
+    Python::with_gil(|py| {
+        let _ = pemu.call_method0(py, "take_snapshot")?;
+        Ok(())
+    })
+}
+
+/// pemu_restore_snapshot
+/// Rust wrapper around the restore_snapshot function of the ANI python object
+fn pemu_restore_snapshot(pemu: PyObject) -> Result<(), Box<dyn std::error::Error>> {
+    Python::with_gil(|py| {
+        let _ = pemu.call_method0(py, "restore_snapshot")?;
+        Ok(())
+    })
+}
+
+/// pemu_get_packet
+/// Rust wrapper around the get_packet function of the ANI python object
+fn pemu_get_packet(
+    pemu: PyObject,
+    packet_size: u32,
+) -> Result<Vec<u8>, Box<dyn std::error::Error>> {
+    Python::with_gil(|py| {
+        let gadget = pemu.getattr(py, "_gadget")?;
+
+        let native_args: Vec<u32> = vec![packet_size];
+        let args = PyTuple::new_bound(py, native_args);
+        let _packet = pemu.call_method1(py, "get_packet", args);
+        // Get packet from plugin api
+        let mut gadget_rs: PyRefMut<'_, plugin_api::APIGadget> = gadget.extract(py)?;
+        let packet: Vec<u8> = gadget_rs.get_packet();
+
+        gadget_rs.reset_packet();
+
+        Ok(packet)
+    })
+}
+
+/// pemu_transmit_packet
+/// Rust wrapper around the parse_packet function of the ANI python object
+fn pemu_transmit_packet(
+    pemu: PyObject,
+    packet: Vec<u8>,
+) -> Result<bool, Box<dyn std::error::Error>> {
+    Python::with_gil(|py| {
+        let native_args: Vec<Vec<u8>> = vec![packet];
+        let args = PyTuple::new_bound(py, native_args);
+        let _ = pemu.call_method1(py, "parse_packet", args);
+        let mut result: bool = false;
+        {
+            let gadget = pemu.getattr(py, "_gadget")?;
+            let mut gadget_rs: PyRefMut<'_, plugin_api::APIGadget> = gadget.extract(py)?;
+            result = gadget_rs.consume_inspect_results();
+        }
+        Ok(result)
+    })
+}
+
+/// pemu_set_run_id
+/// Interaction with the API library to set the ID of the current run
+fn pemu_set_run_id(pemu: PyObject, id: u32) -> Result<(), Box<dyn std::error::Error>> {
+    Python::with_gil(|py| {
+        let gadget = pemu.getattr(py, "_gadget")?;
+        let mut gadget_rs: PyRefMut<'_, plugin_api::APIGadget> = gadget.extract(py)?;
+        gadget_rs.set_input_id(id);
+        Ok(())
+    })
+}
+
+/// pemu_random_packet
+/// Interaction with the API library to know if the next packet should be randomized
+fn pemu_random_packet(pemu: PyObject) -> Result<bool, Box<dyn std::error::Error>> {
+    Python::with_gil(|py| {
+        let gadget = pemu.getattr(py, "_gadget")?;
+        let mut gadget_rs: PyRefMut<'_, plugin_api::APIGadget> = gadget.extract(py)?;
+        let next_random = gadget_rs.consume_random();
+        Ok(next_random)
+    })
+}
+
+/// pemu_get_run_id
+/// Interaction with the API library to get the ID of the current run
+fn pemu_get_run_id(pemu: PyObject) -> Result<u32, Box<dyn std::error::Error>> {
+    Python::with_gil(|py| {
+        let gadget = pemu.getattr(py, "_gadget")?;
+        let mut gadget_rs: PyRefMut<'_, plugin_api::APIGadget> = gadget.extract(py)?;
+        let input_id = gadget_rs.get_input_id();
+        Ok(input_id)
+    })
+}
+
+/// pemu_set_channel
+/// Interaction with the API library to set the channel of the firmware; relevant for parsing
+/// packets
+fn pemu_set_channel(pemu: PyObject, channel: i32) -> Result<(), Box<dyn std::error::Error>> {
+    Python::with_gil(|py| {
+        let gadget = pemu.getattr(py, "_gadget")?;
+        let mut gadget_rs: PyRefMut<'_, plugin_api::APIGadget> = gadget.extract(py)?;
+        gadget_rs.set_channel(channel);
+        Ok(())
+    })
+}
