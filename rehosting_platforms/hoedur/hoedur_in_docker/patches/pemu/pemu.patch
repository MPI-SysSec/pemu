new file mode 100644
index 0000000..a7f28c9
--- /dev/null
+++ b/plugin_api/src/lib.rs
@@ -0,0 +1,154 @@
+use pyo3::prelude::*;
+
+#[pyclass]
+pub struct APIGadget {
+    #[pyo3(get, set)]
+    pub cursor: usize,
+    pub packet_cursor: usize,
+    pub input_len: u32,
+    pub fuzzing_data: Vec<u8>,
+    pub result: Vec<u8>,
+    pub stop: bool,
+    pub channel: i32,
+    pub inspect_results: bool,
+    pub input_id: u32,
+    last_input: u32,
+    _next_random: bool,
+    //pub emulator_ref: fn() -> Vec<u8>,
+}
+
+#[pymethods]
+impl APIGadget {
+    #[new]
+    fn new() -> Self {
+        APIGadget {
+            input_len: 0,
+            cursor: 0,
+            packet_cursor: 0,
+            fuzzing_data: vec![],
+            result: vec![],
+            stop: false,
+            channel: -1,
+            inspect_results: false,
+            input_id: 0,
+            last_input: 0,
+            _next_random: false,
+            //emulator_ref,
+        }
+    }
+
+    pub fn update_fuzzing_input(&mut self, new_fuzz: Vec<u8>) {
+        //dbg!(&new_fuzz);
+        self.input_len = self.input_len + (new_fuzz.len() as u32);
+        self.fuzzing_data.extend(new_fuzz);
+        self.stop = false;
+    }
+
+    pub fn set_input_id(&mut self, input_id: u32) {
+        self.last_input = self.input_id;
+        self.input_id = input_id;
+    }
+
+    pub fn get_input_id(&mut self) -> u32 {
+        if self.input_id == self.last_input {
+            return 0;
+        }
+        self.input_id
+    }
+
+    // for snapshotting
+    pub fn reset_fuzzing_input(&mut self) {
+        self.fuzzing_data = vec![];
+        self.cursor = 0;
+        self.input_len = 0;
+        self.stop = false;
+        self.packet_cursor = 0;
+        self.channel = -1;
+    }
+
+    pub fn set_channel(&mut self, channel: i32) {
+        self.channel = channel;
+    }
+
+    fn consume_channel(&mut self) -> i32 {
+        let res = self.channel;
+        self.channel = -1;
+        res
+    }
+
+    fn get_bytes(&mut self, size: usize) -> &[u8] {
+        /*
+        println!(
+            "[get_bytes] requested: {}, got {} left from initial {} ==> cursor @ {}",
+            size,
+            (self.input_len as i32 - self.cursor as i32),
+            self.fuzzing_data.len(),
+            self.cursor
+        );
+        */
+        if self.cursor + size >= (self.input_len as u32).try_into().unwrap() {
+            self.stop = true;
+            return &[];
+        }
+
+        let end = self.cursor + size;
+        let fuzz = &self.fuzzing_data[self.cursor..end];
+        self.cursor = self.cursor + size;
+        //dbg!(&fuzz);
+        fuzz
+    }
+
+    fn set_packet(&mut self, packet: Vec<u8>) {
+        /*println!(
+            "[APIGadget::set_packet] packet is set with length {}",
+            packet.len()
+        );*/
+        self.result = packet;
+    }
+
+    pub fn reset_packet(&mut self) {
+        self.result = vec![];
+    }
+
+    pub fn get_packet(&mut self) -> Vec<u8> {
+        // If pemu did not successfully create the packet, i.e., fuzzing input could not be returned
+        // reset the packet cursor, so the same fuzzing input will be used again
+        if self.stop == true {
+            self.cursor = self.packet_cursor;
+            return vec![];
+        }
+        self.packet_cursor = self.cursor;
+        self.result.clone()
+    }
+
+    pub fn test(&mut self) {
+        println!("TEST");
+    }
+
+    pub fn set_inspect_results(&mut self, val: bool) {
+        //println!("[plugin api] setting result to {}", val);
+        self.inspect_results = val;
+    }
+
+    pub fn consume_inspect_results(&mut self) -> bool {
+        let res: bool = self.inspect_results;
+        self.inspect_results = false;
+        res
+    }
+
+    pub fn set_random(&mut self) {
+        self._next_random = true;
+    }
+
+    pub fn consume_random(&mut self) -> bool {
+        let ret_val = self._next_random;
+        self._next_random = false;
+        ret_val
+    }
+}
+
+#[pymodule]
+pub fn plugin_api(m: &Bound<'_, PyModule>) -> PyResult<()> {
+    m.add_class::<APIGadget>()?;
+    Ok(())
+}
