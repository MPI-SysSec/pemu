diff --git a/pemu/test.py b/pemu/test.py
new file mode 100644
index 0000000..ad8608d
--- /dev/null
+++ b/pemu/test.py
@@ -0,0 +1,237 @@
+# small scrpt to test stuff
+import os
+#from redo.artificial_network_interface import ANI
+from fuzzware_harness.network.artificial_network_interface import ANI
+import binascii
+import logging
+
+
+def get_bytes(n: int):
+    return os.urandom(n)
+
+def test1():
+    print(f"TEST 1: 'Ethernet', 'IP4', 'TCP', 'HTTP'; with some apriori vals")
+    p1 = {'p1': ['Ethernet', 'IP4', 'TCP', 'HTTP']}
+    config = {'network': 
+            {'protocols' : p1,
+            'apriori' : {'Ethernet.dest': 0x414141414141,
+                            'Ethernet.src' : 0x424242424242,
+                            'DHCP.op': 0x1}
+            }}
+
+    ani = ANI(config['network'], get_bytes, 'fuzzware_harness.network', '_out_test')#, logging.DEBUG)
+    pkt = binascii.hexlify(ani.get_packet())
+    print(pkt)
+    print("#######################################")
+    print(f"PARSING TEST 1: IP4 Fragmentation")
+    pkt1 = b''
+    pkt2 = b''
+    pkt3 = b''
+    print("=================================================================")
+    ani.parse_packet(binascii.unhexlify(pkt1))
+    print("=================================================================")
+    ani.parse_packet(binascii.unhexlify(pkt2))
+    print("=================================================================")
+    ani.parse_packet(binascii.unhexlify(pkt3))
+    print("#######################################")
+    print(f"PARSING TEST 1: HTTP Requests")
+      # http get request
+    http_pkt = b''
+    print("=================================================================")
+    ani.parse_packet(binascii.unhexlify(http_pkt))
+
+    http_pkt = b''
+    print("=================================================================")
+    ani.parse_packet(binascii.unhexlify(http_pkt))
+
+
+def test2():
+    print(f"TEST 2 'Ethernet', 'IP4', 'TCP', 'HTTP'; with some apriori vals and FAULTS")
+    p1 = {'p1': ['Ethernet', 'IP4', 'TCP', 'HTTP']}
+    config = {'network': 
+            {'protocols' : p1,
+            'apriori' : {'Ethernet.dest': 0x414141414141,
+                            'Ethernet.src' : 0x424242424242,
+                            'DHCP.op': 0x1},
+            'faults': {'target': 'all',
+                        'probability': 100
+            }}}
+    ani = ANI(config['network'], get_bytes, 'fuzzware_harness.network', '_out_test')#, logging.DEBUG)
+    pkt = binascii.hexlify(ani.get_packet())
+    print(pkt)
+
+def test3():
+    print(f"TEST 3: 12 different bluetooth packets")
+    config = {'network' :
+                {'protocols': {'p1': ['BLE_PHY', 'BLE_adv_channel_pdu', 'BLE_adv_ADV_IND'],
+                            'p2': ['BLE_PHY', 'BLE_adv_channel_pdu', 'BLE_adv_ADV_DIRECT_IND'],
+                            'p3': ['BLE_PHY', 'BLE_adv_channel_pdu', 'BLE_adv_ADV_NONCONN_IND'],
+                            'p4': ['BLE_PHY', 'BLE_adv_channel_pdu', 'BLE_adv_ADV_SCAN_IND'],
+                            'p5': ['BLE_PHY', 'BLE_adv_channel_pdu', 'BLE_adv_ADV_EXT_IND'],
+                            'p6': ['BLE_PHY', 'BLE_adv_channel_pdu', 'BLE_adv_AUX_ADV_IND'],
+                            'p7': ['BLE_PHY', 'BLE_adv_channel_pdu', 'BLE_adv_AUX_SYNC_IND'],
+                            'p8': ['BLE_PHY', 'BLE_adv_channel_pdu', 'BLE_adv_AUX_CHAIN_IND'],
+                            'p9': ['BLE_PHY', 'BLE_adv_channel_pdu', 'BLE_adv_CONNECT_IND'],
