+def remove_trailing_zeroes(packet: bytes) -> bytes:
+    if not packet:
+        return packet
+    cur_len = len(packet)
+    while packet[cur_len-1] == 0:
+        cur_len -= 1
+        if cur_len -1 < 0:
+            return b''
+
+
+
+    return packet[:cur_len]
