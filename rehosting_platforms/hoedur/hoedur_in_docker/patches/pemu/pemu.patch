+use crate::hooks::pemu::common::{get_register, read_area_bytes, read_word};
+use common::hashbrown::HashMap;
+use qemu_rs::Register;
+
+const ETH_SIZE: u32 = 0x40200040;
+const ETH_DATA: u32 = 0x40200000;
+
+pub fn mps2_is_store_mmio(_address: u32) -> bool {
+    return false;
+}
+
+pub fn _pemu_place_packet(_mmio_writes: &mut HashMap<u32, u32>, _address: u32, _packet: Vec<u8>) {
+    println!("[Place packet] enter");
+    return;
+}
+
+pub fn pemu_mps2_receive(_mmio_writes: &mut HashMap<u32, u32>) -> (u32, u32, u32) {
+    let buf_addr: u32 = ETH_DATA;
+    let send_packet: u32 = 2;
+    let buf_size: u32 = ETH_SIZE;
+    return (send_packet, buf_addr, buf_size);
+}
+
+pub fn pemu_mps2_mask_size(raw_size: usize) -> u32 {
+    ((raw_size << 16) & 0xffffffff) as u32
+}
+
+pub fn _pemu_mps2_post_receive(_mmio_writes: &mut HashMap<u32, u32>) {
+    println!("[Post-receive] enter");
+    return;
+}
+
+pub fn pemu_mps2_transmit(_mmio_writes: &mut HashMap<u32, u32>) -> (Vec<u8>, i32) {
+    let px_network_buffer = get_register(Register::R0);
+    let buf_ptr = read_word(px_network_buffer + 0x18);
+    let size = read_word(px_network_buffer + 0x1c);
+    if size < 0 || size > 0x5f1 {
+        return (vec![], -1);
+    }
+    let packet = read_area_bytes(buf_ptr, size);
+    let mut le_packet: Vec<u8> = packet.clone();
+    if le_packet.len() % 4 != 0 {
+        //le_packet.splice(0..0, vec![0; 4 - (le_packet.len() % 4)].iter().cloned());
+        le_packet.extend(vec![0; 4 - (le_packet.len() % 4)]);
+    }
+    for chunk in le_packet.chunks_exact_mut(4) {
+        chunk.reverse();
+    }
+
+    return (le_packet, -1);
+}
