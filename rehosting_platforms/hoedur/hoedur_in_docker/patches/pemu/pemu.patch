diff --git a/emulator/src/hooks/pemu/f7xx.rs b/emulator/src/hooks/pemu/f7xx.rs
new file mode 100644
index 0000000..380d8ad
--- /dev/null
+++ b/emulator/src/hooks/pemu/f7xx.rs
@@ -0,0 +1,422 @@
+use crate::hooks::pemu::common::{
+    read_area_bytes_le, read_mmio, read_word, to_hex_string, write_area_bytes, write_mmio,
+    write_word,
+};
+use common::hashbrown::HashMap;
+
+const _ETH_DMABMR: u32 = 0x000; //dma bus mode register
+const _ETH_DMATPDR: u32 = 0x004; //ddma transmit poll demand register
+const _ETH_DMARPDR: u32 = 0x008; //dma receive poll demand register
+const ETH_DMARDLAR: u32 = 0x00c; //dma receive descriptor list addr register
+const ETH_DMATDLAR: u32 = 0x010; //dma transmit descriptor list addr register
+const ETH_DMASR: u32 = 0x014; //dma status register
+const ETH_DMAOMR: u32 = 0x018; //dma operation mode register
+const ETH_DMAIER: u32 = 0x01c; //dma interrupt enable register
+const _ETH_DMAMFBOCR: u32 = 0x020; //dma missed frame and buffer overflow counter register
+const _ETH_DMARSWTR: u32 = 0x024; //dma receive status watchdog timer register
+const _ETH_DMACHTDR: u32 = 0x048; //dma current host transmit descriptor register
+const _ETH_DMACHRDR: u32 = 0x04c; //dma current host receive descriptor register
+const ETH_DMACHTBAR: u32 = 0x050; //dma current host transmit buffer address register
+const ETH_DMACHRBAR: u32 = 0x054; //dma current host receive buffer address register
+
+const RDES0: u32 = 0x0; //offset to value given in eth_dmardlar, status
+const RDES1: u32 = 0x4; // sizes of of buffer1 and 2
+const RDES2: u32 = 0x8; // buffer1 addr
+const RDES3: u32 = 0xc; // buffer2 addr or next descriptor addr
+
+const SR_MASK: u32 = 0x2; //start/stop receive bit
+const ST_MASK: u32 = 1 << 13; //start/stop transmit bit
+const _DFRF_MASK: u32 = 1 << 24; //disable flushin of received frames
+const RCH_MASK: u32 = 1 << 14;
+const TCH_MASK: u32 = 1 << 20;
+const OWN_MASK: u32 = 1 << 31;
+const RBS1_MASK: u32 = 0x1fff;
+const _RBS2_MASK: u32 = 0x1fff0000;
+const RER_MASK: u32 = 1 << 15;
+const TER_MASK: u32 = 1 << 20;
+const _DIC_MASK: u32 = 1 << 31; //TODO???
+const FS_MASK: u32 = 1 << 9; //first descriptor of frame
+const LS_MASK: u32 = 1 << 8; //last descriptor of frane
+const TX_LS_MASK: u32 = 1 << 29;
+const RS_MASK: u32 = 1 << 6; //receive stauts bit in ETH_DMASR
+const ERS_MASK: u32 = 1 << 14; //early receive status in ETH_DMASR
+const NISE_MASK: u32 = 1 << 16;
+const IC_MASK: u32 = 1 << 30;
+const TS_MASK: u32 = 1;
+const TBUS_MASK: u32 = 1 << 2;
+const IER_RCV_MASK: u32 = NISE_MASK | RS_MASK | ERS_MASK; // interrupt mask for receive interrupts in DMA_IR
+
+const DESCRIPTOR_SIZE: u32 = 0x10 * 4; // 4 dwords
+
+const BASE_ADDR: u32 = 0x40029000; //TODO ethernet base addr
+
+const RCV_COUNTER: u32 = 0xdeadbeef;
+
+pub fn f7xx_is_store_mmio(address: u32) -> bool {
+    if address >= BASE_ADDR && address < BASE_ADDR + 0x1000 {
+        return true;
+    }
+    return false;
+}
+const _MMIO_BLOCK_LIST: &[u32] = &[BASE_ADDR + ETH_DMACHRBAR, BASE_ADDR + ETH_DMACHTBAR];
+pub fn _f7xx_is_hook_mmio_read(address: u32) -> bool {
+    // More or less debugging purposes
+    // What do we need to hook?
+    // ETHDMASR
+    // ETH_DMACHRBAR
+    // ETH_DMACHTBAR
+    if _MMIO_BLOCK_LIST.contains(&address) {
+        return true;
+    }
+    return false;
+}
+
+pub fn _f7xx_post_read_hook(address: u32, mmio_writes: &mut HashMap<u32, u32>) {
+    mmio_writes.remove(&address);
+}
+
+pub fn pemu_place_packet(mmio_writes: &mut HashMap<u32, u32>, address: u32, packet: Vec<u8>) {
+    let hex_packet: String = to_hex_string(&packet);
+    set_buffer_size(mmio_writes, packet.len() as u32);
+    write_area_bytes(address, packet);
+}
+
+pub fn pemu_post_f7xx_receive(mmio_writes: &mut HashMap<u32, u32>) {
+    // Postprocessing
+    set_first_descriptor_flag(mmio_writes);
+    set_last_descriptor_flag(mmio_writes);
+    clear_own_bit(mmio_writes);
+
+    set_receive_status(mmio_writes);
+
+    return;
+}
+
+pub fn pemu_f7xx_receive(mmio_writes: &mut HashMap<u32, u32>) -> (u32, u32, u32) {
+    //println!("RECEIVE");
+    let buf_size: u32 = 0;
+    let buf_addr: u32 = 0;
+    let send_packet: u32 = 0;
+    let rcv_counter = read_mmio(RCV_COUNTER, mmio_writes);
+    if rcv_counter < 2 {
+        write_mmio(RCV_COUNTER, rcv_counter + 1, mmio_writes);
+        //println!("SKibidi placement");
+        return (send_packet, buf_addr, buf_size);
+    }
+    write_mmio(RCV_COUNTER, 0, mmio_writes);
+
+    let receive_status = get_receive_status(mmio_writes);
+    if !receive_status {
+        // Not allowed to do anythin yet
+        //println!("Not allowed to send yet :-(");
+        return (send_packet, buf_addr, buf_size);
+    }
+    if poll_descriptor(mmio_writes) == 0 {
+        //println!("Not owning the descriptor");
+        return (send_packet, buf_addr, buf_size);
+    }
+
+    // Values for the emulator to insert the packet
+    let buf_size = get_buffer_size(mmio_writes);
+    let buf_addr = get_buffer_addr(mmio_writes);
+    if buf_addr == 0 {
+        return (send_packet, buf_addr, buf_size);
+    }
+
+    let send_packet: u32 = 1;
+    return (send_packet, buf_addr, buf_size);
+}
+
+pub fn pemu_f7xx_transmit(mmio_writes: &mut HashMap<u32, u32>) -> (Vec<u8>, i32) {
+    let transmit_status = get_transmit_status(mmio_writes);
+    if !transmit_status {
+        // Not allowed to transmit yet
+        return (vec![], -1);
+    }
+
+    if poll_tx_descriptor(mmio_writes) == 0 {
+        //println!("[Transmit] no desciptor found");
+        // no descriptor found
+        // TODO maybe set_tbus_state?
+        return (vec![], -1);
+    }
+    //println!("[transmit] polled descriptor");
+
+    // So far we only read out the buffer of one descriptor
+    // In theory a packet might be spread among multiple buffers
+    let packet_size = get_tx_buffer_size(mmio_writes);
+    let buf_addr = get_tx_buffer_addr(mmio_writes);
+    if buf_addr == 0 {
+        return (vec![], -1);
+    }
+    let packet: Vec<u8> = read_area_bytes_le(buf_addr, packet_size);
+
+    // Post transfer steps
+    // set IC bit and reset own bit
+    write_word(
+        get_current_tx_descriptor(mmio_writes) + RDES0,
+        read_word(get_current_tx_descriptor(mmio_writes) + RDES0) & 0x7fffffff,
+    );
+
+    // Do this for all further descriptors?
+    let mut cur_descriptor = get_current_tx_descriptor(mmio_writes);
+    while read_word(cur_descriptor + RDES0) & TX_LS_MASK == 0 {
+        if poll_tx_descriptor(mmio_writes) == 1 {
+            // TODO maybe set tbus state
+            return (packet, -1);
+        }
+        cur_descriptor = get_current_tx_descriptor(mmio_writes);
+        write_word(
+            cur_descriptor,
+            read_word(cur_descriptor + RDES0) & 0x7fffffff,
+        );
+    }
+
+    if read_word(cur_descriptor + RDES0) & IC_MASK != 0 {
+        set_transmit_status(mmio_writes);
+    }
+    (packet, -1)
+}
+
+fn set_first_descriptor_flag(mmio_writes: &mut HashMap<u32, u32>) {
+    let cur_descriptor = get_current_descriptor(mmio_writes);
+    let rdes0 = read_word(cur_descriptor + RDES0);
+    let new_rdes0 = rdes0 | FS_MASK;
+    write_word(cur_descriptor + RDES0, new_rdes0);
+}
+
+fn set_last_descriptor_flag(mmio_writes: &mut HashMap<u32, u32>) {
+    let cur_descriptor = get_current_descriptor(mmio_writes);
+    let rdes0 = read_word(cur_descriptor + RDES0);
+    let new_rdes0 = rdes0 | LS_MASK;
+    write_word(cur_descriptor + RDES0, new_rdes0);
+}
+
+fn clear_own_bit(mmio_writes: &mut HashMap<u32, u32>) {
+    let cur_descriptor = get_current_descriptor(mmio_writes);
+    let rdes0 = read_word(cur_descriptor + RDES0);
+    let new_rdes0 = rdes0 & (0xffffffff ^ OWN_MASK);
+    write_word(cur_descriptor + RDES0, new_rdes0);
+}
+
+fn set_receive_status(mmio_writes: &mut HashMap<u32, u32>) {
+    // Set the the RS bit in ETH_DMASR
+    // clear ERS (early receive status)
+    // set NIS (normal interrupt summary)
+    let enabled_interrupts = get_active_receive_interrupts(mmio_writes);
+    write_mmio(
+        BASE_ADDR + ETH_DMASR,
+        enabled_interrupts & RS_MASK,
+        mmio_writes,
+    );
+    if enabled_interrupts & RS_MASK != 0 {
+        // ERS is cleared if RS is set
+        let status_reg = read_mmio(BASE_ADDR + ETH_DMASR, mmio_writes);
+        let new_status_reg = status_reg & (0xffffffff ^ ERS_MASK);
+        write_mmio(BASE_ADDR + ETH_DMASR, new_status_reg, mmio_writes);
+    }
+
+    // NIS
+    let status_reg = read_mmio(BASE_ADDR + ETH_DMASR, mmio_writes);
+    let new_status_reg = status_reg | get_nis_val(status_reg);
+    write_mmio(BASE_ADDR + ETH_DMASR, new_status_reg, mmio_writes);
+}
+
+fn set_transmit_status(mmio_writes: &mut HashMap<u32, u32>) {
+    write_mmio(BASE_ADDR + ETH_DMASR, 1 | get_nis_val(1), mmio_writes);
+}
+
+fn get_nis_val(status_reg: u32) -> u32 {
+    let nis_val = ((status_reg & TS_MASK)
+        | ((status_reg & TBUS_MASK) >> 2)
+        | ((status_reg & RS_MASK) >> 6)
+        | ((status_reg & ERS_MASK) >> 14))
+        << 16;
+    nis_val
+}
+
+fn is_descriptor_owner(mmio_writes: &mut HashMap<u32, u32>) -> bool {
+    let cur_descriptor = get_current_descriptor(mmio_writes);
+    ((read_word(cur_descriptor + RDES0) & OWN_MASK) >> 31) == 1
+}
+
+fn get_active_receive_interrupts(mmio_writes: &mut HashMap<u32, u32>) -> u32 {
+    read_mmio(BASE_ADDR + ETH_DMAIER, mmio_writes) & IER_RCV_MASK
+}
+
+fn get_buffer_addr(mmio_writes: &mut HashMap<u32, u32>) -> u32 {
+    let cur_descriptor = get_current_descriptor(mmio_writes);
+    let buf_addr = read_word(cur_descriptor + RDES2);
+    buf_addr
+}
+
+fn get_buffer_size(mmio_writes: &mut HashMap<u32, u32>) -> u32 {
+    let cur_descriptor = get_current_descriptor(mmio_writes);
+    let buf_size = read_word(cur_descriptor + RDES1) & RBS1_MASK;
+    buf_size
+}
+
+fn set_buffer_size(mmio_writes: &mut HashMap<u32, u32>, val: u32) {
+    let cur_descriptor = get_current_descriptor(mmio_writes);
+    let cur_descriptor_val = read_word(cur_descriptor + RDES0);
+    let updated_descriptor = (cur_descriptor_val & 0xc000ffff) | ((val & 0x3fff) << 16); // reverse RBS1 MASK
+                                                                                         //println!("Setting seize: {:x}::{:x}-->{:x}", cur_descriptor, cur_descriptor_val ,updated_descriptor,);
+    write_word(cur_descriptor + RDES0, updated_descriptor);
+}
+
+fn get_receive_status(mmio_writes: &mut HashMap<u32, u32>) -> bool {
+    ((read_mmio(BASE_ADDR + ETH_DMAOMR, mmio_writes) & SR_MASK) >> 1) == 1
+}
+
+fn get_transmit_status(mmio_writes: &mut HashMap<u32, u32>) -> bool {
+    ((read_mmio(BASE_ADDR + ETH_DMAOMR, mmio_writes) & ST_MASK) >> 13) == 1
+}
+
+fn get_current_descriptor(mmio_writes: &mut HashMap<u32, u32>) -> u32 {
+    read_mmio(BASE_ADDR + ETH_DMACHRBAR, mmio_writes)
+}
+
+// TODO: do we propagate changes through to the firmware mmio reads?
+fn set_current_descriptor(descriptor: u32, mmio_writes: &mut HashMap<u32, u32>) {
+    write_mmio(BASE_ADDR + ETH_DMACHRBAR, descriptor, mmio_writes);
+}
+
+fn get_current_tx_descriptor(mmio_writes: &mut HashMap<u32, u32>) -> u32 {
+    read_mmio(BASE_ADDR + ETH_DMACHTBAR, mmio_writes)
+}
+
+// TODO: do we propagate changes through to the firmware mmio reads?
+fn set_current_tx_descriptor(descriptor: u32, mmio_writes: &mut HashMap<u32, u32>) {
+    write_mmio(BASE_ADDR + ETH_DMACHTBAR, descriptor, mmio_writes);
+}
+
+fn get_descriptor_structure(cur_descriptor: u32) -> u8 {
+    // 1 for  ring structure
+    ((read_word(cur_descriptor + RDES1) & RCH_MASK) >> 14) as u8
+}
+
+fn poll_descriptor(mmio_writes: &mut HashMap<u32, u32>) -> u32 {
+    let cur_descriptor = get_current_descriptor(mmio_writes);
+    if cur_descriptor == 0 {
+        let base_descriptor: u32 = read_mmio(BASE_ADDR + ETH_DMARDLAR, mmio_writes);
+        set_current_descriptor(base_descriptor, mmio_writes);
+    } else {
+        let is_ring_structure: u8 = get_descriptor_structure(cur_descriptor);
+        if is_ring_structure == 0 {
+            set_current_descriptor(poll_ring(cur_descriptor, mmio_writes), mmio_writes);
+        } else {
+            set_current_descriptor(poll_chain(cur_descriptor), mmio_writes);
+        }
+
+        if get_current_descriptor(mmio_writes) == 0xffffffff {
+            //println!("ERROR");
+            return 0;
+        }
+    }
+    if !is_descriptor_owner(mmio_writes) {
+        return 0;
+    }
+
+    return 1;
+}
+
+fn poll_ring(cur_descriptor: u32, mmio_writes: &mut HashMap<u32, u32>) -> u32 {
+    let rdes1 = read_word(cur_descriptor + RDES1);
+    if is_end_of_ring(rdes1) {
+        let new_descriptor = read_mmio(BASE_ADDR + ETH_DMARDLAR, mmio_writes);
+        return new_descriptor;
+    }
+
+    let new_descriptor = cur_descriptor + DESCRIPTOR_SIZE;
+    new_descriptor
+}
+
+fn is_end_of_ring(rdes1: u32) -> bool {
+    ((rdes1 & RER_MASK) >> 15) == 1
+}
+
+fn poll_chain(cur_descriptor: u32) -> u32 {
+    let rdes3 = read_word(cur_descriptor + RDES3);
+    if rdes3 == 0 {
+        return 0xffffffff;
+    }
+    rdes3
+}
+
+fn poll_tx_descriptor(mmio_writes: &mut HashMap<u32, u32>) -> u32 {
+    let cur_descriptor = get_current_tx_descriptor(mmio_writes);
+
+    if cur_descriptor == 0 {
+        // Not descriptor set, look at the start of the descriptor list
+        let base_descriptor = read_mmio(BASE_ADDR + ETH_DMATDLAR, mmio_writes);
+        set_current_tx_descriptor(base_descriptor, mmio_writes);
+    }
+    let cur_descriptor = get_current_tx_descriptor(mmio_writes);
+    let descriptor_owner = get_tx_descriptor_owner(cur_descriptor);
+    if descriptor_owner != 0 {
+        // Nice we already own the first descriptor
+        return 1;
+    }
+
+    // Need to check the remaining descriptors
+    let is_ring_structure = get_tx_descriptor_structure(cur_descriptor);
+    if is_ring_structure == false {
+        // Array list
+        let mut next_desc = cur_descriptor + 4 * DESCRIPTOR_SIZE;
+        while !is_end_of_tx_ring(next_desc) {
+            let desc_own = (read_word(next_desc + RDES0) & OWN_MASK) >> 31;
+            if desc_own == 1 {
+                // Found a descriptor we (i.e., the dma controller) owns
+                set_current_tx_descriptor(next_desc, mmio_writes);
+                return 1;
+            }
+
+            next_desc = next_desc + 4 * DESCRIPTOR_SIZE;
+        }
+
+        // Nothing found TODO
+        return 0;
+    } else {
+        let mut next_desc = read_word(cur_descriptor + RDES3);
+        while next_desc != cur_descriptor {
+            let desc_own = (read_word(next_desc + RDES0) & OWN_MASK) >> 31;
+            if desc_own == 1 {
+                // Found a descriptor we (i.e., the dma controller) owns
+                set_current_tx_descriptor(next_desc, mmio_writes);
+                return 1;
+            }
+
+            next_desc = read_word(next_desc + RDES3);
+        }
+
+        // Nothing found
+        return 0;
+    }
+}
+
+fn get_tx_descriptor_owner(cur_descriptor: u32) -> u32 {
+    if cur_descriptor + RDES0 == 0 {
+        return 0;
+    }
+    (read_word(cur_descriptor + RDES0) & OWN_MASK) >> 31
+}
+
+fn get_tx_descriptor_structure(cur_descriptor: u32) -> bool {
+    ((read_word(cur_descriptor + RDES0) & TCH_MASK) >> 20) == 1
+}
+
+fn is_end_of_tx_ring(cur_descriptor: u32) -> bool {
+    ((read_word(cur_descriptor + RDES0) & TER_MASK) >> 21) == 1
+}
+
+fn get_tx_buffer_addr(mmio_writes: &mut HashMap<u32, u32>) -> u32 {
+    let cur_descriptor = get_current_tx_descriptor(mmio_writes);
+    let buf_addr = read_word(cur_descriptor + RDES2);
+    buf_addr
+}
+
+fn get_tx_buffer_size(mmio_writes: &mut HashMap<u32, u32>) -> u32 {
+    let cur_descriptor = get_current_tx_descriptor(mmio_writes);
+    let buf_size = read_word(cur_descriptor + RDES1) & RBS1_MASK;
+    buf_size
+}
