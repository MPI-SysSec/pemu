diff --git a/pemu/protocol_lib/ble/ble_data_channel_pdu.yml b/pemu/protocol_lib/ble/ble_data_channel_pdu.yml
new file mode 100644
index 0000000..f869454
--- /dev/null
+++ b/pemu/protocol_lib/ble/ble_data_channel_pdu.yml
@@ -0,0 +1,71 @@
+# https://novelbits.io/deep-dive-ble-packets-events/
+# https://novelbits.io/bluetooth-low-energy-advertisements-part-1/
+# https://medium.com/rtone-iot-security/a-brief-overview-of-bluetooth-low-energy-79be06eab4df
+# Bluetooth Core v5.3 page 2699
+# TODO add to docs how bitwise granularity stuff needs to be ordered 
+meta:
+  id: 0x10080
+  endian: be
+  
+
+header:
+  RFU:
+    type: data
+    size: b2
+    value: 0
+    doc: Reserved for future use
+
+  CP:
+    type: condition
+    size: b1
+    bitmask: [CTEInfo]
+    doc: CTEInfo Present
+
+  MD:
+    type: fuzzed
+    size: b1
+    doc: More data
+    
+  SN:
+    type: fuzzed
+    size: b1
+    doc: Sequence number
+
+  NESN:
+    type: fuzzed
+    size: b1
+    doc: Next expected sequence number
+
+  # LLID
+  # 0b00 = Reserved for future use
+  # 0b01 = LL Data PDU: Continuation fragment of an L2CAP message, or an
+  # Empty PDU.
+  # 0b10 = LL Data PDU: Start of an L2CAP message or a complete L2CAP mes-
+  # sage with no fragmentation.
+  # 0b11 = LL Control PDU
+  # --> maybe a handler?
+  LLID:
+    type: handler
+    size: b2
+    handler: ble_handle_llid
+    doc: Indicates whether the packet is an LL Data PDU or an LL Control PDU
+
+  length:
+    type: length
+    size: 1
+    scope: body
+    format: b
+    doc: Length in bytes of payload
+
+  # TODO
+  CTEInfo:
+    type: conditional
+    size: 1
+    doc: Indicates the type and length of the Constant Tone Extension.
+
+body:
+  size: fuzzed
+  max: 251
+  
+
+
diff --git a/pemu/protocol_lib/ble/ble_init_extended/ble_aux_connect_rsp.yml b/pemu/protocol_lib/ble/ble_init_extended/ble_aux_connect_rsp.yml
new file mode 100644
index 0000000..dfa3e19
--- /dev/null
+++ b/pemu/protocol_lib/ble/ble_init_extended/ble_aux_connect_rsp.yml
@@ -0,0 +1,57 @@
+meta:
+  id: 0x10008
+  endian: be
+
+# extended header length, extended header flags (and the resulting fields) are static for this pdu
+header:
+  # this is the extended header core_v5.3 p2691
+  # 2.3.3.2 AUX_CONNECT_RSP
+  advMode:
+    type: data
+    size: b2
+    value: 0
+    doc: The AdvMode field shall be set to 0b00. Other values are not allowed
+
+  extended_header_length:
+    type: data
+    size: b6
+    value: 0xd
+    doc: Length of the extended header
+
+  # now the variable extended header flags; table 2.10; page 2691
+  # bits      extended header                 Fields set by advMode
+  # ----------------------------------------------------------------
+  # 0         AdvA                            mandatory
+  # 1         TargetA                         mandatory
+  # 2         CTEInfo                         reserved 
+  # 3         AdvDataInfo (ADI)               reserved
+  # 4         AuxPtr                          reserved
+  # 5         SyncInfo                        reserved
+  # 6         TxPower                         reserved
+  # 7         Reserved for future use         reserved
+  
+  extended_header_flags:
+    type: data
+    size: 1
+    value: 0xc0
+    doc: The bits define which header fields are used
+  
+  AdvA:
+    type: reference
+    size: 6
+    reference: BLE.AdvA
+    doc: Advertiser's address
+
+  TargetA:
+    type: reference
+    size: 6
+    reference: BLE.TargetA
+    doc: Target's address
+
+   
+
+body:
+  size: fuzzed
+  max: 254
+
+
