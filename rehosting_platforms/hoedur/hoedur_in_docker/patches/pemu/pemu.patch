+        
+    #print(bin(fcf))
+    #print(f"pan id {pan_id_compr}; sam: {source_addr_mode}, dam {dest_addr_mode}")
+
+    """
+    if frame_type in [IEEE802154_DATA, IEEE802154_BEACON] and dest_addr_mode in [2,3] and not source_addr_mode and not pan_id_compr:
+        # dest pand id + dest addr
+        set_field_info(header['destination_PAN'], SIZE, 2)
+        set_field_info(header['destination_PAN'], C_MASKED, False)  
