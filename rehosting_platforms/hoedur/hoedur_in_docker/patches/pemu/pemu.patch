+def sixlowpan_mesh_handler(field: dict, layer: dict, upper_layer: dict, get_bytes: types.FunctionType) -> int:
+    field[C_MASKED] = True
+    field[STREAM_LEN] = 0
+    field[SIZE] = 0
+    field[META][HEADER_LEN] = 0
