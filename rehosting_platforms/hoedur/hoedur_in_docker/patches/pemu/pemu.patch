+    def _fuzzed_packet_depr(self):
+        """
+        If no packet configuration is supplied, send a random one
+        """
+        """
+        if self._probe_mode:
+            dice = int.from_bytes(os.urandom(1), "little")  
+        else:
+            dice = int.from_bytes(self._get_bytes(1), "little")  
+        """
+        # build a packet by iterating through the network tree until a leav is reached
+
+        packet = []
+        cur_tree = self._network_tree
+        max_depth = 0xffffffff
+        depth = 0
+        if cur_tree._data != "root":
+            packet.append(cur_tree._data)
+            depth = 1
+        else:
+            max_depth = 2 if not self._increase_probe_depth else 3
+        dice = self._get_bytes(1)
+        if not dice:
+            return []
+        dice = int.from_bytes(dice, "little")  
+        options = len(cur_tree.get_children())
+        choice = cur_tree.get_children()[dice % options]
+        cur_tree = choice
+        packet.append(cur_tree._data)
+        if max_depth < 4 and cur_tree._data == "Ethernet":
+            if self._increase_probe_depth:
+                max_depth = 2
+            else:
+                return packet
+        depth += 1
+        while cur_tree.get_children():
+            options = len(cur_tree.get_children()) + 1 if depth > 1 else len(cur_tree.get_children())
+            if options == 1 and depth > 1:
+                packet.append(cur_tree._data)
+                break
+            else:
+                dice = self._get_bytes(1)
+                if not dice:
+                    return []
+                dice = int.from_bytes(dice, "little")  
+                if depth > 1 and dice % options == (options - 1):
+                    break
+                choice = cur_tree.get_children()[dice % options]
+
+            cur_tree = choice
+            packet.append(cur_tree._data)
+            depth += 1
+            while cur_tree._chain_next_one:
+                cur_tree = cur_tree.get_children()[0]
+                packet.append(cur_tree._data)
+                depth += 1
+            if self._probe_mode and depth >= max_depth:
+                # if we are in probe mode and have no previous knowledge only sent packets two layers deep
+                break
+
+        return packet
+
+    def _fuzzed_packet(self):
+        dice = self._get_bytes(1)
+        if not dice:
+            return []
+        dice = int.from_bytes(dice, "little") 
+
+        if self._network_tree._data != "root":
+            search_tree = self._all_packets
+            
+        else:
+            base = self._network_tree.get_children()[dice % len(self._network_tree.get_children())]._data
+            if self._increase_probe_depth:
+                search_tree = [x for x in self._all_packets if x[0] == base and ((len(x) == 2 and x[0] == "Ethernet") or (len(x) == 3 and x[0] == "BLE_PHY") or (len(x) == 4 and x[0] == "IEEE802154_PHY"))]
+            else:
+                search_tree = [x for x in self._all_packets if x[0] == base and ((len(x) == 1 and x[0] == "Ethernet") or (len(x) == 2 and x[0] != "Ethernet"))]
+
+
+        #dice = int.from_bytes(self._get_bytes(1), "little") 
+        return search_tree[dice % len(search_tree)]
+
+
+    def _init_all_packets(self, tree: Tree, state: list):
+        """
+        Calculate all possible packets in the current tree. 
+        This gives all packets the same possibility rather than going level to level
+        """
+        data = []
+        res = []
+        if tree._data != "root":
+            data = [tree._data]
+            res = [state + data]
+    
+        for child in tree.get_children():
+            tmp = list()
+            if child._chain_next_one:
+                tmp = [child._data]
+                child = child.get_children()[0]
+            res.extend(self._init_all_packets(child, state + data + tmp))
+
+        return res
