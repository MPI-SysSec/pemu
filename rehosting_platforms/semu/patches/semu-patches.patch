+def semu_setup_fuzz(user_input: list):
+    if globs.cursor_input:
+        return
+
+    globs.cursor_input = list(user_input)
+    print(f"[semu_setup_fuzz] setup cursor input: {globs.cursor_input}")
+    return
+
+def semu_get_bytes(n: int) -> bytes:
+    if n > len(globs.cursor_input):
+        print("[WARN] Out of fuzz")
+    if not globs.cursor_input:
+        return n * b'\x00'
+
+    fuzz = globs.cursor_input[:n]
+    globs.cursor_input = globs.cursor_input[n:]
+    return bytes(fuzz)
